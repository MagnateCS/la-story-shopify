<link href="https://fonts.cdnfonts.com/css/century-gothic-paneuropean" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=GFS+Didot&display=swap" rel="stylesheet">
<section id="la-story-services-{{ section.id }}" class="la-story-services-page">
  <div class="la-story-services-page__container">

    <header class="la-story-services-page__hero">
      <div>
        <h1>{{ section.settings.heading | escape }}</h1>

        {% if section.settings.text != blank %}
          <p>{{ section.settings.text | escape | newline_to_br }}</p>
        {% endif %}
      </div>

      <div class="la-story-services-page__hero-note">
        <p>{{ section.settings.note | escape | newline_to_br }}</p>
      </div>
    </header>

    {% comment %}
      Category -> sections.value -> services.value.
      These types and keys match the LA STORY Python importer.
      Display prices are text, so do not apply the money filter.
    {% endcomment %}
    {% assign default_handles = 'womens-clothing-alterations,classic-bridal-alterations,modern-bridal-alterations,bridesmaid-formal-dress-alterations' %}
    {% assign category_handles = section.settings.category_handles | default: default_handles | split: ',' %}
    {% assign visible_categories = 0 %}
    {% capture category_navigation %}
      {% for raw_handle in category_handles %}
        {% assign category_handle = raw_handle | strip %}
        {% assign category = shop.metaobjects.la_story_service_category[category_handle] %}
        {% if category != blank and category.sections.value != blank %}
          {% assign visible_categories = visible_categories | plus: 1 %}
          {% assign navigation_label = category.name.value %}
          {% case category_handle %}
            {% when 'womens-clothing-alterations' %}
              {% assign navigation_label = 'Women’s Clothing' %}
            {% when 'classic-bridal-alterations' %}
              {% assign navigation_label = 'Classic Bridal' %}
            {% when 'modern-bridal-alterations' %}
              {% assign navigation_label = 'Modern Bridal' %}
            {% when 'bridesmaid-formal-dress-alterations' %}
              {% assign navigation_label = 'Formal Dresses' %}
          {% endcase %}
          <a href="#{{ category_handle | escape }}">{{ navigation_label | escape }}</a>
        {% endif %}
      {% endfor %}
    {% endcapture %}

    {% if visible_categories > 0 %}
      <nav class="la-story-services-page__nav" aria-label="Service categories">
        {{ category_navigation }}
      </nav>
    {% endif %}

    <div class="la-story-services-page__groups">
      {% assign category_number = 0 %}
      {% for raw_handle in category_handles %}
        {% assign category_handle = raw_handle | strip %}
        {% assign category = shop.metaobjects.la_story_service_category[category_handle] %}
        {% if category != blank and category.sections.value != blank %}
          {% assign category_number = category_number | plus: 1 %}
          <section id="{{ category_handle | escape }}" class="la-story-service-group">
            <div class="la-story-service-group__header">
              <span>{% if category_number < 10 %}0{% endif %}{{ category_number }}</span>
              <h2>{{ category.name.value | escape }}</h2>
              {% if category.description.value != blank %}
                <p>{{ category.description.value | escape | newline_to_br }}</p>
              {% endif %}
            </div>
            <div class="la-story-service-group__sections">
              {% for service_section in category.sections.value %}
                {% if service_section.services.value != blank %}
                  <details class="la-story-service-section"{% if service_section.open_by_default.value == true %} open{% endif %}>
                    <summary>
                      <span class="la-story-service-section__summary-text">
                        <span class="la-story-service-section__title">{{ service_section.name.value | escape }}</span>
                        {% if service_section.note.value != blank %}
                          <small>{{ service_section.note.value | escape | newline_to_br }}</small>
                        {% endif %}
                      </span>
                    </summary>
                    <div class="la-story-service-section__items">
                      {% for service in service_section.services.value %}
                        <div>
                          <span>{{ service.name.value | escape }}</span>
                          {% if service.price.value != blank %}
                            <strong>{{ service.price.value | escape }}</strong>
                          {% endif %}
                        </div>
                      {% endfor %}
                    </div>
                  </details>
                {% elsif request.design_mode %}
                  <p>Theme editor: Add active service references to {{ service_section.name.value | escape }}.</p>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% elsif request.design_mode %}
          <p>Theme editor: Category “{{ category_handle | escape }}” is missing, inactive, or has no active section references. Check Content → Metaobjects and Storefronts access.</p>
        {% endif %}
      {% endfor %}
      {% if visible_categories == 0 and request.design_mode == false %}
        <p>Please contact the atelier for current services and pricing.</p>
      {% endif %}
    </div>

    <footer class="la-story-services-page__footer">
      <div>
        <h2>{{ section.settings.footer_heading | escape }}</h2>
        <p>{{ section.settings.footer_text | escape | newline_to_br }}</p>
      </div>

      {% if section.settings.footer_button_label != blank and section.settings.footer_button_link != blank %}
        <a href="{{ section.settings.footer_button_link | escape }}">
          {{ section.settings.footer_button_label | escape }}
        </a>
      {% endif %}
    </footer>

  </div>

  {% if section.settings.button_link != blank %}
    <a
      class="la-story-services-page__floating-appointment"
      href="{{ section.settings.button_link | escape }}"
      aria-label="Book an alterations appointment"
    >
      {{ section.settings.appointment_button_label | default: 'Book Appointment' | escape }}
    </a>
  {% endif %}
</section>

<style>
  #la-story-services-{{ section.id }} {
    --la-story-font: "GFS Didot", Didot, "Times New Roman", serif;
    --la-story-brand-font: "Century Gothic Paneuropean", "Century Gothic", Arial, sans-serif;
    background: #f8f3ec;
    color: #211b17;
    padding: 28px 0 92px;
    font-family: var(--la-story-font);
    font-size: 18px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  #la-story-services-{{ section.id }} *,
  #la-story-services-{{ section.id }} *::before,
  #la-story-services-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__container {
    max-width: 1480px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: end;
    padding: 72px 0 56px;
    border-bottom: 1px solid rgba(33, 27, 23, 0.16);
  }

  #la-story-services-{{ section.id }} .la-story-services-page__hero h1 {
    margin: 0;
    font-family: var(--la-story-font);
    font-size: clamp(38px, 3.2vw, 48px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__hero p {
    margin: 24px 0 0;
    max-width: 680px;
    color: rgba(33, 27, 23, 0.78);
    font-size: 18px;
    line-height: 1.7;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__hero-note {
    border-left: 1px solid rgba(33, 27, 23, 0.16);
    padding-left: 36px;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__hero-note p {
    margin-top: 0;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-top: 26px;
    border: 1px solid #211b17;
    background: #211b17;
    color: #fff;
    padding: 0 28px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__footer a:hover {
    background: transparent;
    color: #211b17;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__floating-appointment {
    position: fixed;
    right: clamp(18px, 2.2vw, 34px);
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 20;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    border: 1px solid #211b17;
    border-radius: 2px;
    background: #211b17;
    box-shadow: 0 8px 24px rgba(33, 27, 23, 0.18);
    color: #fff;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__floating-appointment:hover {
    background: #fffdf8;
    color: #211b17;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(33, 27, 23, 0.22);
  }

  #la-story-services-{{ section.id }} a:focus-visible,
  #la-story-services-{{ section.id }} summary:focus-visible {
    outline: 3px solid #8c6a43;
    outline-offset: 4px;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__nav {
    position: sticky;
    top: calc(var(--header-height, 0px) - 1px);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0 0 56px;
    background: #f8f3ec;
    border-bottom: 1px solid rgba(33, 27, 23, 0.16);
  }

  #la-story-services-{{ section.id }} .la-story-services-page__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 58px;
    padding: 0 22px;
    border-right: 1px solid rgba(33, 27, 23, 0.16);
    color: rgba(33, 27, 23, 0.82);
    font-size: 14px;
    line-height: 1.45;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__nav a:first-child {
    border-left: 1px solid rgba(33, 27, 23, 0.16);
  }

  #la-story-services-{{ section.id }} .la-story-services-page__nav a:hover {
    color: #211b17;
    background: #fffdf8;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__groups {
    display: grid;
    gap: 76px;
  }

  #la-story-services-{{ section.id }} .la-story-service-group {
    display: grid;
    grid-template-columns: 0.36fr 0.64fr;
    gap: 54px;
    scroll-margin-top: 120px;
  }

  #la-story-services-{{ section.id }} .la-story-service-group__header {
    position: sticky;
    top: 180px;
    align-self: start;
  }

  #la-story-services-{{ section.id }} .la-story-service-group__header span {
    display: block;
    margin-bottom: 18px;
    color: #b99a72;
    font-family: var(--la-story-font);
    font-size: 22px;
    line-height: 1;
    font-weight: 500;
  }

  #la-story-services-{{ section.id }} .la-story-service-group__header h2 {
    margin: 0;
    font-family: var(--la-story-font);
    font-size: clamp(30px, 2.4vw, 36px);
    line-height: 1.22;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  #la-story-services-{{ section.id }} .la-story-service-group__header p {
    margin: 18px 0 0;
    color: rgba(33, 27, 23, 0.78);
    font-size: 17px;
    line-height: 1.7;
  }

  #la-story-services-{{ section.id }} .la-story-service-group__sections {
    border-top: 1px solid rgba(33, 27, 23, 0.16);
  }

  #la-story-services-{{ section.id }} .la-story-service-section {
    border-bottom: 1px solid rgba(33, 27, 23, 0.16);
  }

  #la-story-services-{{ section.id }} .la-story-service-section summary {
    list-style: none;
    cursor: pointer;
    padding: 24px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 34px;
    gap: 24px;
    align-items: start;
  }

  #la-story-services-{{ section.id }} .la-story-service-section summary::-webkit-details-marker {
    display: none;
  }

  #la-story-services-{{ section.id }} .la-story-service-section summary::after {
    content: "+";
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    width: 34px;
    min-width: 34px;
    color: #b99a72;
    font-family: var(--la-story-font);
    font-size: 24px;
    line-height: 1;
    text-align: right;
  }

  #la-story-services-{{ section.id }} .la-story-service-section[open] summary::after {
    content: "–";
  }

  #la-story-services-{{ section.id }} .la-story-service-section__summary-text {
    display: block;
    min-width: 0;
  }

  #la-story-services-{{ section.id }} .la-story-service-section__title {
    display: block;
    font-family: var(--la-story-font);
    font-size: 22px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  #la-story-services-{{ section.id }} .la-story-service-section summary small {
    display: block;
    margin-top: 9px;
    max-width: 680px;
    color: rgba(33, 27, 23, 0.74);
    font-size: 16px;
    line-height: 1.65;
  }

  #la-story-services-{{ section.id }} .la-story-service-section__items {
    display: grid;
    gap: 0;
    padding: 0 0 28px;
  }

  #la-story-services-{{ section.id }} .la-story-service-section__items div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    padding: 12px 0;
    border-top: 1px dotted rgba(33, 27, 23, 0.22);
    color: rgba(33, 27, 23, 0.82);
    font-size: 17px;
    line-height: 1.6;
  }

  #la-story-services-{{ section.id }} .la-story-service-section__items div:first-child {
    border-top: 0;
  }

  #la-story-services-{{ section.id }} .la-story-service-section__items strong {
    color: #211b17;
    font-size: 18px;
    font-weight: 600;
    white-space: nowrap;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 34px;
    align-items: center;
    margin-top: 92px;
    padding: 42px;
    border: 1px solid rgba(33, 27, 23, 0.16);
    background: #fffdf8;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__footer h2 {
    margin: 0;
    font-family: var(--la-story-font);
    font-size: clamp(32px, 3vw, 46px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  #la-story-services-{{ section.id }} .la-story-services-page__footer p {
    margin: 16px 0 0;
    max-width: 760px;
    color: rgba(33, 27, 23, 0.78);
    font-size: 18px;
    line-height: 1.7;
  }

  @media screen and (max-width: 1120px) {
    #la-story-services-{{ section.id }} .la-story-services-page__hero,
    #la-story-services-{{ section.id }} .la-story-service-group,
    #la-story-services-{{ section.id }} .la-story-services-page__footer {
      grid-template-columns: 1fr;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__hero-note {
      border-left: 0;
      padding-left: 0;
    }

    #la-story-services-{{ section.id }} .la-story-service-group__header {
      position: static;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__footer a {
      width: fit-content;
    }
  }

  @media screen and (max-width: 760px) {
    #la-story-services-{{ section.id }} {
      padding: 18px 0 68px;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__container {
      padding-left: 18px;
      padding-right: 18px;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__hero {
      padding: 54px 0 38px;
      gap: 28px;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__hero h1 {
      font-size: 36px;
      line-height: 1.15;
    }

    #la-story-services-{{ section.id }} .la-story-service-group__header h2,
    #la-story-services-{{ section.id }} .la-story-services-page__footer h2 {
      font-size: 32px;
      line-height: 1.2;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__nav {
      position: static;
      margin-bottom: 46px;
      border-top: 1px solid rgba(33, 27, 23, 0.16);
    }

    #la-story-services-{{ section.id }} .la-story-services-page__nav a {
      width: 100%;
      border-left: 1px solid rgba(33, 27, 23, 0.16);
      border-bottom: 1px solid rgba(33, 27, 23, 0.16);
    }

    #la-story-services-{{ section.id }} .la-story-services-page__groups {
      gap: 60px;
    }

    #la-story-services-{{ section.id }} .la-story-service-group {
      gap: 28px;
    }

    #la-story-services-{{ section.id }} .la-story-service-section summary {
      grid-template-columns: minmax(0, 1fr) 30px;
      gap: 18px;
      padding: 22px 0;
    }

    #la-story-services-{{ section.id }} .la-story-service-section summary::after {
      width: 30px;
      min-width: 30px;
      font-size: 22px;
    }

    #la-story-services-{{ section.id }} .la-story-service-section__title {
      font-size: 21px;
      line-height: 1.35;
    }

    #la-story-services-{{ section.id }} .la-story-service-section__items div {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 13px 0;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__footer {
      margin-top: 68px;
      padding: 28px 22px;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__footer a {
      width: 100%;
    }

    #la-story-services-{{ section.id }} .la-story-services-page__floating-appointment {
      right: 16px;
      bottom: max(16px, env(safe-area-inset-bottom));
      min-height: 48px;
      padding: 0 18px;
      font-size: 13px;
    }
  }

  @media print {
    #la-story-services-{{ section.id }} .la-story-services-page__floating-appointment {
      display: none;
    }
  }

  /* Editorial headings and copy use Didot; navigation, actions and prices use Century Gothic. */
  #la-story-services-{{ section.id }} .la-story-services-page__nav a,
  #la-story-services-{{ section.id }} .la-story-services-page__footer a,
  #la-story-services-{{ section.id }} .la-story-services-page__floating-appointment,
  #la-story-services-{{ section.id }} .la-story-service-section__items strong,
  #la-story-services-{{ section.id }} .la-story-service-section summary::after {
    font-family: var(--la-story-brand-font);
  }

  #la-story-services-{{ section.id }} h1,
  #la-story-services-{{ section.id }} h2,
  #la-story-services-{{ section.id }} .la-story-service-section__title,
  #la-story-services-{{ section.id }} .la-story-service-group__header span {
    font-family: var(--la-story-font);
    font-weight: 400;
  }

  #la-story-services-{{ section.id }} p,
  #la-story-services-{{ section.id }} .la-story-service-section summary small,
  #la-story-services-{{ section.id }} .la-story-service-section__items div > span {
    font-family: var(--la-story-font);
  }
</style>

{% schema %}
{
  "name": "LA Story Services Page",
  "settings": [
    {
      "type": "textarea",
      "id": "category_handles",
      "label": "Category handles (display order)",
      "default": "womens-clothing-alterations,classic-bridal-alterations,modern-bridal-alterations,bridesmaid-formal-dress-alterations",
      "info": "Comma-separated category entry handles; maximum 20 unique handles. Prices and service details are edited in Content > Metaobjects."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Alteration services and pricing."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Explore LA STORY’s alteration services for women’s clothing, classic bridal gowns, modern bridal gowns, bridesmaid dresses, and formalwear."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Side note",
      "default": "Pricing may vary based on garment construction, lining, lace, beading, top-stitching, layers, and final tailoring needs. For the most accurate estimate, book a fitting."
    },
    {
      "type": "text",
      "id": "appointment_button_label",
      "label": "Floating appointment button label",
      "default": "Book Appointment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Appointment booking link"
    },
    {
      "type": "text",
      "id": "footer_heading",
      "label": "Footer heading",
      "default": "Need help choosing the right service?"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Tell us about your garment, event date, and the fit you are hoping to achieve. We can help guide you toward the right appointment."
    },
    {
      "type": "text",
      "id": "footer_button_label",
      "label": "Footer button label",
      "default": "Contact the Atelier"
    },
    {
      "type": "url",
      "id": "footer_button_link",
      "label": "Footer button link"
    }
  ],
  "presets": [
    {
      "name": "LA Story Services Page"
    }
  ]
}
{% endschema %}
