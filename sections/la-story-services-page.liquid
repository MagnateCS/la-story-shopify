{% comment %}
  LA STORY — adaptive service page.
  Category -> sections.value -> services.value.
  Prices remain display text.
  Existing settings IDs and category anchors are retained.
  Use one instance on a page; disable any separate page-title section to avoid duplicate H1s.
{% endcomment %}

{% paginate shop.metaobjects.la_story_service_category.values by 250 %}
  {% liquid
    assign categories = section.settings.service_categories

    if categories == blank
      assign categories = shop.metaobjects.la_story_service_category.values
    endif

    assign visible_categories = 0

    for category in categories
      if category != blank and category.sections.value != blank
        assign visible_categories = visible_categories | plus: 1
        assign only_category = category
      endif
    endfor

    assign single_category = false

    if visible_categories == 1
      if section.settings.service_categories != blank or paginate.pages == 1
        assign single_category = true
      endif
    endif

    assign hero_heading = section.settings.heading
    assign hero_text = section.settings.text

    if single_category and section.settings.auto_category_intro
      assign hero_heading = only_category.name.value
      assign hero_text = only_category.description.value
    endif

    assign hero_heading = hero_heading | default: 'Alteration services and pricing'
  %}

  <section
    id="la-story-services-{{ section.id }}"
    class="ls-services{% if single_category %} ls-services--single{% endif %}"
  >
    <header class="ls-hero{% if section.settings.hero_image != blank %} ls-hero--with-image{% endif %}">
      {% if section.settings.hero_image != blank %}
        <div class="ls-hero__media">
          {{
            section.settings.hero_image
            | image_url: width: 2000
            | image_tag:
              widths: '360, 540, 750, 1000, 1400, 1800, 2000',
              sizes: '(min-width: 900px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'ls-hero__image'
          }}
        </div>
      {% endif %}

      <div class="ls-hero__copy">
        {% if section.settings.hero_eyebrow != blank %}
          <p class="ls-eyebrow">
            {{ section.settings.hero_eyebrow | escape }}
          </p>
        {% endif %}

        <h1>{{ hero_heading | escape }}</h1>

        {% if hero_text != blank %}
          <p class="ls-intro">
            {{ hero_text | escape | newline_to_br }}
          </p>
        {% endif %}

        <div class="ls-hero__actions">
          {% if section.settings.button_link != blank %}
            <a
              class="ls-button"
              href="{{ section.settings.button_link | escape }}"
            >
              {{ section.settings.appointment_button_label | default: 'Book Appointment' | escape }}
            </a>
          {% endif %}

          {% if visible_categories > 0 %}
            <a
              class="ls-text-link"
              href="#ls-pricing-{{ section.id }}"
            >
              Explore services

              <svg
                class="ls-arrow"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 4v16M5 13l7 7 7-7"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    </header>

    <div
      class="ls-container"
      id="ls-pricing-{{ section.id }}"
    >
      {% if visible_categories > 1 %}
        <nav
          class="ls-category-nav"
          aria-label="Service categories"
        >
          <p class="ls-eyebrow">Find your service</p>

          <ul role="list">
            {% for category in categories %}
              {% if category != blank and category.sections.value != blank %}
                <li>
                  <a href="#la-story-{{ section.id }}-{{ category.system.handle | escape }}">
                    {{ category.name.value | escape }}

                    <svg
                      class="ls-arrow"
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M6 18 18 6M6 6h12v12"/>
                    </svg>
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      {% if single_category or section.settings.note != blank %}
        <div class="ls-pricing-intro">
          {% if single_category %}
            <h2>Services &amp; pricing</h2>
          {% else %}
            <p class="ls-eyebrow">A guide to your fitting</p>
          {% endif %}

          {% if section.settings.note != blank %}
            <p class="ls-pricing-note">
              {{ section.settings.note | escape | newline_to_br }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      <div class="ls-groups">
        {% for category in categories %}
          {% if category != blank and category.sections.value != blank %}
            <section
              id="la-story-{{ section.id }}-{{ category.system.handle | escape }}"
              class="ls-group"
              aria-label="{{ category.name.value | escape }}"
            >
              {% unless single_category %}
                <header class="ls-group__header">
                  <h2>{{ category.name.value | escape }}</h2>

                  {% if category.description.value != blank %}
                    <p>
                      {{ category.description.value | escape | newline_to_br }}
                    </p>
                  {% endif %}
                </header>
              {% endunless %}

              <div class="ls-accordions">
                {% assign first_available_section = true %}

                {% for service_section in category.sections.value %}
                  {% if service_section.services.value != blank %}
                    {% liquid
                      assign section_open = false

                      if service_section.open_by_default.value == true
                        assign section_open = true
                      endif

                      if first_available_section and section.settings.open_first_section
                        assign section_open = true
                      endif

                      assign first_available_section = false
                    %}

                    <details
                      class="ls-service-section"
                      {% if section_open %}
                        open
                      {% endif %}
                    >
                      <summary>
                        <span class="ls-summary-copy">
                          <span class="ls-service-title">
                            {{ service_section.name.value | escape }}
                          </span>

                          {% if service_section.note.value != blank %}
                            <small>
                              {{ service_section.note.value | escape | newline_to_br }}
                            </small>
                          {% endif %}
                        </span>

                        <span
                          class="ls-toggle"
                          aria-hidden="true"
                        ></span>
                      </summary>

                      <dl class="ls-price-list">
                        {% for service in service_section.services.value %}
                          <div class="ls-price-row">
                            <dt>{{ service.name.value | escape }}</dt>

                            {% if service.price.value != blank %}
                              <dd>{{ service.price.value | escape }}</dd>
                            {% else %}
                              <dd class="ls-price-unavailable">
                                Ask at fitting
                              </dd>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </dl>
                    </details>
                  {% elsif request.design_mode %}
                    <p class="ls-editor-note">
                      Theme editor: Add active service references to
                      {{ service_section.name.value | escape }}.
                    </p>
                  {% endif %}
                {% endfor %}
              </div>
            </section>
          {% elsif request.design_mode %}
            <p class="ls-editor-note">
              Theme editor: Check that this category and its section references
              are active and have Storefronts access.
            </p>
          {% endif %}
        {% endfor %}

        {% if visible_categories == 0 %}
          <p>Please contact the atelier for current services and pricing.</p>

          {% if request.design_mode %}
            <p class="ls-editor-note">
              Theme editor: Select active categories with active section
              references, or leave the selection empty to show all available
              categories.
            </p>
          {% endif %}
        {% endif %}
      </div>

      {% if section.settings.service_categories == blank and paginate.pages > 1 %}
        <nav
          class="ls-pagination"
          aria-label="More service categories"
        >
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}

      {% if section.settings.footer_heading != blank or section.settings.footer_text != blank or section.settings.footer_button_link != blank %}
        <footer class="ls-footer">
          <div>
            {% if section.settings.footer_heading != blank %}
              <h2>{{ section.settings.footer_heading | escape }}</h2>
            {% endif %}

            {% if section.settings.footer_text != blank %}
              <p>
                {{ section.settings.footer_text | escape | newline_to_br }}
              </p>
            {% endif %}
          </div>

          {% if section.settings.footer_button_label != blank and section.settings.footer_button_link != blank %}
            <a
              class="ls-button"
              href="{{ section.settings.footer_button_link | escape }}"
            >
              {{ section.settings.footer_button_label | escape }}
            </a>
          {% endif %}
        </footer>
      {% endif %}
    </div>

    {% if section.settings.show_floating_button and section.settings.button_link != blank %}
      <a
        class="ls-button ls-floating"
        href="{{ section.settings.button_link | escape }}"
      >
        {{ section.settings.appointment_button_label | default: 'Book Appointment' | escape }}
      </a>
    {% endif %}
  </section>
{% endpaginate %}

<style>
  #la-story-services-{{ section.id }} {
    --ls-ink: #211b17;
    --ls-muted: #665e56;
    --ls-line: #dcd3c8;
    --ls-paper: #f8f3ec;

    background: var(--ls-paper);
    color: var(--ls-ink);
    font-family: "Century Gothic", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.65;
    padding-bottom: 80px;
    -webkit-font-smoothing: antialiased;
  }

  #la-story-services-{{ section.id }} *,
  #la-story-services-{{ section.id }} *::before,
  #la-story-services-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #la-story-services-{{ section.id }} h1,
  #la-story-services-{{ section.id }} h2,
  #la-story-services-{{ section.id }} p,
  #la-story-services-{{ section.id }} a,
  #la-story-services-{{ section.id }} summary,
  #la-story-services-{{ section.id }} dt,
  #la-story-services-{{ section.id }} dd,
  #la-story-services-{{ section.id }} small {
    font-family: inherit;
  }

  #la-story-services-{{ section.id }} h1,
  #la-story-services-{{ section.id }} h2 {
    color: var(--ls-ink);
    font-weight: 400;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  #la-story-services-{{ section.id }} a {
    color: inherit;
  }

  #la-story-services-{{ section.id }} a:focus-visible,
  #la-story-services-{{ section.id }} summary:focus-visible {
    outline: 2px solid var(--ls-ink);
    outline-offset: 5px;
  }

  #la-story-services-{{ section.id }} .ls-arrow {
    display: block;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    color: inherit;
  }

  #la-story-services-{{ section.id }} .ls-hero {
    max-width: 1600px;
    margin-inline: auto;
  }

  #la-story-services-{{ section.id }} .ls-hero--with-image {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }

  #la-story-services-{{ section.id }} .ls-hero__media {
    position: relative;
    min-height: 520px;
    background: #e9e1d6;
  }

  #la-story-services-{{ section.id }} .ls-hero__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #la-story-services-{{ section.id }} .ls-hero__copy {
    padding: clamp(40px, 6vw, 96px);
    align-self: center;
  }

  #la-story-services-{{ section.id }} .ls-hero:not(.ls-hero--with-image) .ls-hero__copy {
    max-width: 1000px;
    margin-inline: auto;
    text-align: center;
  }

  #la-story-services-{{ section.id }} .ls-eyebrow {
    margin: 0 0 22px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ls-muted);
  }

  #la-story-services-{{ section.id }} h1 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 54px);
    line-height: 1.16;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  #la-story-services-{{ section.id }} .ls-intro {
    margin: 24px 0 0;
    color: var(--ls-muted);
    font-size: 16px;
    max-width: 60ch;
  }

  #la-story-services-{{ section.id }} .ls-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 26px;
    margin-top: 30px;
  }

  #la-story-services-{{ section.id }} .ls-hero:not(.ls-hero--with-image) .ls-hero__actions {
    justify-content: center;
  }

  #la-story-services-{{ section.id }} .ls-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 14px 24px;
    background: var(--ls-ink);
    color: #fff;
    border: 1px solid var(--ls-ink);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: .06em;
    text-align: center;
    text-decoration: none;
  }

  #la-story-services-{{ section.id }} .ls-button:hover {
    background: #443b33;
  }

  #la-story-services-{{ section.id }} .ls-text-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    font-size: 13px;
    text-underline-offset: 5px;
  }

  #la-story-services-{{ section.id }} .ls-container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 64px);
    scroll-margin-top: calc(var(--header-height, 80px) + 24px);
  }

  #la-story-services-{{ section.id }} .ls-category-nav {
    padding: 36px 0;
    border-bottom: 1px solid var(--ls-line);
  }

  #la-story-services-{{ section.id }} .ls-category-nav .ls-eyebrow {
    margin-bottom: 16px;
  }

  #la-story-services-{{ section.id }} .ls-category-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #la-story-services-{{ section.id }} .ls-category-nav li {
    max-width: 100%;
  }

  #la-story-services-{{ section.id }} .ls-category-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 46px;
    padding: 12px 16px;
    border: 1px solid var(--ls-line);
    font-size: 12px;
    line-height: 1.5;
    text-decoration: none;
  }

  #la-story-services-{{ section.id }} .ls-category-nav a:hover {
    background: #fffaf4;
    border-color: var(--ls-ink);
  }

  #la-story-services-{{ section.id }} .ls-pricing-intro {
    display: grid;
    grid-template-columns: 1fr 1.65fr;
    gap: 40px;
    padding: 40px 0;
    align-items: start;
  }

  #la-story-services-{{ section.id }} .ls-pricing-intro .ls-eyebrow {
    margin: 3px 0 0;
  }

  #la-story-services-{{ section.id }} .ls-pricing-intro h2 {
    font-size: clamp(24px, 2.5vw, 32px);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -.025em;
  }

  #la-story-services-{{ section.id }} .ls-pricing-note {
    margin: 0;
    font-size: 13px;
    color: var(--ls-muted);
  }

  #la-story-services-{{ section.id }} .ls-groups {
    display: grid;
    gap: 60px;
    padding-top: 12px;
  }

  #la-story-services-{{ section.id }} .ls-group {
    display: grid;
    grid-template-columns: 1fr 1.65fr;
    gap: 40px;
    scroll-margin-top: calc(var(--header-height, 80px) + 24px);
  }

  #la-story-services-{{ section.id }} .ls-group__header h2 {
    font-size: clamp(25px, 2.4vw, 34px);
    line-height: 1.25;
    margin: 0;
    letter-spacing: -.03em;
  }

  #la-story-services-{{ section.id }} .ls-group__header p {
    font-size: 14px;
    color: var(--ls-muted);
    margin: 18px 0 0;
    max-width: 38ch;
  }

  #la-story-services-{{ section.id }} .ls-accordions {
    min-width: 0;
    border-top: 1px solid var(--ls-line);
  }

  #la-story-services-{{ section.id }} .ls-service-section {
    border-bottom: 1px solid var(--ls-line);
  }

  #la-story-services-{{ section.id }} .ls-service-section summary {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 20px;
    padding: 23px 0;
    list-style: none;
    cursor: pointer;
  }

  #la-story-services-{{ section.id }} .ls-service-section summary::-webkit-details-marker {
    display: none;
  }

  #la-story-services-{{ section.id }} .ls-summary-copy {
    min-width: 0;
  }

  #la-story-services-{{ section.id }} .ls-service-title {
    display: block;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 400;
  }

  #la-story-services-{{ section.id }} .ls-service-section small {
    display: block;
    margin-top: 7px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ls-muted);
  }

  #la-story-services-{{ section.id }} .ls-toggle {
    position: relative;
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    border: 1px solid var(--ls-line);
    border-radius: 50%;
  }

  #la-story-services-{{ section.id }} .ls-toggle::before,
  #la-story-services-{{ section.id }} .ls-toggle::after {
    content: "";
    position: absolute;
    inset: 10px 6px;
    background: var(--ls-ink);
    height: 1px;
  }

  #la-story-services-{{ section.id }} .ls-toggle::after {
    transform: rotate(90deg);
  }

  #la-story-services-{{ section.id }} details[open] .ls-toggle::after {
    display: none;
  }

  #la-story-services-{{ section.id }} .ls-price-list {
    margin: 0;
    padding: 0 0 22px;
  }

  #la-story-services-{{ section.id }} .ls-price-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(80px, 35%);
    align-items: baseline;
    gap: 20px;
    padding: 13px 0;
    border-top: 1px solid var(--ls-line);
    font-size: 14px;
  }

  #la-story-services-{{ section.id }} .ls-price-row dt {
    color: var(--ls-muted);
    overflow-wrap: anywhere;
  }

  #la-story-services-{{ section.id }} .ls-price-row dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  #la-story-services-{{ section.id }} .ls-price-row .ls-price-unavailable {
    font-weight: 400;
    font-size: 12px;
  }

  #la-story-services-{{ section.id }}.ls-services--single .ls-container {
    max-width: 1080px;
  }

  #la-story-services-{{ section.id }}.ls-services--single .ls-group {
    display: block;
  }

  #la-story-services-{{ section.id }}.ls-services--single .ls-pricing-intro {
    padding-top: 56px;
  }

  #la-story-services-{{ section.id }} .ls-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-top: 64px;
    padding: 36px;
    background: #eee6dc;
  }

  #la-story-services-{{ section.id }} .ls-footer h2 {
    font-size: clamp(23px, 2.3vw, 30px);
    line-height: 1.3;
    letter-spacing: -.025em;
    margin: 0;
  }

  #la-story-services-{{ section.id }} .ls-footer p {
    font-size: 14px;
    color: var(--ls-muted);
    max-width: 58ch;
    margin: 16px 0 0;
  }

  #la-story-services-{{ section.id }} .ls-footer .ls-button {
    flex-shrink: 0;
    max-width: 100%;
  }

  #la-story-services-{{ section.id }} .ls-floating {
    position: fixed;
    right: 20px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 20;
    max-width: calc(100vw - 40px);
    box-shadow: 0 6px 18px #211b1720;
  }

  #la-story-services-{{ section.id }} .ls-editor-note,
  #la-story-services-{{ section.id }} .ls-pagination {
    margin-block: 24px;
    font-size: 14px;
  }

  @media (max-width: 899px) {
    #la-story-services-{{ section.id }} .ls-hero--with-image {
      grid-template-columns: 1fr;
    }

    #la-story-services-{{ section.id }} .ls-hero__media {
      min-height: 0;
      height: clamp(240px, 60vw, 430px);
    }

    #la-story-services-{{ section.id }} .ls-hero__copy {
      padding: 36px 24px 40px;
    }

    #la-story-services-{{ section.id }} .ls-group,
    #la-story-services-{{ section.id }} .ls-pricing-intro {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    #la-story-services-{{ section.id }} .ls-group__header p {
      max-width: 60ch;
    }

    #la-story-services-{{ section.id }} .ls-footer {
      flex-direction: column;
      align-items: start;
      padding: 28px 24px;
    }

    #la-story-services-{{ section.id }} .ls-groups {
      gap: 44px;
    }
  }

  @media (max-width: 480px) {
    #la-story-services-{{ section.id }} .ls-category-nav ul {
      display: grid;
      grid-template-columns: 1fr;
    }

    #la-story-services-{{ section.id }} .ls-category-nav a {
      font-size: 13px;
    }

    #la-story-services-{{ section.id }} .ls-service-title {
      font-size: 17px;
    }

    #la-story-services-{{ section.id }} .ls-price-row {
      gap: 12px;
      font-size: 13px;
    }

    #la-story-services-{{ section.id }} .ls-footer .ls-button {
      width: 100%;
    }
  }

  @media print {
    #la-story-services-{{ section.id }} .ls-floating,
    #la-story-services-{{ section.id }} .ls-hero__actions,
    #la-story-services-{{ section.id }} .ls-category-nav {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "LA Story Services Page",
  "settings": [
    {
      "type": "metaobject_list",
      "id": "service_categories",
      "label": "Service categories to display",
      "metaobject_type": "la_story_service_category",
      "limit": 50,
      "info": "Select one or more categories in display order. Leave empty to show all available categories. Use separate page templates for different selections."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Opening image",
      "info": "Choose a photo that matches this page’s selected service category. Set the image focal point in Shopify."
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Small introduction label",
      "default": "LA STORY / ATELIER"
    },
    {
      "type": "checkbox",
      "id": "auto_category_intro",
      "label": "Use category name and description for one category",
      "default": true
    },
    {
      "type": "checkbox",
