{% comment %}
  LA STORY — category cards powered by la_story_service_category metaobjects.
  Existing fields: name (single-line text), description (multi-line text).
  Optional fields to add: image (file, images only), service_url (URL).
  service_url takes priority over the metaobject's own online-store URL.
{% endcomment %}
<style>
  #LS-{{ section.id }} {
    background: {{ section.settings.background }};
    color: {{ section.settings.foreground }};
    font-family: "Century Gothic", var(--font-body-family, Arial), Arial, sans-serif;
    font-weight: 400;
    padding: {{ section.settings.spacing }}px 0;
  }
  #LS-{{ section.id }} * { box-sizing: border-box; }
  #LS-{{ section.id }} .ls-wrap { width: min(1440px, 100%); margin: auto; padding: 0 clamp(24px, 4vw, 64px); }
  #LS-{{ section.id }} h2,
  #LS-{{ section.id }} h3,
  #LS-{{ section.id }} p { margin: 0; color: inherit; font-family: inherit; font-weight: 400; letter-spacing: normal; }
  #LS-{{ section.id }} h2 { font-size: clamp(28px, 3.3vw, 46px); line-height: 1.2;A }
  #LS-{{ section.id }} h3 { font-size: 20px; line-height: 1.4; overflow-wrap: anywhere; }
  #LS-{{ section.id }} .ls-eyebrow { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 24px; line-height: 1.6; }
  #LS-{{ section.id }} .ls-body { font-size: 16px; line-height: 1.8; margin-top: 16px; max-width: 48ch; }
  #LS-{{ section.id }} a { color: inherit; text-decoration: none; }
  #LS-{{ section.id }} a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  #LS-{{ section.id }} .ls-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 28px; margin-top: 36px; }
  #LS-{{ section.id }} .ls-card { min-width: 0; }
  #LS-{{ section.id }} .ls-card-link { display: block; }
  #LS-{{ section.id }} .ls-media { aspect-ratio: 4 / 3; background: #e8e2da; overflow: hidden; margin-bottom: 18px; }
  #LS-{{ section.id }} .ls-media img,
  #LS-{{ section.id }} .ls-media svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  #LS-{{ section.id }} .ls-card a:hover h3 { text-decoration: underline; text-underline-offset: 6px; }
  #LS-{{ section.id }} .ls-pagination { margin-top: 32px; }
  @media (min-width: 750px) and (max-width: 1099px) {
    #LS-{{ section.id }} .ls-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    #LS-{{ section.id }} { padding: calc({{ section.settings.spacing }}px * .65) 0; }
    #LS-{{ section.id }} .ls-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

<div id="LS-{{ section.id }}">
  <div class="ls-wrap">
    {% if section.settings.eyebrow != blank %}
      <p class="ls-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% paginate shop.metaobjects.la_story_service_category.values by 250 %}
      {% liquid
        assign categories = section.settings.service_categories
        if categories == blank
          assign categories = shop.metaobjects.la_story_service_category.values
        endif
        assign card_count = 0
      %}
      {% capture cards %}
        {% for category in categories %}
          {% if category != blank %}
            {% liquid
              assign card_count = card_count | plus: 1
              assign card_image = category.image.value
              assign card_url = category.service_url.value
              if card_url == blank
                assign card_url = category.system.url
              endif
              assign image_loading = 'lazy'
              assign image_priority = 'auto'
              if section.index == 1 and card_count == 1
                assign image_loading = 'eager'
                assign image_priority = 'high'
              endif
            %}
            <article class="ls-card">
              {% if card_url != blank %}
                <a class="ls-card-link" href="{{ card_url | escape }}">
              {% endif %}
                {% if card_image != blank %}
                  <div class="ls-media">
                    {{ card_image | image_url: width: 1500 | image_tag:
                      widths: '360, 540, 750, 1100, 1500',
                      sizes: '(min-width: 1440px) 419px, (min-width: 1100px) calc((92vw - 56px) / 3), (min-width: 750px) calc((92vw - 28px) / 2), (min-width: 600px) 92vw, calc(100vw - 48px)',
                      loading: image_loading,
                      fetchpriority: image_priority
                    }}
                  </div>
                {% elsif request.design_mode %}
                  <div class="ls-media" aria-hidden="true">{{ 'image' | placeholder_svg_tag }}</div>
                {% endif %}
                <h3>{{ category.name.value | escape }}</h3>
              {% if card_url != blank %}</a>{% endif %}
              {% if category.description.value != blank %}
                <p class="ls-body">{{ category.description.value | escape | newline_to_br }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      {% endcapture %}
      {% if card_count > 0 %}
        <div class="ls-grid">{{ cards }}</div>
      {% elsif request.design_mode %}
        <p class="ls-body">Select service categories, or add active entries to the la_story_service_category metaobject definition with Storefronts access enabled.</p>
      {% endif %}
      {% if section.settings.service_categories == blank and paginate.pages > 1 %}
        <nav class="ls-pagination" aria-label="More service categories">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "LS — Atelier services",
  "tag": "section",
  "settings": [
    {
      "type": "metaobject_list",
      "id": "service_categories",
      "label": "Service categories",
      "metaobject_type": "la_story_service_category",
      "limit": 50,
      "info": "Select categories in display order. Leave empty to display all available categories. Images and links come from each category's image and service_url fields."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ALTERATIONS & TAILORING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to feel like you."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f8f2ea"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text",
      "default": "#161616"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [{ "name": "LS — Atelier services" }]
}
{% endschema %}
