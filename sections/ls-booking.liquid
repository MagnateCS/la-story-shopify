{% render 'ls-assets' %}

<div
  class="ls-root"
  data-ls-section="{{ section.id }}"
  data-ls-animate="{{ section.settings.animate }}"
  style="
    --ls-bg:{{ section.settings.background }};
    --ls-text:{{ section.settings.text_color }};
    --ls-accent:{{ section.settings.accent }};
    --ls-width:{{ section.settings.content_width }}px;
    --ls-pt:{{ section.settings.padding_top }}px;
    --ls-pb:{{ section.settings.padding_bottom }}px;
  "
>
  <div
    class="ls-pad"
    id="ls-booking-{{ section.id }}"
    {% if section.settings.booking_type == 'link' %}
      data-ls-booking-config
      data-url="{{ section.settings.url | escape }}"
      data-title="{{ section.settings.modal_title | escape }}"
      data-unavailable="{{ section.settings.unavailable | escape }}"
    {% endif %}
  >
    {% if section.settings.show_panel %}
      <div class="ls-wrap">
        <div class="ls-booking-card ls-reveal">
          <div class="ls-booking-content">
            <div class="ls-eyebrow">
              {{ section.settings.eyebrow | escape }}
            </div>

            <h2>
              {{ section.settings.heading | escape | newline_to_br }}
            </h2>

            <p>
              {{ section.settings.description | escape }}
            </p>

            {% if section.settings.booking_type == 'link' %}
              {% render 'ls-book-button',
                label: section.settings.button_label
              %}

            {% elsif section.settings.booking_type == 'embed' %}
              {% if section.settings.url != blank %}
                <div
                  class="ls-booking-embed"
                  id="inline-widget-{{ section.id }}"
                  data-koalendar-url="{{ section.settings.url | escape }}"
                ></div>
              {% else %}
                <div class="ls-booking-empty">
                  {{ section.settings.unavailable | escape }}
                </div>
              {% endif %}
            {% endif %}
          </div>

          <ol class="ls-steps">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <div>
                  <strong>{{ block.settings.title | escape }}</strong>

                  <p>
                    {{ block.settings.text | escape }}
                  </p>
                </div>
              </li>
            {% endfor %}
          </ol>
        </div>
      </div>
    {% endif %}

    {% if section.settings.floating %}
      {% if section.settings.booking_type == 'link' %}
        {% render 'ls-book-button',
          label: section.settings.button_label,
          class: 'ls-floating'
        %}

      {% elsif section.settings.booking_type == 'embed'
        and section.settings.show_panel
        and section.settings.url != blank
      %}
        <a
          class="ls-floating"
          href="#inline-widget-{{ section.id }}"
          aria-label="{{ section.settings.button_label | escape }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    {% endif %}
  </div>
</div>

{% unless section.settings.show_panel %}
  <style>
    #shopify-section-{{ section.id }} .ls-pad {
      padding: 0;
    }
  </style>
{% endunless %}

{% if section.settings.booking_type == 'embed'
  and section.settings.show_panel
  and section.settings.url != blank
%}
  <style>
    #shopify-section-{{ section.id }} .ls-booking-embed {
      width: 100%;
      min-height: {{ section.settings.embed_height }}px;
      margin-top: 30px;
      overflow: hidden;
      border-radius: {{ section.settings.embed_radius }}px;
      background: #ffffff;
      color: #1a1a1a;
    }

    #shopify-section-{{ section.id }} .ls-booking-embed iframe {
      display: block;
      width: 100% !important;
      max-width: 100%;
      min-height: {{ section.settings.embed_height }}px;
      border: 0;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .ls-booking-empty {
      margin-top: 24px;
      padding: 18px 20px;
      border: 1px solid currentColor;
      border-radius: 4px;
      opacity: 0.8;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .ls-booking-embed {
        min-height: {{ section.settings.mobile_embed_height }}px;
        margin-top: 24px;
      }

      #shopify-section-{{ section.id }} .ls-booking-embed iframe {
        min-height: {{ section.settings.mobile_embed_height }}px;
      }
    }
  </style>

  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var widgetId = 'inline-widget-' + sectionId;
      var widgetSelector = '#' + widgetId;
      var widgetUrl = {{ section.settings.url | json }};

      /*
       * Create Koalendar's queue if the external script has not
       * finished loading yet.
       */
      window.Koalendar = window.Koalendar || function () {
        window.Koalendar.props = window.Koalendar.props || [];
        window.Koalendar.props.push(arguments);
      };

      function loadKoalendarScript() {
        var existingScript = document.querySelector(
          'script[data-ls-koalendar-script]'
        );

        if (existingScript) {
          return;
        }

        var script = document.createElement('script');

        script.src = 'https://koalendar.com/assets/widget.js';
        script.async = true;
        script.setAttribute('data-ls-koalendar-script', 'true');

        document.head.appendChild(script);
      }

      function initializeWidget(widget, url) {
        if (!widget || !url) {
          return;
        }

        if (widget.getAttribute('data-koalendar-initialized') === 'true') {
          return;
        }

        widget.setAttribute('data-koalendar-initialized', 'true');

        window.Koalendar('inline', {
          url: url,
          selector: '#' + widget.id
        });
      }

      loadKoalendarScript();

      initializeWidget(
        document.getElementById(widgetId),
        widgetUrl
      );

      /*
       * Shopify reloads sections without refreshing the entire page
       * while the merchant is using the theme editor.
       */
      if (!window.lsKoalendarSectionListenerAdded) {
        window.lsKoalendarSectionListenerAdded = true;

        document.addEventListener('shopify:section:load', function (event) {
          var widgets = event.target.querySelectorAll(
            '[data-koalendar-url]'
          );

          widgets.forEach(function (widget) {
            initializeWidget(
              widget,
              widget.getAttribute('data-koalendar-url')
            );
          });
        });
      }

      /*
       * Smoothly scroll the floating button to the inline calendar.
       */
      var section = document.getElementById(
        'shopify-section-' + sectionId
      );

      if (section) {
        var floatingButton = section.querySelector(
          '.ls-floating[href="' + widgetSelector + '"]'
        );

        if (floatingButton) {
          floatingButton.addEventListener('click', function (event) {
            var widget = document.getElementById(widgetId);

            if (!widget) {
              return;
            }

            event.preventDefault();

            widget.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
          });
        }
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "LA STORY · Bridal booking",
  "tag": "section",
  "class": "ls-shopify-section",
  "limit": 1,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Booking method"
    },
    {
      "type": "select",
      "id": "booking_type",
      "label": "Booking display",
      "options": [
        {
          "value": "link",
          "label": "Booking link and modal"
        },
        {
          "value": "embed",
          "label": "Embedded Koalendar"
        }
      ],
      "default": "link"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Koalendar booking URL",
      "info": "Enter your Koalendar page, such as https://koalendar.com/e/appointments-23. This URL is used for both display options."
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal title",
      "default": "Try on wedding dresses",
      "info": "Used when Booking display is set to Booking link and modal."
    },
    {
      "type": "text",
      "id": "unavailable",
      "label": "Calendar unavailable message",
      "default": "Online scheduling will be available soon. Please check back shortly."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Booking button",
      "default": "Book a bridal appointment"
    },
    {
      "type": "checkbox",
      "id": "floating",
      "label": "Show floating booking button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_panel",
      "label": "Show booking information panel",
      "default": true
    },
    {
      "type": "header",
      "content": "Embedded calendar"
    },
    {
      "type": "range",
      "id": "embed_height",
      "label": "Desktop calendar height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "mobile_embed_height",
      "label": "Mobile calendar height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "embed_radius",
      "label": "Calendar corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Booking panel content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your bridal appointment"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Come find\nyour wedding dress."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Book an appointment to try on wedding dresses at our Simi Valley boutique. Bring your ideas, your inspiration, and the excitement of finding your gown."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#3D0D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and accent",
      "default": "#741D2B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 960,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Gentle entrance animations",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "LA STORY · Bridal booking",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Choose a time",
            "text": "Choose a time to visit our bridal boutique."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Share your bridal vision",
            "text": "Tell us your wedding date and the styles you love."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Try on wedding dresses",
            "text": "Explore gowns and discover your favorite silhouette."
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Appointment step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose a time"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Choose a time to visit our bridal boutique."
        }
      ]
    }
  ],
  "max_blocks": 18
}
{% endschema %}