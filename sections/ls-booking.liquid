{% render 'ls-assets' %}

<div
  class="ls-root"
  data-ls-section="{{ section.id }}"
  data-ls-animate="{{ section.settings.animate }}"
  style="
    --ls-bg:{{ section.settings.background }};
    --ls-text:{{ section.settings.text_color }};
    --ls-accent:{{ section.settings.accent }};
    --ls-width:{{ section.settings.content_width }}px;
    --ls-pt:{{ section.settings.padding_top }}px;
    --ls-pb:{{ section.settings.padding_bottom }}px;
  "
>
  <div
    class="ls-pad"
    id="ls-booking-{{ section.id }}"
    {% if section.settings.booking_type == 'link' %}
      data-ls-booking-config
      data-url="{{ section.settings.url | escape }}"
      data-title="{{ section.settings.modal_title | escape }}"
      data-unavailable="{{ section.settings.unavailable | escape }}"
    {% endif %}
  >
    {% if section.settings.show_panel %}
      <div class="ls-wrap">
        <div class="ls-booking-card ls-reveal">
          <div class="ls-booking-content">
            <div class="ls-eyebrow">
              {{ section.settings.eyebrow | escape }}
            </div>

            <h2>
              {{ section.settings.heading | escape | newline_to_br }}
            </h2>

            <p>
              {{ section.settings.description | escape }}
            </p>

            {% if section.settings.booking_type == 'link' %}
              {% render 'ls-book-button',
                label: section.settings.button_label
              %}
            {% else %}
              <button
                type="button"
                class="ls-button ls-embed-booking-trigger"
                data-ls-embed-booking-open="{{ section.id }}"
                aria-haspopup="dialog"
                aria-controls="ls-booking-modal-{{ section.id }}"
              >
                {{ section.settings.button_label | escape }}
              </button>
            {% endif %}
          </div>

          <ol class="ls-steps">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <div>
                  <strong>
                    {{ block.settings.title | escape }}
                  </strong>

                  <p>
                    {{ block.settings.text | escape }}
                  </p>
                </div>
              </li>
            {% endfor %}
          </ol>
        </div>
      </div>
    {% endif %}

    {% if section.settings.floating %}
      {% if section.settings.booking_type == 'link' %}
        {% render 'ls-book-button',
          label: section.settings.button_label,
          class: 'ls-floating'
        %}
      {% else %}
        <button
          type="button"
          class="ls-button ls-floating ls-embed-booking-trigger"
          data-ls-embed-booking-open="{{ section.id }}"
          aria-haspopup="dialog"
          aria-controls="ls-booking-modal-{{ section.id }}"
        >
          {{ section.settings.button_label | escape }}
        </button>
      {% endif %}
    {% endif %}
  </div>

  {% if section.settings.booking_type == 'embed' %}
    <div
      class="ls-embed-modal"
      id="ls-booking-modal-{{ section.id }}"
      data-ls-embed-booking-modal="{{ section.id }}"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="ls-booking-modal-title-{{ section.id }}"
      hidden
    >
      <div
        class="ls-embed-modal-overlay"
        data-ls-embed-booking-close="{{ section.id }}"
      ></div>

      <div
        class="ls-embed-modal-dialog"
        role="document"
        tabindex="-1"
      >
        <div class="ls-embed-modal-header">
          <div class="ls-embed-modal-heading">
            <div class="ls-embed-modal-eyebrow">
              {{ section.settings.eyebrow | escape }}
            </div>

            <h2 id="ls-booking-modal-title-{{ section.id }}">
              {{ section.settings.modal_title | escape }}
            </h2>
          </div>

          <button
            type="button"
            class="ls-embed-modal-close"
            data-ls-embed-booking-close="{{ section.id }}"
            aria-label="Close booking calendar"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            >
              <path d="M5 5l14 14"></path>
              <path d="M19 5L5 19"></path>
            </svg>
          </button>
        </div>

        <div class="ls-embed-modal-body">
          {% if section.settings.url != blank %}
            <div
              class="ls-koalendar-widget"
              id="inline-widget-{{ section.id }}"
              data-koalendar-url="{{ section.settings.url | escape }}"
            >
              <div class="ls-koalendar-loading">
                Loading appointment calendar…
              </div>
            </div>
          {% else %}
            <div class="ls-booking-empty">
              {{ section.settings.unavailable | escape }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  {% unless section.settings.show_panel %}
    #shopify-section-{{ section.id }} .ls-pad {
      padding: 0;
    }
  {% endunless %}

  #shopify-section-{{ section.id }} .ls-embed-booking-trigger {

  }

  #shopify-section-{{ section.id }} .ls-embed-modal[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 8, 11, 0.76);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-dialog {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(960px, 100%);
    max-height: calc(100vh - 48px);
    overflow: hidden;
    border-radius: {{ section.settings.modal_radius }}px;
    background: #fffdf9;
    color: #231f20;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.3);
    outline: none;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-header {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 0 0 auto;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
    border-bottom: 1px solid rgba(35, 31, 32, 0.12);
    background: #fffdf9;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-heading {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-eyebrow {
    margin-bottom: 6px;
    color: {{ section.settings.accent }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-header h2 {
    margin: 0;
    color: #231f20;
    font-size: clamp(25px, 3vw, 38px);
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-close {
    display: grid;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(35, 31, 32, 0.16);
    border-radius: 50%;
    background: transparent;
    color: #231f20;
    cursor: pointer;
    transition:
      color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-close:hover {
    background: {{ section.settings.accent }};
    color: #ffffff;
    transform: rotate(4deg);
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-close:focus-visible {
    outline: 2px solid {{ section.settings.accent }};
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal-body {
    flex: 1 1 auto;
    min-height: 0;
    max-height: calc(100vh - 145px);
    overflow-x: hidden;
    overflow-y: auto;
    background: #ffffff;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .ls-koalendar-widget {
    width: 100%;
    height: {{ section.settings.embed_height }}px;
    overflow: hidden;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .ls-koalendar-widget iframe {
    display: block;
    width: 100% !important;
    max-width: 100%;
    height: calc({{ section.settings.embed_height }}px + {{ section.settings.desktop_crop_top }}px) !important;
    min-height: calc({{ section.settings.embed_height }}px + {{ section.settings.desktop_crop_top }}px);
    transform: translateY(-{{ section.settings.desktop_crop_top }}px);
    margin: 0;
    border: 0;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .ls-koalendar-loading,
  #shopify-section-{{ section.id }} .ls-booking-empty {
    display: grid;
    min-height: 180px;
    place-items: center;
    padding: 32px;
    color: #5f5658;
    text-align: center;
  }

  body.ls-booking-modal-open {
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }

  #shopify-section-{{ section.id }} .ls-embed-modal,
  #shopify-section-{{ section.id }} .ls-embed-modal-dialog,
  #shopify-section-{{ section.id }} .ls-embed-modal-body,
  #shopify-section-{{ section.id }} .ls-koalendar-widget {
    touch-action: auto;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ls-embed-modal {
      display: block;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      padding: 0;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-overlay {
      display: none;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-dialog {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: none;
      height: 100vh;
      height: 100dvh;
      max-height: none;
      margin: 0;
      overflow: hidden;
      border-radius: 0;
      background: #ffffff;
      box-shadow: none;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-header {
      position: relative;
      z-index: 10;
      align-items: center;
      gap: 14px;
      min-height: 74px;
      padding:
        calc(12px + env(safe-area-inset-top))
        max(14px, env(safe-area-inset-right))
        12px
        max(18px, env(safe-area-inset-left));
      border-bottom: 1px solid rgba(35, 31, 32, 0.12);
      background: #fffdf9;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-eyebrow {
      display: none;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-header h2 {
      overflow: hidden;
      margin: 0;
      font-size: clamp(21px, 6vw, 26px);
      line-height: 1.15;
      text-overflow: ellipsis;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-close {
      flex-basis: 48px;
      width: 48px;
      height: 48px;
      border-color: rgba(35, 31, 32, 0.18);
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-close:hover {
      background: #ffffff;
      color: #231f20;
      transform: none;
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-close:active {
      background: {{ section.settings.accent }};
      color: #ffffff;
      transform: scale(0.96);
    }

    #shopify-section-{{ section.id }} .ls-embed-modal-body {
      position: relative;
      display: block;
      flex: 1 1 auto;
      min-height: 0;
      width: 100%;
      max-height: none;
      padding-bottom: env(safe-area-inset-bottom);
      overflow-x: hidden;
      overflow-y: auto;
      background: #ffffff;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .ls-koalendar-widget {
      width: 100%;
      min-height: calc(
        100vh - 74px - env(safe-area-inset-top)
      );
      min-height: calc(
        100dvh - 74px - env(safe-area-inset-top)
      );
      height: calc(100dvh - 74px - env(safe-area-inset-top));
      overflow: hidden;
      margin: 0;
      padding: 0;
      border-radius: 0;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .ls-koalendar-widget iframe {
      display: block;
      width: 100% !important;
      max-width: 100% !important;
      min-height: calc(
        100vh - 74px - env(safe-area-inset-top)
      );
      min-height: calc(
        100dvh - 74px - env(safe-area-inset-top) + {{ section.settings.mobile_crop_top }}px
      );
      height: calc(
        100dvh - 74px - env(safe-area-inset-top) + {{ section.settings.mobile_crop_top }}px
      ) !important;
      transform: translateY(-{{ section.settings.mobile_crop_top }}px);
      margin: 0;
      border: 0;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .ls-koalendar-loading,
    #shopify-section-{{ section.id }} .ls-booking-empty {
      min-height: calc(
        100vh - 74px - env(safe-area-inset-top)
      );
      min-height: calc(
        100dvh - 74px - env(safe-area-inset-top)
      );
      padding: 24px;
    }
  }
</style>

{% if section.settings.booking_type == 'embed' %}
  <script>
    (function () {
      var sectionId = {{ section.id | json }};

      var sectionElement = document.getElementById(
        'shopify-section-' + sectionId
      );

      if (!sectionElement) {
        return;
      }

      var modal = sectionElement.querySelector(
        '[data-ls-embed-booking-modal="' + sectionId + '"]'
      );

      if (!modal) {
        return;
      }

      var dialog = modal.querySelector(
        '.ls-embed-modal-dialog'
      );

      var openButtons = sectionElement.querySelectorAll(
        '[data-ls-embed-booking-open="' + sectionId + '"]'
      );

      var closeButtons = modal.querySelectorAll(
        '[data-ls-embed-booking-close="' + sectionId + '"]'
      );

      var widget = modal.querySelector(
        '[data-koalendar-url]'
      );

      var previouslyFocusedElement = null;
      var koalendarRequested = false;
      var savedScrollPosition = 0;

      window.Koalendar = window.Koalendar || function () {
        window.Koalendar.props =
          window.Koalendar.props || [];

        window.Koalendar.props.push(arguments);
      };

      function loadKoalendarScript() {
        var existingScript = document.querySelector(
          'script[data-ls-koalendar-script]'
        );

        if (existingScript) {
          return;
        }

        var script = document.createElement('script');

        script.src =
          'https://koalendar.com/assets/widget.js';

        script.async = true;

        script.setAttribute(
          'data-ls-koalendar-script',
          'true'
        );

        document.head.appendChild(script);
      }

      function initializeKoalendar() {
        if (!widget || koalendarRequested) {
          return;
        }

        var widgetUrl = widget.getAttribute(
          'data-koalendar-url'
        );

        if (!widgetUrl) {
          return;
        }

        koalendarRequested = true;

        var loadingMessage = widget.querySelector(
          '.ls-koalendar-loading'
        );

        if (loadingMessage) {
          loadingMessage.remove();
        }

        window.Koalendar('inline', {
          url: widgetUrl,
          selector: '#' + widget.id
        });
      }

      function lockPageScroll() {
        savedScrollPosition =
          window.pageYOffset ||
          document.documentElement.scrollTop ||
          0;

        document.body.classList.add(
          'ls-booking-modal-open'
        );

        document.body.style.position = 'fixed';
        document.body.style.top =
          '-' + savedScrollPosition + 'px';

        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
      }

      function unlockPageScroll() {
        document.body.classList.remove(
          'ls-booking-modal-open'
        );

        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.width = '';

        window.scrollTo(0, savedScrollPosition);
      }

      function openModal() {
        if (!modal.hidden) {
          return;
        }

        previouslyFocusedElement =
          document.activeElement;

        modal.hidden = false;

        modal.setAttribute(
          'aria-hidden',
          'false'
        );

        lockPageScroll();
        loadKoalendarScript();

        /*
         * Wait until the modal is visible before Koalendar
         * calculates its available width.
         */
        window.requestAnimationFrame(function () {
          initializeKoalendar();

          window.requestAnimationFrame(function () {
            if (dialog) {
              dialog.focus();
            }
          });
        });
      }

      function closeModal() {
        if (modal.hidden) {
          return;
        }

        modal.setAttribute(
          'aria-hidden',
          'true'
        );

        modal.hidden = true;

        unlockPageScroll();

        if (
          previouslyFocusedElement &&
          typeof previouslyFocusedElement.focus ===
            'function'
        ) {
          previouslyFocusedElement.focus();
        }
      }

      function getFocusableElements() {
        return modal.querySelectorAll(
          'button:not([disabled]), ' +
          'a[href], ' +
          'input:not([disabled]), ' +
          'select:not([disabled]), ' +
          'textarea:not([disabled]), ' +
          '[tabindex]:not([tabindex="-1"])'
        );
      }

      function handleKeydown(event) {
        if (modal.hidden) {
          return;
        }

        if (event.key === 'Escape') {
          event.preventDefault();
          closeModal();
          return;
        }

        if (event.key !== 'Tab') {
          return;
        }

        var focusableElements =
          getFocusableElements();

        if (!focusableElements.length) {
          event.preventDefault();

          if (dialog) {
            dialog.focus();
          }

          return;
        }

        var firstElement = focusableElements[0];

        var lastElement =
          focusableElements[
            focusableElements.length - 1
          ];

        if (
          event.shiftKey &&
          document.activeElement === firstElement
        ) {
          event.preventDefault();
          lastElement.focus();
        } else if (
          !event.shiftKey &&
          document.activeElement === lastElement
        ) {
          event.preventDefault();
          firstElement.focus();
        }
      }

      openButtons.forEach(function (button) {
        button.addEventListener(
          'click',
          openModal
        );
      });

      closeButtons.forEach(function (button) {
        button.addEventListener(
          'click',
          closeModal
        );
      });

      modal.addEventListener(
        'keydown',
        handleKeydown
      );

      document.addEventListener(
        'shopify:section:select',
        function (event) {
          if (
            event.detail.sectionId === sectionId
          ) {
            openModal();
          }
        }
      );

      document.addEventListener(
        'shopify:section:deselect',
        function (event) {
          if (
            event.detail.sectionId === sectionId
          ) {
            closeModal();
          }
        }
      );

      document.addEventListener(
        'shopify:section:unload',
        function (event) {
          if (
            event.detail.sectionId === sectionId &&
            !modal.hidden
          ) {
            unlockPageScroll();
          }
        }
      );
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "LA STORY · Bridal booking",
  "tag": "section",
  "class": "ls-shopify-section",
  "limit": 1,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Booking method"
    },
    {
      "type": "select",
      "id": "booking_type",
      "label": "Booking type",
      "options": [
        {
          "value": "link",
          "label": "Open booking link"
        },
        {
          "value": "embed",
          "label": "Koalendar inside modal"
        }
      ],
      "default": "link"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Koalendar booking URL",
      "info": "Enter your Koalendar booking page, such as https://koalendar.com/e/appointments-23."
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal title",
      "default": "Try on wedding dresses"
    },
    {
      "type": "text",
      "id": "unavailable",
      "label": "Calendar unavailable message",
      "default": "Online scheduling will be available soon. Please check back shortly."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Booking button",
      "default": "Book a bridal appointment"
    },
    {
      "type": "checkbox",
      "id": "floating",
      "label": "Show fixed booking button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_panel",
      "label": "Show booking information panel",
      "default": true
    },
    {
      "type": "header",
      "content": "Embedded calendar modal"
    },
    {
      "type": "range",
      "id": "embed_height",
      "label": "Desktop calendar height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "mobile_embed_height",
      "label": "Mobile calendar height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "desktop_crop_top",
      "label": "Hide top of calendar (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_crop_top",
      "label": "Hide top of calendar (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "modal_radius",
      "label": "Desktop modal corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Booking panel content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your bridal appointment"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Come find\nyour wedding dress."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Book an appointment to try on wedding dresses at our Simi Valley boutique. Bring your ideas, your inspiration, and the excitement of finding your gown."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#3D0D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and accent",
      "default": "#741D2B"
    },
    {
      "type": "range",
      "id": "padding_top",
