{% comment %}
  LS — Booking: fixed trigger and native modal with Koalendar inline embed.
  Add once per page, ideally in a shared footer section group for site-wide use.
{% endcomment %}
{% assign booking_url = section.settings.booking_url | default: 'https://koalendar.com/e/la-story-bridal' %}
<ls-booking id="LSBooking-{{ section.id }}" data-booking-url="{{ booking_url | escape }}">
  <button type="button" class="ls-booking__trigger" data-open aria-haspopup="dialog" aria-controls="LSBookingDialog-{{ section.id }}">
    {{ section.settings.button_label | default: 'Book an appointment' | escape }}
  </button>
  <noscript><a class="ls-booking__trigger" href="{{ booking_url | escape }}">{{ section.settings.button_label | default: 'Book an appointment' | escape }}</a></noscript>
  <dialog id="LSBookingDialog-{{ section.id }}" class="ls-booking__dialog" aria-labelledby="LSBookingTitle-{{ section.id }}">
    <div class="ls-booking__panel">
      <header class="ls-booking__header">
        <div>
          <p class="ls-booking__eyebrow">LA STORY</p>
          <h2 id="LSBookingTitle-{{ section.id }}">{{ section.settings.modal_heading | default: 'Book your appointment' | escape }}</h2>
        </div>
        <form method="dialog"><button class="ls-booking__close" aria-label="Close booking" autofocus><span aria-hidden="true">×</span></button></form>
      </header>
      <div class="ls-booking__scroll">
        <p class="ls-booking__status" role="status">Loading available appointments…</p>
        <div id="LSBookingWidget-{{ section.id }}" class="ls-booking__widget" data-widget></div>
      </div>
      <footer class="ls-booking__footer">
        <a href="{{ booking_url | escape }}" target="_blank" rel="noopener">Open booking in a new tab <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </dialog>
</ls-booking>

<style>
  #LSBooking-{{ section.id }} { --ls-booking-bg: {{ section.settings.button_background }}; --ls-booking-fg: {{ section.settings.button_text }}; font-family: "Century Gothic", Arial, sans-serif; }
  #LSBooking-{{ section.id }} *, #LSBooking-{{ section.id }} *::before, #LSBooking-{{ section.id }} *::after { box-sizing: border-box; }
  #LSBooking-{{ section.id }} button, #LSBooking-{{ section.id }} a, #LSBooking-{{ section.id }} h2, #LSBooking-{{ section.id }} p { font-family: inherit; }
  #LSBooking-{{ section.id }} .ls-booking__trigger {
    position: fixed; z-index: 40;
    bottom: calc({{ section.settings.bottom_offset }}px + env(safe-area-inset-bottom, 0px));
    {% if section.settings.position == 'left' %}left: max(20px, env(safe-area-inset-left, 0px));{% else %}right: max(20px, env(safe-area-inset-right, 0px));{% endif %}
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 52px; max-width: calc(100vw - 40px); padding: 14px 25px;
    border: 1px solid var(--ls-booking-bg); border-radius: {{ section.settings.button_radius }}px;
    background: var(--ls-booking-bg); color: var(--ls-booking-fg);
    font-size: 12px; line-height: 1.5; letter-spacing: .08em; text-transform: uppercase;
    text-align: center; text-decoration: none; cursor: pointer; box-shadow: 0 6px 24px #00000020;
  }
  #LSBooking-{{ section.id }} .ls-booking__trigger:hover { filter: brightness(.9); }
  #LSBooking-{{ section.id }} button:focus-visible, #LSBooking-{{ section.id }} a:focus-visible { outline: 2px solid #947343; outline-offset: 4px; }
  #LSBooking-{{ section.id }} .ls-booking__dialog {
    position: fixed; inset: 0; margin: auto; padding: 0;
    width: min(1080px, calc(100vw - 48px)); max-width: none;
    height: min(900px, calc(100vh - 48px)); height: min(900px, calc(100dvh - 48px));
    max-height: none; border: 0; border-radius: 8px;
    background: #fff; color: #211b17; overflow: hidden; box-shadow: 0 24px 90px #00000040;
    font-family: "Century Gothic", Arial, sans-serif;
  }
  #LSBooking-{{ section.id }} .ls-booking__dialog:not([open]) { display: none; }
  #LSBooking-{{ section.id }} .ls-booking__dialog::backdrop { background: rgb(20 17 14 / .58); }
  #LSBooking-{{ section.id }} .ls-booking__panel { display: flex; flex-direction: column; height: 100%; min-height: 0; }
  #LSBooking-{{ section.id }} .ls-booking__header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 28px; background: #f8f2ea; border-bottom: 1px solid #e8e0d6; flex-shrink: 0; }
  #LSBooking-{{ section.id }} .ls-booking__eyebrow { margin: 0 0 6px; font-size: 10px; letter-spacing: .18em; line-height: 1.4; }
  #LSBooking-{{ section.id }} h2 { margin: 0; font-size: clamp(20px, 1rem + 1vw, 28px); font-weight: 400; line-height: 1.3; color: inherit; text-transform: none; letter-spacing: normal; }
  #LSBooking-{{ section.id }} form { margin: 0; flex-shrink: 0; }
  #LSBooking-{{ section.id }} .ls-booking__close { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid #d2c8bb; background: transparent; color: #211b17; border-radius: 50%; font-size: 28px; line-height: 1; cursor: pointer; }
  #LSBooking-{{ section.id }} .ls-booking__scroll { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  #LSBooking-{{ section.id }} .ls-booking__status { margin: 0; padding: 24px; font-size: 14px; line-height: 1.6; }
  #LSBooking-{{ section.id }} .ls-booking__status[hidden] { display: none; }
  #LSBooking-{{ section.id }} .ls-booking__widget { width: 100%; min-height: 620px; }
  #LSBooking-{{ section.id }} .ls-booking__widget iframe { display: block; width: 100%; max-width: 100%; border: 0; min-height: 620px; }
  #LSBooking-{{ section.id }} .ls-booking__footer { flex-shrink: 0; padding: 12px 24px; border-top: 1px solid #eee; text-align: center; }
  #LSBooking-{{ section.id }} .ls-booking__footer a { display: inline-flex; align-items: center; min-height: 32px; gap: 8px; font-size: 12px; line-height: 1.5; color: #51483f; text-underline-offset: 3px; }
  @media (max-width: 749px) {
    #LSBooking-{{ section.id }} .ls-booking__dialog { width: calc(100vw - 16px); height: calc(100vh - 24px); height: calc(100dvh - 24px); border-radius: 8px; }
    #LSBooking-{{ section.id }} .ls-booking__header { padding: 16px; gap: 12px; }
    #LSBooking-{{ section.id }} .ls-booking__footer { padding: 8px 16px; }
    {% if section.settings.mobile_full_width %}
    #LSBooking-{{ section.id }} .ls-booking__trigger { left: max(16px, env(safe-area-inset-left, 0px)); right: max(16px, env(safe-area-inset-right, 0px)); width: auto; max-width: none; }
    {% endif %}
  }
  @media print { #LSBooking-{{ section.id }} { display: none; } }
</style>

{% javascript %}
if (!customElements.get('ls-booking')) {
  customElements.define('ls-booking', class extends HTMLElement {
    connectedCallback() {
      this.dialog = this.querySelector('dialog');
      this.trigger = this.querySelector('[data-open]');
      this.widget = this.querySelector('[data-widget]');
      this.status = this.querySelector('[role="status"]');
      if (!this.dialog || this.controller) return;
      this.controller = new AbortController();
      const options = { signal: this.controller.signal };
      this.trigger.addEventListener('click', () => this.openBooking(), options);
      this.dialog.addEventListener('close', () => this.unlockPage(), options);
      // Only dismiss when both the press and release occurred on the backdrop.
      this.dialog.addEventListener('pointerdown', event => {
        this.backdropPress = event.target === this.dialog;
      }, options);
      this.dialog.addEventListener('click', event => {
        if (event.target === this.dialog && this.backdropPress) this.dialog.close();
        this.backdropPress = false;
      }, options);
    }
    openBooking() {
      if (typeof this.dialog.showModal !== 'function') {
        window.location.assign(this.dataset.bookingUrl);
        return;
      }
      if (this.dialog.open) return;
      // Keep only one LS booking modal active, including in the theme editor.
      document.querySelectorAll('ls-booking dialog[open]').forEach(dialog => {
        dialog.close();
        dialog.closest('ls-booking')?.unlockPage();
      });
      this.dialog.showModal();
      if (!this.locked) {
        this.scrollY = window.scrollY;
        this.bodyStyle = ['position', 'top', 'left', 'right', 'width'].map(name => [name, document.body.style.getPropertyValue(name), document.body.style.getPropertyPriority(name)]);
        document.body.style.position = 'fixed';
        document.body.style.top = `-${this.scrollY}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        this.locked = true;
      }
      if (!this.mounted) this.mountCalendar();
    }
    unlockPage() {
      if (!this.locked) return;
      this.bodyStyle.forEach(([name, value, priority]) => {
        if (value) document.body.style.setProperty(name, value, priority);
        else document.body.style.removeProperty(name);
      });
      window.scrollTo({ top: this.scrollY, behavior: 'instant' });
      this.locked = false;
    }
    mountCalendar() {
      this.mounted = true;
      const markFrame = () => {
        const frame = this.widget.querySelector('iframe');
        if (!frame) return;
        frame.title = 'LA STORY appointment booking';
        frame.addEventListener('load', () => {
          this.status.hidden = true;
          clearTimeout(this.loadingTimer);
        }, { once: true, signal: this.controller.signal });
        this.observer.disconnect();
      };
      this.observer = new MutationObserver(markFrame);
      this.observer.observe(this.widget, { childList: true, subtree: true });
      this.loadingTimer = setTimeout(() => {
        if (!this.status.hidden) this.status.textContent = 'Taking longer than expected? Use the link below to book in a new tab.';
      }, 20000);
      window.Koalendar = window.Koalendar || function () {
        (window.Koalendar.props = window.Koalendar.props || []).push(arguments);
      };
      window.Koalendar('init');
      window.Koalendar('inline', { url: this.dataset.bookingUrl, selector: '#' + CSS.escape(this.widget.id) });
      const source = 'https://koalendar.com/assets/widget.js';
      if (!Array.from(document.scripts).some(script => script.src === source)) {
        const script = document.createElement('script');
        script.src = source;
        script.async = true;
        script.addEventListener('error', () => {
          if (this.isConnected) this.status.textContent = 'The calendar could not load. Please use the booking link below.';
        }, { once: true });
        document.head.appendChild(script);
      }
      markFrame();
    }
    disconnectedCallback() {
      if (this.dialog?.open) this.dialog.close();
      this.unlockPage();
      this.controller?.abort();
      this.controller = null;
      this.observer?.disconnect();
      clearTimeout(this.loadingTimer);
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "LS — Booking",
  "tag": "section",
  "class": "ls-booking-section",
  "limit": 1,
  "settings": [
    { "type": "url", "id": "booking_url", "label": "Koalendar booking URL", "info": "Paste only the booking URL, not the embed code. Leave empty to use https://koalendar.com/e/la-story-bridal." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book an appointment" },
    { "type": "text", "id": "modal_heading", "label": "Modal heading", "default": "Book your appointment" },
    { "type": "select", "id": "position", "label": "Button position", "default": "right", "options": [{ "value": "right", "label": "Bottom right" }, { "value": "left", "label": "Bottom left" }] },
    { "type": "checkbox", "id": "mobile_full_width", "label": "Full-width button on mobile", "default": false },
    { "type": "range", "id": "bottom_offset", "label": "Distance from bottom", "min": 8, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 2 },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#211b17" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "LS — Booking" }]
}
{% endschema %}
