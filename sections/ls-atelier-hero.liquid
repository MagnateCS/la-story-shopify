{% comment %}
  LA STORY — Simple image or video hero
  Uses the theme's existing Century Gothic font.
{% endcomment %}

{% liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign hero_image = section.settings.image

  if hero_image == blank and section.settings.video != blank
    assign hero_image = section.settings.video.preview_image
  endif
%}

<style>
  #LS-{{ section.id }} {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    padding: clamp(64px, 10vw, 120px) clamp(24px, 6vw, 96px);
    background: #161616;
    color: #ffffff;
    font-family: "Century Gothic", Arial, sans-serif;
  }

  #LS-{{ section.id }} *,
  #LS-{{ section.id }} *::before,
  #LS-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #LS-{{ section.id }} * {
    font-family: inherit;
  }

  #LS-{{ section.id }} .ls-background {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  #LS-{{ section.id }} .ls-background img,
  #LS-{{ section.id }} .ls-background video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  #LS-{{ section.id }} .ls-background video {
    opacity: 0;
  }

  #LS-{{ section.id }}.is-playing .ls-background video {
    opacity: 1;
  }

  #LS-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, {{ overlay_opacity }});
    pointer-events: none;
  }

  #LS-{{ section.id }} .ls-content {
    width: 100%;
    max-width: 760px;
    min-width: 0;
    overflow-wrap: break-word;
  }

  #LS-{{ section.id }} h1 {
    max-width: 19ch;
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.25rem, 1.4rem + 3vw, 4.5rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    text-transform: none;
    text-wrap: balance;
  }

  #LS-{{ section.id }} .ls-body {
    max-width: 44ch;
    margin-top: 24px;
    color: #ffffff;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  #LS-{{ section.id }} .ls-body p {
    margin: 0;
    color: inherit;
  }

  #LS-{{ section.id }} .ls-body p + p {
    margin-top: 12px;
  }

  #LS-{{ section.id }} .ls-body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  #LS-{{ section.id }} .ls-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 52px;
    margin-top: 32px;
    padding: 15px 30px;
    border: 1px solid #ffffff;
    border-radius: 0;
    background: #ffffff;
    color: #161616;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: normal;
    text-align: center;
    text-decoration: none;
    text-transform: none;
  }

  #LS-{{ section.id }} .ls-button:hover {
    background: #eeeeee;
    border-color: #eeeeee;
  }

  #LS-{{ section.id }} a:focus-visible,
  #LS-{{ section.id }} button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 5px;
  }

  #LS-{{ section.id }} .ls-video-toggle {
    position: absolute;
    right: 24px;
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid #ffffff;
    border-radius: 0;
    background: #161616;
    color: #ffffff;
    font-size: 0.75rem;
    line-height: 1.5;
    cursor: pointer;
  }

  #LS-{{ section.id }} .ls-video-toggle[hidden] {
    display: none;
  }

  @media (max-width: 749px) {
    #LS-{{ section.id }} {
      padding: 80px 24px 96px;
    }

    #LS-{{ section.id }} h1 {
      font-size: clamp(2.125rem, 1.5rem + 3vw, 3rem);
      line-height: 1.16;
    }

    #LS-{{ section.id }} .ls-body {
      margin-top: 20px;
    }

    #LS-{{ section.id }} .ls-button {
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LS-{{ section.id }} .ls-background video {
      display: none;
    }

    #LS-{{ section.id }} .ls-video-toggle {
      display: none;
    }
  }
</style>

<div id="LS-{{ section.id }}">
  <div class="ls-background" aria-hidden="true">
    {% if hero_image != blank %}
      {{
        hero_image
        | image_url: width: 2600
        | image_tag:
          widths: '750, 1100, 1500, 1800, 2200, 2600',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {% endif %}

    {% if section.settings.video != blank %}
      <video
        muted
        loop
        playsinline
        preload="none"
        tabindex="-1"
        {% if hero_image != blank %}
          poster="{{ hero_image | image_url: width: 1800 }}"
        {% endif %}
      >
        {% for source in section.settings.video.sources %}
          <source
            data-src="{{ source.url | escape }}"
            type="{{ source.mime_type | escape }}"
          >
        {% endfor %}
      </video>
    {% endif %}
  </div>

  <div class="ls-content">
    {% if section.settings.heading != blank %}
      <h1>{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="ls-body">
        {{ section.settings.body }}
      </div>
    {% endif %}

    {% if section.settings.label != blank and section.settings.link != blank %}
      <a
        class="ls-button"
        href="{{ section.settings.link | escape }}"
      >
        {{ section.settings.label | escape }}
      </a>
    {% endif %}
  </div>

  {% if section.settings.video != blank %}
    <button
      class="ls-video-toggle"
      type="button"
      aria-label="Play background video"
      hidden
    >
      Play video
    </button>
  {% endif %}
</div>

<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const rootId = 'LS-' + sectionId;
    const root = document.getElementById(rootId);

    if (!root || root.dataset.videoInitialized === 'true') return;

    const video = root.querySelector('video');
    const toggle = root.querySelector('.ls-video-toggle');

    if (!video || !toggle) return;

    root.dataset.videoInitialized = 'true';

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let sourcesLoaded = false;
    let disposed = false;

    function updateButton() {
      const playing = !video.paused && !video.ended;

      toggle.textContent = playing ? 'Pause video' : 'Play video';
      toggle.setAttribute(
        'aria-label',
        playing ? 'Pause background video' : 'Play background video'
      );
    }

    function loadSources() {
      if (sourcesLoaded) return;

      video.querySelectorAll('source[data-src]').forEach((source) => {
        source.src = source.dataset.src;
      });

      sourcesLoaded = true;
      video.load();
    }

    async function playVideo() {
      if (disposed || reducedMotion.matches) return;

      loadSources();
      video.muted = true;

      try {
        await video.play();

        if (disposed || reducedMotion.matches) {
          video.pause();
          root.classList.remove('is-playing');
        }
      } catch (error) {
        root.classList.remove('is-playing');
      }

      updateButton();
    }

    function onPlaying() {
      if (disposed || reducedMotion.matches) {
        video.pause();
        return;
      }

      root.classList.add('is-playing');
      updateButton();
    }

    function onError() {
      root.classList.remove('is-playing');
      toggle.hidden = true;
    }

    function onToggle() {
      if (video.paused) {
        playVideo();
      } else {
        video.pause();
      }
    }

    function applyMotionPreference() {
      toggle.hidden = reducedMotion.matches;

      if (reducedMotion.matches) {
        video.pause();
        root.classList.remove('is-playing');
      } else {
        playVideo();
      }
    }

    function cleanup(event) {
      if (event.detail.sectionId !== sectionId) return;

      disposed = true;
      video.pause();

      toggle.removeEventListener('click', onToggle);
      video.removeEventListener('playing', onPlaying);
      video.removeEventListener('pause', updateButton);
      video.removeEventListener('error', onError);
      reducedMotion.removeEventListener('change', applyMotionPreference);
      document.removeEventListener('shopify:section:unload', cleanup);
    }

    toggle.addEventListener('click', onToggle);
    video.addEventListener('playing', onPlaying);
    video.addEventListener('pause', updateButton);
    video.addEventListener('error', onError);
    reducedMotion.addEventListener('change', applyMotionPreference);
    document.addEventListener('shopify:section:unload', cleanup);

    applyMotionPreference();
  })();
</script>

{% schema %}
{
  "name": "LS — Atelier hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Alterations & Tailoring in Simi Valley"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Expert alterations for wedding dresses, formalwear, and everyday clothing. Book your fitting at LA STORY.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Book a fitting"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Select a Shopify-hosted video. Plays muted and loops automatically when permitted."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background / fallback image",
      "info": "Shown when no video is selected, while video loads, or when reduced motion is enabled. If empty, the video's preview image is used."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark overlay",
      "info": "Adjust for readable white text over your image or video.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    }
  ],
  "presets": [
    {
      "name": "LS — Atelier hero"
    }
  ]
}
{% endschema %}