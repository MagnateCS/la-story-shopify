{% comment %}LA STORY — self-contained content section. Uses the theme’s installed Century Gothic font.{% endcomment %}
<style>
#LS-{{ section.id }} {
  padding: 0;
}

#LS-{{ section.id }} .ls-wrap {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;
}

#LS-{{ section.id }} .ls-split {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 0;
  align-items: stretch;
  min-height: clamp(560px, 75svh, 900px);
}

#LS-{{ section.id }} .ls-split > div:first-child {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  padding: max(48px, {{ section.settings.spacing }}px)
    clamp(32px, 5vw, 96px);
}

#LS-{{ section.id }} .ls-media {
  position: relative;
  min-width: 0;
  min-height: 100%;
  aspect-ratio: auto;
  background: #e8e2da;
  overflow: hidden;
}

#LS-{{ section.id }} .ls-media img,
#LS-{{ section.id }} .ls-media svg {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media (max-width: 749px) {
  #LS-{{ section.id }} {
    padding: 0;
  }

  #LS-{{ section.id }} .ls-split {
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
    gap: 0;
  }

  #LS-{{ section.id }} .ls-split > div:first-child {
    padding: max(40px, calc({{ section.settings.spacing }}px * .65))
      24px;
  }

  #LS-{{ section.id }} h1 {
    font-size: clamp(32px, 8.5vw, 44px);
    line-height: 1.15;
    overflow-wrap: break-word;
  }

  #LS-{{ section.id }} .ls-eyebrow {
    margin-bottom: 18px;
  }

  #LS-{{ section.id }} .ls-body {
    margin-top: 20px;
  }

  #LS-{{ section.id }} .ls-button {
    width: 100%;
    max-width: 100%;
    margin-top: 28px;
  }

  #LS-{{ section.id }} .ls-media {
    min-height: 0;
    aspect-ratio: 4 / 5;
    max-height: 640px;
  }
}
#LS-{{ section.id }},
#LS-{{ section.id }} * {
  font-family: "Century Gothic", Arial, sans-serif !important;
}
</style>
<div id="LS-{{ section.id }}"><div class="ls-wrap"><div class="ls-split"><div><p class="ls-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><div class="ls-body">{{ section.settings.body }}</div>{% if section.settings.link != blank and section.settings.label != blank %}<a class="ls-button" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% elsif request.design_mode %}<p class="ls-body">Choose a button link in this section’s settings.</p>{% endif %}</div><div class="ls-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '360, 540, 750, 1100, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager', style: 'object-position: var(--image-position, center);' }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div></div></div></div>
{% schema %}
{
  "name": "LS \u2014 Atelier hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE LA STORY ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Alterations & Tailoring in Simi Valley"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Considered details. Exceptional fit. Personal alterations for the pieces you love and the moments that matter.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Book a fitting"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f8f2ea"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text",
      "default": "#161616"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LS \u2014 Atelier hero"
    }
  ]
}
{% endschema %}
