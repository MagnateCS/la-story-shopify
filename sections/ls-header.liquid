{% render 'ls-assets' %}

<div
  class="ls-root"
  data-ls-section="{{ section.id }}"
  style="
    --ls-header-scroll-bg: {{ section.settings.scroll_background }};
    --ls-header-transparent-text: {{ section.settings.transparent_text }};
    --ls-header-scroll-text: {{ section.settings.scroll_text }};
  "
>
  <div class="ls-scroll-marker" data-ls-scroll-marker></div>

  {% if section.settings.announcement != blank %}
    <div class="ls-announcement">
      {{ section.settings.announcement | escape }}
    </div>
  {% endif %}

  <header
    class="ls-header{% if section.settings.overlay %} ls-header-overlay{% endif %}"
    data-ls-header
  >
    <div class="ls-wrap ls-header-row">
      <a class="ls-logo" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag:
              width: section.settings.logo_width,
              alt: section.settings.brand
          }}
        {% else %}
          {{ section.settings.brand | escape }}
        {% endif %}
      </a>

      <nav
        aria-label="Bridal navigation"
        class="ls-nav"
        id="ls-nav-{{ section.id }}"
      >
        {% for block in section.blocks %}
          <a
            href="{{ block.settings.url | default: '#ls-gowns' }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title | escape }}
          </a>
        {% endfor %}

        {% render
          'ls-book-button',
          label: section.settings.button_label,
          class: 'ls-button-outline'
        %}
      </nav>

      <button
        type="button"
        class="ls-menu"
        data-ls-menu
        aria-expanded="false"
        aria-controls="ls-nav-{{ section.id }}"
        aria-label="Toggle navigation"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </header>
</div>

<style>
  [data-ls-section="{{ section.id }}"] .ls-header,
  [data-ls-section="{{ section.id }}"] .ls-header.ls-header-overlay {
    position: fixed;
    top: var(--ls-header-top, 0px);
    right: 0;
    left: 0;
    z-index: 9999;
    width: 100%;

    color: var(--ls-header-transparent-text);
    background-color: transparent;
    border-bottom: 1px solid transparent;

    transition:
      background-color 350ms ease,
      color 350ms ease,
      border-color 350ms ease,
      box-shadow 350ms ease,
      backdrop-filter 350ms ease;
  }

  [data-ls-section="{{ section.id }}"] .ls-header a,
  [data-ls-section="{{ section.id }}"] .ls-header .ls-menu {
    color: inherit;
    transition:
      color 350ms ease,
      border-color 350ms ease,
      background-color 350ms ease;
  }

  [data-ls-section="{{ section.id }}"] .ls-header .ls-button-outline {
    color: inherit;
    border-color: currentColor;
  }

  [data-ls-section="{{ section.id }}"] .ls-header.is-scrolled {
    color: var(--ls-header-scroll-text);
    background-color: var(--ls-header-scroll-bg);
    border-bottom-color: rgba(36, 26, 23, 0.12);
    box-shadow: 0 8px 28px rgba(36, 26, 23, 0.08);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  [data-ls-section="{{ section.id }}"] .ls-header.is-scrolled .ls-button-outline {
    color: var(--ls-header-scroll-text);
    border-color: var(--ls-header-scroll-text);
  }

  [data-ls-section="{{ section.id }}"] .ls-header.is-scrolled .ls-button-outline:hover {
    color: var(--ls-header-scroll-bg);
    background-color: var(--ls-header-scroll-text);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ls-section="{{ section.id }}"] .ls-header,
    [data-ls-section="{{ section.id }}"] .ls-header a,
    [data-ls-section="{{ section.id }}"] .ls-header .ls-menu {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector(
      '[data-ls-section="{{ section.id }}"]'
    );

    if (!section || section.dataset.stickyHeaderReady === 'true') return;

    section.dataset.stickyHeaderReady = 'true';

    const header = section.querySelector('[data-ls-header]');
    const announcement = section.querySelector('.ls-announcement');

    if (!header) return;

    let ticking = false;

    const updateHeader = () => {
      /*
       * The announcement scrolls away normally.
       * The fixed header moves upward until it reaches the top.
       */
      const announcementBottom = announcement
        ? announcement.getBoundingClientRect().bottom
        : 0;

      header.style.setProperty(
        '--ls-header-top',
        `${Math.max(0, announcementBottom)}px`
      );

      header.classList.toggle('is-scrolled', window.scrollY > 24);

      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;

      ticking = true;
      window.requestAnimationFrame(updateHeader);
    };

    updateHeader();

    window.addEventListener('scroll', requestUpdate, {
      passive: true
    });

    window.addEventListener('resize', requestUpdate, {
      passive: true
    });

    document.addEventListener('shopify:section:load', requestUpdate);
  })();
</script>

{% schema %}
{
  "name": "LA STORY · Header",
  "tag": "section",
  "class": "ls-shopify-section",
  "limit": 1,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "LA STORY"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Bridal boutique · Simi Valley, California"
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Use transparent header over hero",
      "default": true
    },
    {
      "type": "color",
      "id": "transparent_text",
      "label": "Transparent header text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "scroll_background",
      "label": "Scrolled header background",
      "default": "#F8EFE6"
    },
    {
      "type": "color",
      "id": "scroll_text",
      "label": "Scrolled header text",
      "default": "#241A17"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Booking button",
      "default": "Book a bridal appointment"
    }
  ],
  "presets": [
    {
      "name": "LA STORY · Header",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "title": "Wedding dresses",
            "url": "#ls-gowns"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Our boutique",
            "url": "#ls-experience"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Wedding dresses"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 18
}
{% endschema %}