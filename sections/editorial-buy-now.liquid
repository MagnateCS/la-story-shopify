{% liquid
  assign editorial_product = section.settings.product
  assign gallery_limit = section.settings.gallery_limit
  assign gallery_count = editorial_product.images.size | at_most: gallery_limit
  assign section_label = editorial_product.title | default: 'Editorial product feature'
%}

<section
  id="EditorialBuyNow-{{ section.id }}"
  class="
    editorial-buy-now
    editorial-buy-now--{{ section.settings.media_split }}
  "
  style="
    --editorial-bg: {{ section.settings.background_color }};
    --editorial-text: {{ section.settings.text_color }};
    --editorial-link: {{ section.settings.link_color }};
    --editorial-hover: {{ section.settings.hover_color }};
    --editorial-border: {{ section.settings.border_color }};
    --editorial-min-height: {{ section.settings.section_height }}svh;
  "
  aria-label="{{ section_label | escape }}"
  data-editorial-section
>

  {%- comment -%}
    ============================================================
    VIDEO / CAMPAIGN SIDE
    ============================================================
  {%- endcomment -%}

  <div class="editorial-buy-now__video-panel">

    {% if section.settings.video != blank %}

      {{
        section.settings.video
        | video_tag:
          autoplay: section.settings.autoplay,
          loop: section.settings.loop,
          muted: section.settings.autoplay,
          controls: section.settings.show_controls,
          playsinline: true,
          preload: 'metadata',
          class: 'editorial-buy-now__video'
      }}

    {% elsif section.settings.poster_image != blank %}

      {{
        section.settings.poster_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          class: 'editorial-buy-now__video-poster'
      }}

    {% else %}

      {{
        'lifestyle-1'
        | placeholder_svg_tag:
          'editorial-buy-now__placeholder'
      }}

    {% endif %}

    <div class="editorial-buy-now__video-shade"></div>

    {% if section.settings.kicker != blank
      or section.settings.video_caption != blank
    %}

      <div class="editorial-buy-now__video-copy">

        {% if section.settings.kicker != blank %}
          <p class="editorial-buy-now__kicker">
            {{ section.settings.kicker | escape }}
          </p>
        {% endif %}

        {% if section.settings.video_caption != blank %}
          <p class="editorial-buy-now__caption">
            {{ section.settings.video_caption | escape }}
          </p>
        {% endif %}

      </div>

    {% endif %}

  </div>


  {%- comment -%}
    ============================================================
    PRODUCT IMAGE SIDE
    ============================================================
  {%- endcomment -%}

  <div class="editorial-buy-now__product-panel">

    {% if editorial_product != blank %}

      <div
        class="
          editorial-buy-now__gallery
          editorial-buy-now__gallery--{{ gallery_count }}
        "
        aria-label="{{ editorial_product.title | escape }} image gallery"
      >

        {% for image in editorial_product.images limit: gallery_limit %}

          <a
            class="editorial-buy-now__image-cell"
            href="{{ editorial_product.url }}"
            aria-label="View {{ editorial_product.title | escape }}"
          >

            {{
              image
              | image_url: width: 1800
              | image_tag:
                widths: '420, 640, 900, 1200, 1500, 1800',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                class: 'editorial-buy-now__product-image'
            }}

          </a>

        {% else %}

          {% for index in (1..4) %}

            <div class="editorial-buy-now__image-cell">

              {{
                'product-'
                | append: index
                | placeholder_svg_tag:
                  'editorial-buy-now__placeholder'
              }}

            </div>

          {% endfor %}

        {% endfor %}

      </div>


      {%- comment -%}
        ========================================================
        DELAYED PRODUCT CTA

        This is hidden initially.

        JavaScript adds .is-cta-visible to the section once
        the visitor has scrolled far enough into the section.
        ========================================================
      {%- endcomment -%}

      <div
        class="editorial-buy-now__cta-wrap"
        data-editorial-cta
      >

        <a
          class="editorial-buy-now__see-more"
          href="{{ editorial_product.url }}"
          aria-label="{{ section.settings.cta_label | escape }} — {{ editorial_product.title | escape }}"
        >

          <span class="editorial-buy-now__see-more-label">
            {{ section.settings.cta_label | escape }}
          </span>

          <span
            class="editorial-buy-now__see-more-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>

      </div>

    {% else %}

      <div class="editorial-buy-now__empty-state">

        <div class="editorial-buy-now__empty-image">

          {{
            'product-1'
            | placeholder_svg_tag:
              'editorial-buy-now__placeholder'
          }}

        </div>

        <div class="editorial-buy-now__empty-copy">

          <p class="editorial-buy-now__kicker">
            Theme editor
          </p>

          <h2>
            Choose a product
          </h2>

          <p>
            Select a product in this section's settings
            to build its editorial feature.
          </p>

        </div>

      </div>

    {% endif %}

  </div>

</section>


<style>

  /*
   * ==========================================================
   * SECTION
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }} {
    background: var(--editorial-bg);
    color: var(--editorial-text);

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    align-items: start;

    isolation: isolate;

    min-height: var(--editorial-min-height);

    overflow: visible;
    position: relative;
  }


  #EditorialBuyNow-{{ section.id }} *,
  #EditorialBuyNow-{{ section.id }} *::before,
  #EditorialBuyNow-{{ section.id }} *::after {
    box-sizing: border-box;
  }


  /*
   * ==========================================================
   * DESKTOP SPLIT OPTIONS
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--video-wide {
    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(0, .8fr);
  }


  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--product-wide {
    grid-template-columns:
      minmax(0, .8fr)
      minmax(0, 1.2fr);
  }


  /*
   * ==========================================================
   * VIDEO PANEL
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__video-panel {

    background: #161616;

    grid-column: 1;
    grid-row: 1;

    height: var(--editorial-min-height);
    min-height: var(--editorial-min-height);

    overflow: hidden;

    position: sticky;
    top: 0;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__video,

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__video-poster,

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__video-panel
  > .editorial-buy-now__placeholder {

    display: block;

    height: 100%;

    inset: 0;

    object-fit: cover;

    position: absolute;

    width: 100%;
  }


  /*
   * Subtle overlay to keep the editorial text readable.
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__video-shade {

    background:
      linear-gradient(
        180deg,
        transparent 50%,
        rgba(0, 0, 0, .52)
      );

    inset: 0;

    pointer-events: none;

    position: absolute;
  }


  /*
   * ==========================================================
   * VIDEO COPY
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__video-copy {

    bottom: clamp(22px, 4vw, 56px);

    color: #fff;

    display: flex;

    gap: 24px;

    justify-content: space-between;

    left: clamp(18px, 3vw, 48px);

    position: absolute;

    right: clamp(18px, 3vw, 48px);

    z-index: 2;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__kicker,

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__caption {

    font-size: 11px;

    letter-spacing: .14em;

    line-height: 1.2;

    margin: 0;

    text-transform: uppercase;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__caption {

    letter-spacing: .04em;

    max-width: 32ch;

    text-align: right;

    text-transform: none;
  }


  /*
   * ==========================================================
   * PRODUCT PANEL
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__product-panel {

    background: var(--editorial-bg);

    grid-column: 2;
    grid-row: 1;

    min-height: var(--editorial-min-height);

    min-width: 0;

    position: relative;
  }


  /*
   * ==========================================================
   * PRODUCT GALLERY
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__gallery {

    align-items: start;

    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    min-height: var(--editorial-min-height);

    width: 100%;
  }


  /*
   * One-image layouts get the full product side.
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__gallery--1 {

    grid-template-columns: 1fr;
  }


  /*
   * Two-image layouts create a longer vertical editorial story.
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__gallery--2 {

    grid-template-columns: 1fr;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__image-cell {

    align-self: start;

    background:
      color-mix(
        in srgb,
        var(--editorial-bg) 90%,
        var(--editorial-text)
      );

    border-bottom:
      1px solid var(--editorial-border);

    border-left:
      1px solid var(--editorial-border);

    color: inherit;

    display: block;

    min-height: 0;

    overflow: hidden;

    position: relative;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__product-image,

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__image-cell
  > .editorial-buy-now__placeholder {

    display: block;

    height: auto;

    transition:
      transform
      800ms
      cubic-bezier(.22, .61, .36, 1);

    width: 100%;
  }


  /*
   * Very subtle editorial image zoom.
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__image-cell:hover
  .editorial-buy-now__product-image {

    transform: scale(1.025);
  }


  /*
   * ==========================================================
   * FLOATING PRODUCT CTA
   * ==========================================================
   *
   * Fixed positioning is intentional.
   *
   * The button remains easy to reach while the visitor
   * scrolls through the product imagery, but JavaScript
   * makes sure it ONLY exists visually while this section
   * is actively being viewed.
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__cta-wrap {

    bottom: clamp(22px, 2.5vw, 38px);

    opacity: 0;

    pointer-events: none;

    position: fixed;

    right: clamp(22px, 2.5vw, 38px);

    transform:
      translateY(16px);

    transition:
      opacity
        450ms
        cubic-bezier(.22, .61, .36, 1),
      transform
        450ms
        cubic-bezier(.22, .61, .36, 1),
      visibility
        450ms
        linear;

    visibility: hidden;

    z-index: 20;
  }


  /*
   * JavaScript adds this class when the visitor has
   * scrolled far enough into the section.
   */

  #EditorialBuyNow-{{ section.id }}.is-cta-visible
  .editorial-buy-now__cta-wrap {

    opacity: 1;

    pointer-events: auto;

    transform:
      translateY(0);

    visibility: visible;
  }


  /*
   * ==========================================================
   * CTA BUTTON
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__see-more {

    -webkit-backdrop-filter:
      blur(14px);

    backdrop-filter:
      blur(14px);

    align-items: center;

    background:
      color-mix(
        in srgb,
        var(--editorial-bg) 92%,
        transparent
      );

    border:
      1px solid var(--editorial-border);

    color:
      var(--editorial-link);

    display:
      inline-flex;

    font: inherit;

    font-size: 11px;

    font-weight: 400;

    gap: 30px;

    justify-content:
      space-between;

    letter-spacing:
      .14em;

    min-height:
      54px;

    min-width:
      180px;

    padding:
      0 20px 0 22px;

    text-decoration:
      none;

    text-transform:
      uppercase;

    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      color 250ms ease,
      transform 250ms ease,
      box-shadow 250ms ease;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__see-more:hover {

    background:
      var(--editorial-link);

    border-color:
      var(--editorial-link);

    box-shadow:
      0 12px 34px
      rgba(0, 0, 0, .12);

    color:
      #fff;

    transform:
      translateY(-2px);
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__see-more-arrow {

    display:
      inline-block;

    font-size:
      16px;

    line-height:
      1;

    transition:
      transform 250ms ease;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__see-more:hover
  .editorial-buy-now__see-more-arrow {

    transform:
      translateX(5px);
  }


  /*
   * Keyboard accessibility
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__see-more:focus-visible {

    outline:
      2px solid var(--editorial-link);

    outline-offset:
      4px;
  }


  /*
   * ==========================================================
   * EMPTY STATE
   * ==========================================================
   */

  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__empty-state {

    align-items:
      center;

    display:
      grid;

    gap:
      28px;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(180px, .8fr);

    min-height:
      var(--editorial-min-height);

    padding:
      clamp(24px, 5vw, 80px);
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__empty-image
  .editorial-buy-now__placeholder {

    background:
      rgba(127, 127, 127, .1);

    display:
      block;

    width:
      100%;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__empty-copy h2 {

    color:
      var(--editorial-link);

    font-size:
      clamp(26px, 3vw, 44px);

    font-weight:
      400;

    line-height:
      1;

    margin:
      10px 0 14px;
  }


  #EditorialBuyNow-{{ section.id }}
  .editorial-buy-now__empty-copy p:last-child {

    line-height:
      1.6;

    margin:
      0;

    max-width:
      40ch;
  }


  /*
   * ==========================================================
   * TABLET / MOBILE
   * ==========================================================
   */

  @media screen and (max-width: 989px) {

    #EditorialBuyNow-{{ section.id }},
    #EditorialBuyNow-{{ section.id }}.editorial-buy-now--video-wide,
    #EditorialBuyNow-{{ section.id }}.editorial-buy-now--product-wide {

      display:
        block;

      min-height:
        auto;

      overflow:
        visible;
    }


    /*
     * On mobile we do not keep the video sticky.
     */

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__video-panel {

      height:
        auto;

      min-height:
        min(78svh, 760px);

      position:
        relative;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__product-panel {

      min-height:
        auto;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__gallery {

      min-height:
        auto;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__empty-state {

      min-height:
        auto;
    }

  }


  /*
   * ==========================================================
   * MOBILE
   * ==========================================================
   */

  @media screen and (max-width: 599px) {

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__video-panel {

      min-height:
        72svh;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__video-copy {

      display:
        block;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__caption {

      margin-top:
        10px;

      text-align:
        left;
    }


    /*
     * Keep 3-4 image galleries compact on mobile.
     */

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__gallery {

      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }


    /*
     * One and two-image layouts remain larger.
     */

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__gallery--1,

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__gallery--2 {

      grid-template-columns:
        1fr;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__cta-wrap {

      bottom:
        16px;

      left:
        16px;

      right:
        16px;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__see-more {

      min-height:
        50px;

      min-width:
        0;

      width:
        100%;
    }


    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__empty-state {

      grid-template-columns:
        1fr;

      padding:
        40px 20px;
    }

  }


  /*
   * ==========================================================
   * REDUCED MOTION
   * ==========================================================
   */

  @media (prefers-reduced-motion: reduce) {

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__product-image,

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__cta-wrap,

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__see-more,

    #EditorialBuyNow-{{ section.id }}
    .editorial-buy-now__see-more-arrow {

      transition:
        none;
    }

  }

</style>


<script>
  (() => {

    /*
     * ========================================================
     * EDITORIAL CTA REVEAL
     * ========================================================
     *
     * The CTA stays hidden when the section first enters
     * the viewport.
     *
     * It becomes visible once the visitor has actually
     * scrolled INTO the section.
     */

    const section =
      document.getElementById(
        'EditorialBuyNow-{{ section.id }}'
      );

    if (!section) return;


    /*
     * Prevent duplicate initialization.
     */

    if (
      section.dataset.editorialCtaInitialized
      === 'true'
    ) {
      return;
    }


    section.dataset.editorialCtaInitialized =
      'true';


    const cta =
      section.querySelector(
        '[data-editorial-cta]'
      );


    if (!cta) return;


    /*
     * Merchant-controlled reveal amount.
     *
     * Example:
     *
     * 20 = user scrolls roughly 20% of one viewport
     *      after reaching the beginning of this section.
     */

    const revealPercent =
      Number(
        {{ section.settings.cta_reveal_percent | json }}
      ) || 20;


    let ticking =
      false;


    const updateCTA = () => {

      const rect =
        section.getBoundingClientRect();


      const viewportHeight =
        window.innerHeight
        || document.documentElement.clientHeight;


      /*
       * Convert the merchant's percentage setting
       * into actual pixels.
       */

      const revealDistance =
        viewportHeight
        * (revealPercent / 100);


      /*
       * Negative rect.top means the visitor has
       * scrolled beyond the top of the section.
       */

      const distanceIntoSection =
        Math.max(
          0,
          -rect.top
        );


      /*
       * Is any meaningful part of this section
       * currently inside the viewport?
       */

      const sectionIsVisible =
        rect.bottom > 0
        && rect.top < viewportHeight;


      /*
       * Hide the CTA again just before completely
       * leaving the section.
       */

      const sectionHasRoomRemaining =
        rect.bottom >
        Math.min(
          100,
          viewportHeight * .10
        );


      /*
       * Final visibility condition.
       */

      const shouldShow =
        sectionIsVisible
        && sectionHasRoomRemaining
        && distanceIntoSection >= revealDistance;


      section.classList.toggle(
        'is-cta-visible',
        shouldShow
      );


      ticking =
        false;
    };


    /*
     * requestAnimationFrame prevents the scroll handler
     * from running excessive layout calculations.
     */

    const handleScroll = () => {

      if (ticking) return;


      ticking =
        true;


      window.requestAnimationFrame(
        updateCTA
      );

    };


    window.addEventListener(
      'scroll',
      handleScroll,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      handleScroll
    );


    /*
     * Check immediately in case the page was refreshed
     * while already scrolled down.
     */

    updateCTA();

  })();
</script>


{% schema %}
{
  "name": "Editorial product",
  "tag": "section",
  "class": "section-editorial-product",

  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },

  "settings": [

    {
      "type": "header",
      "content": "Product"
    },

    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },

    {
      "type": "text",
      "id": "cta_label",
      "label": "Product button label",
      "default": "View the dress"
    },

    {
      "type": "range",
      "id": "cta_reveal_percent",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Button reveal delay",
      "default": 20,
      "info": "How far the visitor should scroll into the section before the product button appears."
    },


    {
      "type": "header",
      "content": "Video"
    },

    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },

    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Fallback image",
      "info": "Shown when no video is selected."
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true,
      "info": "Autoplay videos are muted by browser policy."
    },

    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": false
    },

    {
      "type": "text",
      "id": "kicker",
      "label": "Video eyebrow",
      "default": "The campaign"
    },

    {
      "type": "text",
      "id": "video_caption",
      "label": "Video caption",
      "default": "A closer look at the story behind the piece."
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "media_split",
      "label": "Desktop split",
      "default": "equal",
      "options": [

        {
          "value": "video-wide",
          "label": "60% video / 40% product"
        },

        {
          "value": "equal",
          "label": "50% video / 50% product"
        },

        {
          "value": "product-wide",
