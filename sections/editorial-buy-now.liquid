{% liquid
  assign editorial_product = section.settings.product
  assign current_variant = editorial_product.selected_or_first_available_variant
  assign gallery_limit = section.settings.gallery_limit
  assign gallery_count = editorial_product.images.size | at_most: gallery_limit
  assign section_label = editorial_product.title | default: 'Editorial product feature'
%}

<section
  id="EditorialBuyNow-{{ section.id }}"
  class="editorial-buy-now editorial-buy-now--{{ section.settings.media_split }} editorial-buy-now--card-{{ section.settings.buy_box_side }} editorial-buy-now--card-{{ section.settings.buy_box_size }}"
  style="
    --editorial-bg: {{ section.settings.background_color }};
    --editorial-heading: {{ section.settings.heading_color }};
    --editorial-text: {{ section.settings.text_color }};
    --editorial-link: {{ section.settings.link_color }};
    --editorial-hover: {{ section.settings.hover_color }};
    --editorial-border: {{ section.settings.border_color }};
    --editorial-shadow: {{ section.settings.shadow_color }};
    --editorial-accent: {{ section.settings.link_color }};
    --editorial-min-height: {{ section.settings.section_height }}svh;
  "
  aria-label="{{ section_label | escape }}"
  data-editorial-buy-now
>
  <div class="editorial-buy-now__video-panel">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: section.settings.autoplay,
          loop: section.settings.loop,
          muted: section.settings.autoplay,
          controls: section.settings.show_controls,
          playsinline: true,
          preload: 'metadata',
          class: 'editorial-buy-now__video'
      }}
    {% elsif section.settings.poster_image != blank %}
      {{
        section.settings.poster_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy',
          class: 'editorial-buy-now__video-poster'
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-buy-now__placeholder' }}
    {% endif %}

    <div class="editorial-buy-now__video-shade"></div>

    {% if section.settings.kicker != blank or section.settings.video_caption != blank %}
      <div class="editorial-buy-now__video-copy">
        {% if section.settings.kicker != blank %}
          <p class="editorial-buy-now__kicker">{{ section.settings.kicker | escape }}</p>
        {% endif %}
        {% if section.settings.video_caption != blank %}
          <p class="editorial-buy-now__caption">{{ section.settings.video_caption | escape }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="editorial-buy-now__product-panel">
    {% if editorial_product != blank %}
      <div
        class="editorial-buy-now__gallery editorial-buy-now__gallery--{{ gallery_count }}"
        aria-label="{{ editorial_product.title | escape }} image gallery"
      >
        {% for image in editorial_product.images limit: gallery_limit %}
          <a
            class="editorial-buy-now__image-cell"
            href="{{ editorial_product.url }}"
            aria-label="View {{ editorial_product.title | escape }}"
          >
            {{
              image
              | image_url: width: 1800
              | image_tag:
                widths: '420, 640, 900, 1200, 1500, 1800',
                sizes: '(min-width: 750px) 25vw, 50vw',
                loading: 'lazy',
                class: 'editorial-buy-now__product-image'
            }}
            {% if section.settings.show_image_numbers %}
              <span class="editorial-buy-now__image-number">
                {{ forloop.index | prepend: '0' }} / {{ gallery_count | prepend: '0' }}
              </span>
            {% endif %}
          </a>
        {% else %}
          {% for index in (1..4) %}
            <div class="editorial-buy-now__image-cell">
              {{ 'product-' | append: index | placeholder_svg_tag: 'editorial-buy-now__placeholder' }}
            </div>
          {% endfor %}
        {% endfor %}
      </div>

      <div class="editorial-buy-now__product-card">
        <div class="editorial-buy-now__product-heading">
          <div>
            {% if section.settings.product_label != blank %}
              <p class="editorial-buy-now__product-label">{{ section.settings.product_label | escape }}</p>
            {% endif %}
            <h2 class="editorial-buy-now__title">
              <a href="{{ editorial_product.url }}">{{ editorial_product.title | escape }}</a>
            </h2>
          </div>

          <div class="editorial-buy-now__prices" aria-live="polite">
            <span class="editorial-buy-now__compare-price" data-compare-price>
              {% if current_variant.compare_at_price > current_variant.price %}
                {{ current_variant.compare_at_price | money }}
              {% endif %}
            </span>
            <span class="editorial-buy-now__price" data-price>
              {{ current_variant.price | money }}
            </span>
          </div>
        </div>

        {% if section.settings.show_description and editorial_product.description != blank %}
          <div class="editorial-buy-now__description">
            {{ editorial_product.description | strip_html | truncatewords: 24 }}
          </div>
        {% endif %}

        {% form 'product', editorial_product, class: 'editorial-buy-now__form', data-product-form: '' %}
          {% unless editorial_product.has_only_default_variant %}
            <div class="editorial-buy-now__field">
              <label for="EditorialVariant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label>
              <div class="editorial-buy-now__select-wrap">
                <select
                  id="EditorialVariant-{{ section.id }}"
                  name="id"
                  data-variant-select
                >
                  {% for variant in editorial_product.variants %}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money | escape }}"
                      data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                      data-available="{{ variant.available }}"
                      {% if variant == current_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title | escape }}{% unless variant.available %} — {{ section.settings.sold_out_label | escape }}{% endunless %}
                    </option>
                  {% endfor %}
                </select>
                <span aria-hidden="true">↓</span>
              </div>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endunless %}

          <input type="hidden" name="quantity" value="1">

          <button
            class="editorial-buy-now__add-button"
            type="submit"
            name="add"
            data-add-button
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-add-label>
              {% if current_variant.available %}
                {{ section.settings.button_label | escape }}
              {% else %}
                {{ section.settings.sold_out_label | escape }}
              {% endif %}
            </span>
          </button>

          {% if section.settings.show_dynamic_checkout and current_variant.available %}
            <div class="editorial-buy-now__dynamic-checkout">
              {{ form | payment_button }}
            </div>
          {% endif %}
        {% endform %}

        {% if section.settings.show_product_link %}
          <a class="editorial-buy-now__details-link" href="{{ editorial_product.url }}">
            {{ section.settings.product_link_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>
    {% else %}
      <div class="editorial-buy-now__empty-state">
        {{ 'product-1' | placeholder_svg_tag: 'editorial-buy-now__placeholder' }}
        <div>
          <p class="editorial-buy-now__product-label">Theme editor</p>
          <h2 class="editorial-buy-now__title">Choose a product</h2>
          <p>Select a product in this section’s settings to build its editorial collage.</p>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #EditorialBuyNow-{{ section.id }} {
    background: var(--editorial-bg);
    color: var(--editorial-text);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    isolation: isolate;
    min-height: var(--editorial-min-height);
    overflow: visible;
    position: relative;
  }

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--video-wide {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
  }

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--product-wide {
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  }

  #EditorialBuyNow-{{ section.id }} *,
  #EditorialBuyNow-{{ section.id }} *::before,
  #EditorialBuyNow-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-panel,
  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-panel {
    min-height: var(--editorial-min-height);
    min-width: 0;
    position: relative;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-panel {
    background: #161616;
    height: var(--editorial-min-height);
    overflow: hidden;
    position: sticky;
    top: 0;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video,
  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-poster,
  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-panel > .editorial-buy-now__placeholder {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-shade {
    background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, .5));
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-copy {
    bottom: clamp(22px, 4vw, 56px);
    color: #fff;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    left: clamp(18px, 3vw, 48px);
    position: absolute;
    right: clamp(18px, 3vw, 48px);
    z-index: 1;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__kicker,
  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__caption,
  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-label {
    font-size: 11px;
    letter-spacing: .14em;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__caption {
    letter-spacing: .04em;
    max-width: 32ch;
    text-align: right;
    text-transform: none;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-panel {
    background: var(--editorial-bg);
    display: grid;
    align-items: start;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__gallery {
    align-items: start;
    display: grid;
    grid-area: 1 / 1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: auto;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__gallery--1 {
    grid-template-columns: 1fr;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__gallery--2 {
    grid-template-columns: 1fr;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__image-cell {
    align-self: start;
    background: color-mix(in srgb, var(--editorial-bg) 90%, var(--editorial-text));
    border-bottom: 1px solid var(--editorial-border);
    border-left: 1px solid var(--editorial-border);
    color: inherit;
    display: block;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-image,
  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__image-cell > .editorial-buy-now__placeholder {
    display: block;
    height: auto;
    transition: transform 800ms cubic-bezier(.22, .61, .36, 1);
    width: 100%;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__image-cell:hover .editorial-buy-now__product-image {
    transform: scale(1.025);
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__image-number {
    background: color-mix(in srgb, var(--editorial-link) 76%, transparent);
    bottom: 12px;
    color: #fff;
    font-size: 10px;
    left: 12px;
    letter-spacing: .1em;
    padding: 5px 7px;
    position: absolute;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-card {
    align-self: start;
    background: transparent;
    border: 0;
    box-shadow: none;
    grid-area: 1 / 1;
    margin: clamp(14px, 1.5vw, 24px);
    max-width: calc(100% - clamp(28px, 3vw, 48px));
    padding: 0;
    position: sticky;
    top: clamp(14px, 1.5vw, 24px);
    z-index: 3;
  }

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--card-left .editorial-buy-now__product-card {
    justify-self: start;
  }

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--card-right .editorial-buy-now__product-card {
    justify-self: end;
  }

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--card-compact .editorial-buy-now__product-card {
    width: min(330px, calc(100% - 28px));
  }

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--card-medium .editorial-buy-now__product-card {
    width: min(460px, calc(100% - 28px));
  }

  #EditorialBuyNow-{{ section.id }}.editorial-buy-now--card-wide .editorial-buy-now__product-card {
    width: calc(100% - clamp(28px, 3vw, 48px));
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-heading {
    align-items: flex-start;
    display: flex;
    gap: 20px;
    justify-content: space-between;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__title {
    color: var(--editorial-heading);
    font-family: inherit;
    font-size: clamp(20px, 1.55vw, 30px);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: 1;
    margin: 8px 0 0;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__title a {
    color: var(--editorial-heading);
    text-decoration: none;
    transition: color 180ms ease;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__title a:hover {
    color: var(--editorial-hover);
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__prices {
    display: flex;
    flex: 0 0 auto;
    font-size: 14px;
    gap: 8px;
    line-height: 1.2;
    white-space: nowrap;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__compare-price {
    opacity: .55;
    text-decoration: line-through;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__description {
    font-size: 13px;
    line-height: 1.45;
    margin-top: 16px;
    max-width: 58ch;
    opacity: .72;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__form {
    align-items: end;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    margin-top: 14px;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__field label {
    display: block;
    font-size: 10px;
    letter-spacing: .12em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__select-wrap {
    position: relative;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__select-wrap select {
    appearance: none;
    background: var(--editorial-bg);
    border: 1px solid var(--editorial-border);
    border-radius: 0;
    color: var(--editorial-text);
    font: inherit;
    height: 50px;
    padding: 0 42px 0 14px;
    width: 100%;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__select-wrap > span {
    pointer-events: none;
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__add-button {
    background: var(--editorial-accent);
    border: 1px solid var(--editorial-accent);
    border-radius: 0;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    height: 50px;
    letter-spacing: .12em;
    padding: 0 20px;
    text-transform: uppercase;
    transition: background-color 180ms ease, border-color 180ms ease, opacity 180ms ease;
    width: 100%;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__add-button:hover {
    background: var(--editorial-hover);
    border-color: var(--editorial-hover);
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__add-button:disabled {
    cursor: not-allowed;
    opacity: .45;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__dynamic-checkout {
    grid-column: auto;
  }

  #EditorialBuyNow-{{ section.id }} .shopify-payment-button__button {
    border-radius: 0;
    min-height: 50px;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__details-link {
    align-items: center;
    color: var(--editorial-link);
    display: flex;
    font-size: 10px;
    justify-content: space-between;
    letter-spacing: .12em;
    margin-top: 12px;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__details-link:hover {
    color: var(--editorial-hover);
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__empty-state {
    align-items: center;
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr) minmax(180px, .8fr);
    height: 100%;
    padding: clamp(24px, 5vw, 80px);
  }

  #EditorialBuyNow-{{ section.id }} .editorial-buy-now__empty-state .editorial-buy-now__placeholder {
    background: rgba(127, 127, 127, .1);
    width: 100%;
  }

  @media screen and (max-width: 989px) {
    #EditorialBuyNow-{{ section.id }},
    #EditorialBuyNow-{{ section.id }}.editorial-buy-now--video-wide,
    #EditorialBuyNow-{{ section.id }}.editorial-buy-now--product-wide {
      display: block;
      min-height: auto;
      overflow: visible;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-panel {
      height: auto;
      min-height: min(78svh, 760px);
      position: relative;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-panel {
      display: block;
      min-height: auto;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-card {
      margin: 0;
      max-width: none;
      position: relative;
      top: auto;
      width: auto;
    }
  }

  @media screen and (max-width: 599px) {
    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-panel {
      min-height: 72svh;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__video-copy {
      display: block;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__caption {
      margin-top: 10px;
      text-align: left;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-card {
      border-left: 0;
      border-right: 0;
      padding: 24px 18px 28px;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-heading {
      display: block;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__prices {
      margin-top: 12px;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__form {
      grid-template-columns: 1fr;
    }

    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__dynamic-checkout {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #EditorialBuyNow-{{ section.id }} .editorial-buy-now__product-image {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('EditorialBuyNow-{{ section.id }}');
    if (!section || section.dataset.editorialInitialized === 'true') return;
    section.dataset.editorialInitialized = 'true';

    const select = section.querySelector('[data-variant-select]');
    if (!select) return;

    const price = section.querySelector('[data-price]');
    const comparePrice = section.querySelector('[data-compare-price]');
    const button = section.querySelector('[data-add-button]');
    const buttonLabel = section.querySelector('[data-add-label]');
    const availableLabel = {{ section.settings.button_label | json }};
    const soldOutLabel = {{ section.settings.sold_out_label | json }};

    select.addEventListener('change', () => {
      const option = select.options[select.selectedIndex];
      const available = option.dataset.available === 'true';

      if (price) price.textContent = option.dataset.price || '';
      if (comparePrice) comparePrice.textContent = option.dataset.comparePrice || '';
      if (button) button.disabled = !available;
      if (buttonLabel) buttonLabel.textContent = available ? availableLabel : soldOutLabel;
    });
  })();
</script>

{% schema %}
{
  "name": "Editorial buy now",
  "tag": "section",
  "class": "section-editorial-buy-now",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Product label",
      "default": "The edit"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": false
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant selector label",
      "default": "Choose an option"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add button label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold-out button label",
      "default": "Sold out"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show accelerated checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_link",
      "label": "Show product details link",
      "default": true
    },
    {
      "type": "text",
      "id": "product_link_label",
      "label": "Product link label",
      "default": "View full product details"
    },
    {
      "type": "select",
      "id": "buy_box_side",
      "label": "Buy box side",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "buy_box_size",
      "label": "Buy box width",
      "default": "medium",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
