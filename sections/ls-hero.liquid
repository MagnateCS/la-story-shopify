{% render 'ls-assets' %}

<div
  class="ls-root"
  data-ls-section="{{ section.id }}"
  data-ls-animate="{{ section.settings.animate }}"
  style="
    --ls-bg:{{ section.settings.background }};
    --ls-text:{{ section.settings.text_color }};
    --ls-accent:{{ section.settings.accent }};
    --ls-width:{{ section.settings.content_width }}px;
    --ls-pt:{{ section.settings.padding_top }}px;
    --ls-pb:{{ section.settings.padding_bottom }}px;
  "
>
  <div
    class="ls-hero"
    style="
      --hero-height:{{ section.settings.height }}px;
      --hero-shade:{{ section.settings.overlay | divided_by: 100.0 }};
    "
  >
    <div class="ls-hero-image">
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width:749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}"
          >
        {% endif %}

        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '750,1100,1500,2000,2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {% elsif section.settings.demo_image %}
          <img
            src="{{ 'ls-demo-hero.png' | asset_url }}"
            width="1586"
            height="992"
            alt="Illustrative lace wedding gown"
            fetchpriority="high"
          >
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </picture>
    </div>

    <div class="ls-wrap">
      <div class="ls-hero-copy ls-reveal">
        <div class="ls-eyebrow">
          {{ section.settings.eyebrow | escape }}
        </div>

        <h1>
          {{ section.settings.heading | escape | newline_to_br }}
        </h1>

        <p>
          {{ section.settings.description | escape }}
        </p>

        <div class="ls-actions">
          <div
            class="ls-hero-booking-trigger"
            data-ls-global-booking-trigger
          >
            {% render 'ls-book-button',
              label: section.settings.button_label,
              class: 'ls-button-light'
            %}
          </div>

          {% if section.settings.secondary_label != blank %}
            <a
              class="ls-button ls-button-outline"
              href="{{ section.settings.secondary_url | default: '#ls-gowns' }}"
            >
              {{ section.settings.secondary_label | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .ls-hero-booking-trigger {
    display: contents;
  }
</style>

<script>
  (function () {
    var heroSection = document.getElementById(
      'shopify-section-{{ section.id }}'
    );

    if (!heroSection) {
      return;
    }

    var heroBookingTrigger = heroSection.querySelector(
      '[data-ls-global-booking-trigger]'
    );

    if (!heroBookingTrigger) {
      return;
    }

    /*
     * Use the capture phase so the embedded-modal behavior runs
     * before the standard booking-button script.
     */
    heroBookingTrigger.addEventListener(
      'click',
      function (event) {
        var embeddedModal = document.querySelector(
          '[data-ls-embed-booking-modal]'
        );

        if (!embeddedModal) {
          /*
           * No embedded modal exists, so allow ls-book-button
           * to use its normal URL/modal behavior.
           */
          return;
        }

        var bookingSection = embeddedModal.closest(
          '.ls-shopify-section'
        );

        if (!bookingSection) {
          return;
        }

        var embeddedOpenButton = bookingSection.querySelector(
          '[data-ls-embed-booking-open]'
        );

        if (!embeddedOpenButton) {
          return;
        }

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        embeddedOpenButton.click();
      },
      true
    );
  })();
</script>

{% schema %}
{
  "name": "LA STORY · Hero",
  "tag": "section",
  "class": "ls-shopify-section",
  "limit": 1,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero imagery"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "checkbox",
      "id": "demo_image",
      "label": "Use illustrative mockup image when empty",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum desktop height",
      "min": 560,
      "max": 960,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Image darkness",
      "min": 20,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wedding dresses · Simi Valley, California"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your wedding dress.\nYour next chapter."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover LA STORY, a bridal boutique specializing in wedding dresses. Visit us in Simi Valley to explore gowns, try on the silhouettes you love, and find the dress that feels like you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Booking button",
      "default": "Book a bridal appointment"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Explore wedding dresses"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#3D0D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and accent",
      "default": "#741D2B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 960,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Gentle entrance animations",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "LA STORY · Hero"
    }
  ]
}
{% endschema %}