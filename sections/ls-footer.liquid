{% render 'ls-assets' %}
<div class="ls-root" data-ls-section="{{ section.id }}" data-ls-animate="{{ section.settings.animate }}" style="--ls-bg:{{ section.settings.background }};--ls-text:{{ section.settings.text_color }};--ls-accent:{{ section.settings.accent }};--ls-width:{{ section.settings.content_width }}px;--ls-pt:{{ section.settings.padding_top }}px;--ls-pb:{{ section.settings.padding_bottom }}px">

<footer class="ls-pad"><div class="ls-wrap"><div class="ls-footer-grid"><div><div class="ls-logo">{{ section.settings.brand | escape }}</div><p>{{ section.settings.tagline | escape }}</p></div><div><div class="ls-eyebrow">Visit</div><address>{{ section.settings.address | escape | newline_to_br }}</address><p>{{ section.settings.note | escape }}</p></div><div><div class="ls-eyebrow">Explore</div><div class="ls-footer-links">{% for block in section.blocks %}<a href="{{ block.settings.url | default: '#ls-gowns' }}" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</a>{% endfor %}{% render 'ls-book-button', label: section.settings.button_label, class: 'ls-button-outline' %}</div></div></div><div class="ls-copyright">© {{ 'now' | date: '%Y' }} {{ section.settings.brand | escape }}</div></div></footer>

</div>
{% schema %}
{
  "name": "LA STORY · Footer",
  "tag": "section",
  "class": "ls-shopify-section",
  "limit": 1,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "LA STORY"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Wedding dresses. Your story, beautifully told."
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "2760 Tapo Canyon Rd #1A\nSimi Valley, CA 93063"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Visit note",
      "default": "By appointment"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Booking button",
      "default": "Book a bridal appointment"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#3D0D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons and accent",
      "default": "#741D2B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 960,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Gentle entrance animations",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "LA STORY · Footer",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "title": "Wedding dresses",
            "url": "#ls-gowns"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Our boutique",
            "url": "#ls-experience"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Footer link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Wedding dresses"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 18
}
{% endschema %}
