{% comment %}LA STORY — self-contained content section. Uses the theme’s installed Century Gothic font.{% endcomment %}
<style>

#LS-{{ section.id }}{background:{{ section.settings.background }};color:{{ section.settings.foreground }};font-family:"Century Gothic",var(--font-body-family, Arial),Arial,sans-serif;font-weight:400;padding:{{ section.settings.spacing }}px 0;}
#LS-{{ section.id }} *{box-sizing:border-box;}
#LS-{{ section.id }} .ls-wrap{width:min(1440px,100%);margin:auto;padding:0 clamp(24px,4vw,64px);}
#LS-{{ section.id }} h1,#LS-{{ section.id }} h2,#LS-{{ section.id }} h3,#LS-{{ section.id }} p{margin:0;color:inherit;font-family:inherit;font-weight:400;letter-spacing:normal;}
#LS-{{ section.id }} h1{font-size:clamp(34px,4.4vw,66px);line-height:1.12;}
#LS-{{ section.id }} h2{font-size:clamp(28px,3.3vw,46px);line-height:1.2;}
#LS-{{ section.id }} h3{font-size:20px;line-height:1.4;}
#LS-{{ section.id }} .ls-eyebrow{font-size:11px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:24px;line-height:1.6;}
#LS-{{ section.id }} .ls-body{font-size:16px;line-height:1.8;margin-top:24px;max-width:48ch;}
#LS-{{ section.id }} .ls-body p+p{margin-top:12px;}
#LS-{{ section.id }} a{color:inherit;text-decoration:none;}
#LS-{{ section.id }} a:focus-visible{outline:2px solid currentColor;outline-offset:5px;}
#LS-{{ section.id }} .ls-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;border:1px solid currentColor;padding:14px 28px;margin-top:32px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;text-align:center;transition:background .2s,color .2s;}
#LS-{{ section.id }} .ls-button:hover{background:{{ section.settings.foreground }};color:{{ section.settings.background }};}
#LS-{{ section.id }} .ls-split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,80px);align-items:center;}
#LS-{{ section.id }} .ls-media{aspect-ratio:4/5;background:#e8e2da;overflow:hidden;}
#LS-{{ section.id }} .ls-media img,#LS-{{ section.id }} .ls-media svg{width:100%;height:100%;display:block;object-fit:cover;}
#LS-{{ section.id }} .ls-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:36px;}
#LS-{{ section.id }} .ls-card .ls-media{aspect-ratio:4/3;margin-bottom:18px;}
#LS-{{ section.id }} .ls-card a:hover h3{text-decoration:underline;text-underline-offset:6px;}
#LS-{{ section.id }} .ls-steps{list-style:none;padding:28px 0;margin:0;display:grid;grid-template-columns:repeat({{ section.blocks.size | at_least: 1 }},minmax(0,1fr));border-top:1px solid currentColor;border-bottom:1px solid currentColor;gap:24px;}
#LS-{{ section.id }} .ls-step{display:flex;align-items:flex-start;gap:20px;}
#LS-{{ section.id }} .ls-number{font-size:36px;line-height:1.2;}
#LS-{{ section.id }} .ls-step h3{font-size:16px;padding-top:10px;}
#LS-{{ section.id }} .ls-center{text-align:center;}
#LS-{{ section.id }} .ls-center .ls-body{margin:24px auto 0;}
@media(max-width:749px){#LS-{{ section.id }}{padding:calc({{ section.settings.spacing }}px * .65) 0;}#LS-{{ section.id }} .ls-split,#LS-{{ section.id }} .ls-grid,#LS-{{ section.id }} .ls-steps{grid-template-columns:1fr;}#LS-{{ section.id }} .ls-grid{gap:32px;}#LS-{{ section.id }} .ls-media{aspect-ratio:4/3;}#LS-{{ section.id }} .ls-button{max-width:100%;} }
@media(prefers-reduced-motion:reduce){#LS-{{ section.id }} .ls-button{transition:none;}}

</style>
<div id="LS-{{ section.id }}"><div class="ls-wrap"><ol class="ls-steps" aria-label="The fitting process">{% for block in section.blocks %}<li class="ls-step" {{ block.shopify_attributes }}><span class="ls-number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span><div><h3>{{ block.settings.heading | escape }}</h3>{% if block.settings.description != blank %}<p class="ls-body">{{ block.settings.description | escape }}</p>{% endif %}</div></li>{% endfor %}</ol></div></div>
{% schema %}
{
  "name": "LS \u2014 Fitting process",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f8f2ea"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text",
      "default": "#161616"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LS \u2014 Fitting process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Book your fitting"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Refine the fit"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Wear with confidence"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Book your fitting"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
