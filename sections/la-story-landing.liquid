{% comment %}
  LA STORY — Booking + Services Landing Page
  File: sections/la-story-booking-services.liquid
{% endcomment %}

{% liquid
  assign booking_anchor = '#la-story-booking-' | append: section.id
  assign booking_target = booking_anchor

  if section.settings.show_booking_embed == false and section.settings.booking_url != blank
    assign booking_target = section.settings.booking_url
  endif
%}

<section
  id="la-story-landing-{{ section.id }}"
  class="la-story-landing"
  style="
    --ls-background: {{ section.settings.background }};
    --ls-heading: {{ section.settings.heading_color }};
    --ls-text: {{ section.settings.text_color }};
    --ls-primary: {{ section.settings.primary_color }};
    --ls-accent: {{ section.settings.accent_color }};
    --ls-border: {{ section.settings.border_color }};
    --ls-card: {{ section.settings.card_background }};
  "
>

  <div class="la-story-shell">

    <!-- ============================================
      HERO
    ============================================= -->
    <header class="la-story-hero">

      <div class="la-story-eyebrow">
        {{ section.settings.eyebrow }}
      </div>

      {% if section.settings.logo_text != blank %}
        <div class="la-story-logo">
          {{ section.settings.logo_text }}
        </div>
      {% endif %}

      <div class="la-story-hero__divider"></div>

      {% if section.settings.heading != blank %}
        <h1 class="la-story-hero__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="la-story-hero__text">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

      <div class="la-story-hero__actions">

        <a
          href="{{ booking_target }}"
          class="la-story-button la-story-button--primary"
          {% unless section.settings.show_booking_embed %}
            {% if section.settings.booking_url != blank %}
              target="_blank"
              rel="noopener"
            {% endif %}
          {% endunless %}
        >
          {{ section.settings.primary_button_label }}

          <span class="la-story-button__arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a
          href="#la-story-services-{{ section.id }}"
          class="la-story-button la-story-button--secondary"
        >
          View Services
        </a>

      </div>

      {% if section.settings.hero_note != blank %}
        <p class="la-story-hero__note">
          {{ section.settings.hero_note }}
        </p>
      {% endif %}

    </header>


    <!-- ============================================
      QUICK STEPS
    ============================================= -->
    <div class="la-story-steps">

      <div class="la-story-step">
        <span class="la-story-step__number">01</span>

        <div>
          <h3>Explore</h3>
          <p>Find the alteration or fitting service that best matches your needs.</p>
        </div>
      </div>

      <div class="la-story-step">
        <span class="la-story-step__number">02</span>

        <div>
          <h3>Book</h3>
          <p>Choose an appointment time that works best for your schedule.</p>
        </div>
      </div>

      <div class="la-story-step">
        <span class="la-story-step__number">03</span>

        <div>
          <h3>Visit</h3>
          <p>Bring your garment and meet with our alterations team.</p>
        </div>
      </div>

    </div>


    <!-- ============================================
      SERVICES
    ============================================= -->
    <div
      id="la-story-services-{{ section.id }}"
      class="la-story-services"
    >

      <div class="la-story-section-header">

        <div>

          {% if section.settings.services_eyebrow != blank %}
            <p class="la-story-section-eyebrow">
              {{ section.settings.services_eyebrow }}
            </p>
          {% endif %}

          <h2>
            {{ section.settings.services_heading }}
          </h2>

        </div>

        {% if section.settings.services_description != blank %}
          <div class="la-story-section-header__description">
            {{ section.settings.services_description }}
          </div>
        {% endif %}

      </div>


      {% if section.blocks.size > 0 %}

        <div class="la-story-service-grid">

          {% for block in section.blocks %}

            <article
              class="la-story-service-card {% if block.settings.featured %}la-story-service-card--featured{% endif %}"
              {{ block.shopify_attributes }}
            >

              <div class="la-story-service-card__top">

                <div>

                  {% if block.settings.label != blank %}
                    <span class="la-story-service-card__label">
                      {{ block.settings.label }}
                    </span>
                  {% endif %}

                  <h3>
                    {{ block.settings.title }}
                  </h3>

                </div>


                {% if block.settings.price != blank %}
                  <div class="la-story-service-card__price">

                    {% if block.settings.price_prefix != blank %}
                      <span>
                        {{ block.settings.price_prefix }}
                      </span>
                    {% endif %}

                    <strong>
                      {{ block.settings.price }}
                    </strong>

                  </div>
                {% endif %}

              </div>


              {% if block.settings.description != blank %}
                <div class="la-story-service-card__description">
                  {{ block.settings.description }}
                </div>
              {% endif %}


              {% if block.settings.details != blank %}
                <div class="la-story-service-card__details">
                  {{ block.settings.details }}
                </div>
              {% endif %}


              <a
                href="{{ booking_target }}"
                class="la-story-service-card__link"
                {% unless section.settings.show_booking_embed %}
                  {% if section.settings.booking_url != blank %}
                    target="_blank"
                    rel="noopener"
                  {% endif %}
                {% endunless %}
              >
                Book this service

                <span aria-hidden="true">→</span>
              </a>

            </article>

          {% endfor %}

        </div>

      {% else %}

        <div class="la-story-empty">
          Add service blocks in the Shopify Theme Editor.
        </div>

      {% endif %}

    </div>


    <!-- ============================================
      BOOKING
    ============================================= -->
    <div
      id="la-story-booking-{{ section.id }}"
      class="la-story-booking"
    >

      <div class="la-story-booking__intro">

        {% if section.settings.booking_eyebrow != blank %}
          <p class="la-story-section-eyebrow">
            {{ section.settings.booking_eyebrow }}
          </p>
        {% endif %}

        <h2>
          {{ section.settings.booking_heading }}
        </h2>

        {% if section.settings.booking_description != blank %}
          <div class="la-story-booking__description">
            {{ section.settings.booking_description }}
          </div>
        {% endif %}


        <div class="la-story-booking__reassurance">

          <div class="la-story-booking__reassurance-item">
            <span>✓</span>
            Easy online scheduling
          </div>

          <div class="la-story-booking__reassurance-item">
            <span>✓</span>
            Select your preferred time
          </div>

          <div class="la-story-booking__reassurance-item">
            <span>✓</span>
            Receive appointment confirmation
          </div>

        </div>

      </div>


      <div class="la-story-booking__calendar">

        {% if section.settings.booking_url != blank %}

          {% if section.settings.show_booking_embed %}

            <div class="la-story-calendar-frame">

              <iframe
                src="{{ section.settings.booking_url | escape }}"
                title="Book an appointment with LA Story"
                loading="lazy"
                allow="payment"
              ></iframe>

            </div>

            <div class="la-story-calendar-fallback">
              Having trouble viewing the calendar?

              <a
                href="{{ section.settings.booking_url }}"
                target="_blank"
                rel="noopener"
              >
                Open booking calendar
              </a>
            </div>

          {% else %}

            <div class="la-story-external-booking">

              <p>
                Choose a convenient appointment time through our online booking calendar.
              </p>

              <a
                href="{{ section.settings.booking_url }}"
                target="_blank"
                rel="noopener"
                class="la-story-button la-story-button--primary"
              >
                {{ section.settings.primary_button_label }}

                <span aria-hidden="true">→</span>
              </a>

            </div>

          {% endif %}

        {% else %}

          <div class="la-story-calendar-placeholder">

            <span class="la-story-calendar-placeholder__icon">
              ↗
            </span>

            <h3>Connect Koalendar</h3>

            <p>
              Add your Koalendar booking URL in the Shopify Theme Editor to display your appointment calendar here.
            </p>

          </div>

        {% endif %}

      </div>

    </div>


    <!-- ============================================
      BOTTOM MESSAGE
    ============================================= -->
    {% if section.settings.bottom_message != blank %}

      <div class="la-story-bottom-message">

        <span class="la-story-bottom-message__line"></span>

        <p>
          {{ section.settings.bottom_message }}
        </p>

        <span class="la-story-bottom-message__line"></span>

      </div>

    {% endif %}

  </div>


  <!-- ============================================
    FLOATING BOOKING BUTTON
  ============================================= -->
  {% if section.settings.show_floating_button %}

    <a
      href="{{ booking_target }}"
      class="la-story-floating-booking"
      aria-label="Book an appointment"
      {% unless section.settings.show_booking_embed %}
        {% if section.settings.booking_url != blank %}
          target="_blank"
          rel="noopener"
        {% endif %}
      {% endunless %}
    >

      <span class="la-story-floating-booking__calendar">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <rect
            x="3"
            y="5"
            width="18"
            height="16"
            rx="2"
            stroke="currentColor"
            stroke-width="1.7"
          />
          <path
            d="M8 3V7M16 3V7M3 10H21"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
        </svg>
      </span>

      <span>
        {{ section.settings.floating_button_label }}
      </span>

    </a>

  {% endif %}

</section>


<style>

  /* ==================================================
     SECTION BASE
  ================================================== */

  #la-story-landing-{{ section.id }} {
    background: var(--ls-background);
    color: var(--ls-text);
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  #la-story-landing-{{ section.id }} *,
  #la-story-landing-{{ section.id }} *::before,
  #la-story-landing-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #la-story-landing-{{ section.id }} a {
    text-decoration: none;
  }

  #la-story-landing-{{ section.id }} .la-story-shell {
    width: min(100% - 40px, 1280px);
    margin: 0 auto;
  }


  /* ==================================================
     HERO
  ================================================== */

  #la-story-landing-{{ section.id }} .la-story-hero {
    min-height: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 100px 20px 80px;
  }

  #la-story-landing-{{ section.id }} .la-story-eyebrow,
  #la-story-landing-{{ section.id }} .la-story-section-eyebrow {
    margin: 0 0 20px;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 11px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ls-accent);
  }

  #la-story-landing-{{ section.id }} .la-story-logo {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    color: var(--ls-heading);
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 400;
    margin-left: 0.28em;
  }

  #la-story-landing-{{ section.id }} .la-story-hero__divider {
    width: 46px;
    height: 1px;
    background: var(--ls-accent);
    margin: 34px 0;
  }

  #la-story-landing-{{ section.id }} .la-story-hero__heading {
    color: var(--ls-heading);
    max-width: 850px;
    margin: 0;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: clamp(38px, 6vw, 74px);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: -0.045em;
  }

  #la-story-landing-{{ section.id }} .la-story-hero__text {
    max-width: 650px;
    margin: 28px auto 0;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ls-text);
  }

  #la-story-landing-{{ section.id }} .la-story-hero__text p {
    margin: 0;
  }

  #la-story-landing-{{ section.id }} .la-story-hero__actions {
    margin-top: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  #la-story-landing-{{ section.id }} .la-story-hero__note {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.04em;
    margin: 18px 0 0;
    color: var(--ls-text);
  }


  /* ==================================================
     BUTTONS
  ================================================== */

  #la-story-landing-{{ section.id }} .la-story-button {
    min-height: 52px;
    padding: 0 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;

    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.09em;
    text-transform: uppercase;

    border: 1px solid;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  #la-story-landing-{{ section.id }} .la-story-button:hover {
    transform: translateY(-2px);
  }

  #la-story-landing-{{ section.id }} .la-story-button--primary {
    background: var(--ls-primary);
    color: #fffaf3;
    border-color: var(--ls-primary);
  }

  #la-story-landing-{{ section.id }} .la-story-button--primary:hover {
    background: var(--ls-background);
    color: var(--ls-primary);
  }

  #la-story-landing-{{ section.id }} .la-story-button--secondary {
    background: #fffaf3;
    color: var(--ls-primary);
    border-color: var(--ls-border);
  }

  #la-story-landing-{{ section.id }} .la-story-button--secondary:hover {
    background: #f2e6da;
    border-color: var(--ls-accent);
  }

  #la-story-landing-{{ section.id }} .la-story-button__arrow {
    font-size: 17px;
    transition: transform 0.2s ease;
  }

  #la-story-landing-{{ section.id }} .la-story-button:hover .la-story-button__arrow {
    transform: translateX(4px);
  }


  /* ==================================================
     STEPS
  ================================================== */

  #la-story-landing-{{ section.id }} .la-story-steps {
    border-top: 1px solid var(--ls-border);
    border-bottom: 1px solid var(--ls-border);

    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  #la-story-landing-{{ section.id }} .la-story-step {
    padding: 34px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  #la-story-landing-{{ section.id }} .la-story-step:not(:last-child) {
    border-right: 1px solid var(--ls-border);
  }

  #la-story-landing-{{ section.id }} .la-story-step__number {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--ls-accent);
    margin-top: 5px;
  }

  #la-story-landing-{{ section.id }} .la-story-step h3 {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    color: var(--ls-heading);
    font-size: 15px;
    line-height: 1.3;
    margin: 0 0 8px;
    font-weight: 500;
  }

  #la-story-landing-{{ section.id }} .la-story-step p {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 12px;
    line-height: 1.65;
    margin: 0;
  }


  /* ==================================================
     SERVICES
  ================================================== */

  #la-story-landing-{{ section.id }} .la-story-services {
    padding: 110px 0;
    scroll-margin-top: 40px;
  }

  #la-story-landing-{{ section.id }} .la-story-section-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 80px;
    margin-bottom: 55px;
  }

  #la-story-landing-{{ section.id }} .la-story-section-header h2,
  #la-story-landing-{{ section.id }} .la-story-booking h2 {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 400;
    color: var(--ls-heading);
    margin: 0;
  }

  #la-story-landing-{{ section.id }} .la-story-section-header__description {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 14px;
    line-height: 1.8;
    max-width: 500px;
  }

  #la-story-landing-{{ section.id }} .la-story-section-header__description p {
    margin: 0;
  }


  /* Service grid */

  #la-story-landing-{{ section.id }} .la-story-service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ls-border);
  }

  #la-story-landing-{{ section.id }} .la-story-service-card {
    padding: 38px 34px;
    border-bottom: 1px solid var(--ls-border);
    position: relative;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card:nth-child(odd) {
    border-right: 1px solid var(--ls-border);
  }

  #la-story-landing-{{ section.id }} .la-story-service-card:hover {
    background: var(--ls-card);
  }

  #la-story-landing-{{ section.id }} .la-story-service-card--featured::before {
    content: "POPULAR";
    position: absolute;
    right: 25px;
    top: 0;
    transform: translateY(-50%);
    background: var(--ls-accent);
    color: #fffaf3;
    padding: 7px 11px;

    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 8px;
    letter-spacing: 0.18em;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__top {
    display: flex;
    justify-content: space-between;
    gap: 25px;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__label {
    display: block;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    color: var(--ls-accent);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 9px;
    margin-bottom: 10px;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card h3 {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 20px;
    line-height: 1.35;
    font-weight: 500;
    margin: 0;
    color: var(--ls-heading);
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__price {
    text-align: right;
    white-space: nowrap;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__price span {
    display: block;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__price strong {
    color: var(--ls-heading);
    font-size: 17px;
    font-weight: 500;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__description {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 12px;
    line-height: 1.75;
    margin-top: 20px;
    max-width: 540px;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__description p {
    margin: 0;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__details {
    border-left: 2px solid var(--ls-border);
    padding-left: 15px;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 10px;
    line-height: 1.6;
    margin-top: 20px;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__details p {
    margin: 0;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;

    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 10px;
    color: var(--ls-primary);

    border-bottom: 1px solid var(--ls-border);
    padding-bottom: 7px;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__link span {
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  #la-story-landing-{{ section.id }} .la-story-service-card__link:hover span {
    transform: translateX(5px);
  }


  /* ==================================================
     BOOKING
  ================================================== */

  #la-story-landing-{{ section.id }} .la-story-booking {
    background: #fffaf3;
    border: 1px solid var(--ls-border);

    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.5fr);

    margin-bottom: 80px;
    scroll-margin-top: 40px;
  }

  #la-story-landing-{{ section.id }} .la-story-booking__intro {
    padding: 55px 45px;
    border-right: 1px solid var(--ls-border);
  }

  #la-story-landing-{{ section.id }} .la-story-booking__description {
    margin-top: 22px;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 13px;
    line-height: 1.8;
  }

  #la-story-landing-{{ section.id }} .la-story-booking__description p {
    margin: 0;
  }

  #la-story-landing-{{ section.id }} .la-story-booking__reassurance {
    margin-top: 36px;
    display: grid;
    gap: 13px;
  }

  #la-story-landing-{{ section.id }} .la-story-booking__reassurance-item {
    display: flex;
    align-items: center;
    gap: 10px;

    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.025em;
  }

  #la-story-landing-{{ section.id }} .la-story-booking__reassurance-item span {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 20px;
    height: 20px;
    border-radius: 50%;

    background: var(--ls-background);
    color: var(--ls-primary);
    font-size: 10px;
  }

  #la-story-landing-{{ section.id }} .la-story-booking__calendar {
    min-width: 0;
    padding: 25px;
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-frame {
    width: 100%;
    height: {{ section.settings.calendar_height }}px;
    min-height: 600px;
    background: #ffffff;
    overflow: hidden;
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-frame iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-fallback {
    margin-top: 12px;
    text-align: center;

    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 9px;
    letter-spacing: 0.03em;
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-fallback a {
    color: var(--ls-primary);
    text-decoration: underline;
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-placeholder,
  #la-story-landing-{{ section.id }} .la-story-external-booking {
    min-height: 500px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    padding: 50px;
    background: var(--ls-background);
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-placeholder__icon {
    width: 55px;
    height: 55px;
    border: 1px solid var(--ls-border);
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 22px;
    color: var(--ls-primary);
    margin-bottom: 20px;
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-placeholder h3 {
    color: var(--ls-heading);
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 12px;
  }

  #la-story-landing-{{ section.id }} .la-story-calendar-placeholder p,
  #la-story-landing-{{ section.id }} .la-story-external-booking p {
    max-width: 430px;
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 12px;
    line-height: 1.7;
    margin: 0 0 25px;
  }


  /* ==================================================
     BOTTOM MESSAGE
  ================================================== */

  #la-story-landing-{{ section.id }} .la-story-bottom-message {
    padding: 0 0 105px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
  }

  #la-story-landing-{{ section.id }} .la-story-bottom-message p {
    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    color: var(--ls-heading);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
  }

  #la-story-landing-{{ section.id }} .la-story-bottom-message__line {
    height: 1px;
    background: var(--ls-border);
    width: 80px;
  }


  /* ==================================================
     FLOATING CTA
  ================================================== */

  #la-story-landing-{{ section.id }} .la-story-floating-booking {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 20;

    min-height: 52px;
    padding: 0 22px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;

    background: var(--ls-primary);
    color: #fffaf3;

    border: 1px solid var(--ls-primary);

    box-shadow: 0 10px 35px #3d302826;

    font-family: "Century Gothic", "Avenir Next", Arial, sans-serif;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;

    transition:
      transform 0.25s ease,
      background 0.25s ease,
      color 0.25s ease;
  }

  #la-story-landing-{{ section.id }} .la-story-floating-booking:hover {
    background: var(--ls-background);
    color: var(--ls-primary);
    transform: translateY(-3px);
  }

  #la-story-landing-{{ section.id }} .la-story-floating-booking__calendar {
    display: flex;
  }


  /* ==================================================
     SMOOTH SCROLL
  ================================================== */

  html {
    scroll-behavior: smooth;
  }


  /* ==================================================
     TABLET
  ================================================== */

  @media screen and (max-width: 989px) {

    #la-story-landing-{{ section.id }} .la-story-hero {
      min-height: 590px;
      padding-top: 80px;
    }

    #la-story-landing-{{ section.id }} .la-story-steps {
      grid-template-columns: 1fr;
    }

    #la-story-landing-{{ section.id }} .la-story-step:not(:last-child) {
      border-right: 0;
      border-bottom: 1px solid var(--ls-border);
    }

    #la-story-landing-{{ section.id }} .la-story-section-header {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #la-story-landing-{{ section.id }} .la-story-booking {
      grid-template-columns: 1fr;
    }

    #la-story-landing-{{ section.id }} .la-story-booking__intro {
      border-right: 0;
      border-bottom: 1px solid var(--ls-border);
    }

  }


  /* ==================================================
     MOBILE
  ================================================== */

  @media screen and (max-width: 749px) {

    #la-story-landing-{{ section.id }} .la-story-shell {
      width: min(100% - 28px, 1280px);
    }

    #la-story-landing-{{ section.id }} .la-story-hero {
      min-height: auto;
      padding: 80px 5px 65px;
    }

    #la-story-landing-{{ section.id }} .la-story-logo {
      font-size: 23px;
    }

    #la-story-landing-{{ section.id }} .la-story-hero__heading {
      font-size: clamp(34px, 11vw, 50px);
    }

    #la-story-landing-{{ section.id }} .la-story-hero__text {
      font-size: 14px;
      line-height: 1.7;
    }

    #la-story-landing-{{ section.id }} .la-story-hero__actions {
      width: 100%;
    }

    #la-story-landing-{{ section.id }} .la-story-button {
      width: 100%;
    }

    #la-story-landing-{{ section.id }} .la-story-step {
      padding: 25px 20px;
    }

    #la-story-landing-{{ section.id }} .la-story-services {
      padding: 80px 0;
    }

    #la-story-landing-{{ section.id }} .la-story-service-grid {
      grid-template-columns: 1fr;
    }

    #la-story-landing-{{ section.id }} .la-story-service-card {
      padding: 30px 20px;
    }

    #la-story-landing-{{ section.id }} .la-story-service-card:nth-child(odd) {
      border-right: 0;
    }

    #la-story-landing-{{ section.id }} .la-story-service-card__top {
      flex-direction: column;
      gap: 15px;
    }

    #la-story-landing-{{ section.id }} .la-story-service-card__price {
      text-align: left;
    }

    #la-story-landing-{{ section.id }} .la-story-booking__intro {
      padding: 40px 25px;
    }

    #la-story-landing-{{ section.id }} .la-story-booking__calendar {
      padding: 10px;
    }

    #la-story-landing-{{ section.id }} .la-story-calendar-frame {
      min-height: 650px;
      height: 720px;
    }

    #la-story-landing-{{ section.id }} .la-story-bottom-message {
      padding-bottom: 100px;
    }

    #la-story-landing-{{ section.id }} .la-story-bottom-message__line {
      width: 30px;
    }

    #la-story-landing-{{ section.id }} .la-story-floating-booking {
      left: 14px;
      right: 14px;
      bottom: 14px;
      width: auto;
    }

  }

</style>


{% schema %}
