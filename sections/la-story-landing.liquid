</style>



<script>
  document.addEventListener('DOMContentLoaded', function () {

    const section =
      document.getElementById('{{ section_id }}');

    if (!section) return;


    /*
      Luxury accordion behavior:
      Only one category stays open at a time.
    */

    const categories =
      section.querySelectorAll('.ls-category');

    categories.forEach(function (category) {

      category.addEventListener('toggle', function () {

        if (!category.open) return;

        categories.forEach(function (otherCategory) {

          if (
            otherCategory !== category &&
            otherCategory.open
          ) {
            otherCategory.removeAttribute('open');
          }

        });

      });

    });

  });
</script>



