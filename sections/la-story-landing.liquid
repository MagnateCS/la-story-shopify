{% comment %}
  LA Story — complete landing page section

  Setup:
  1. Upload hero imagery through the section settings.
  2. Paste Koalendar popup widget embed code or enter a booking URL.
  3. Add/edit Service blocks.
  4. Select products under Product previews.
  5. Disable this section's navigation/footer if using the theme's own.

  Product prices and purchase buttons are intentionally omitted.
{% endcomment %}

<link
  href="https://fonts.cdnfonts.com/css/century-gothic-paneuropean"
  rel="stylesheet"
>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=GFS+Didot&display=swap"
  rel="stylesheet"
>

{% liquid
  assign sid = 'LaStory-' | append: section.id
  assign service_blocks = section.blocks | where: 'type', 'service'
  assign hero_alt = section.settings.hero_image.alt | default: section.settings.hero_heading
  assign logo_alt = section.settings.logo.alt | default: section.settings.brand_name
%}

<style>
  #{{ sid }} {
    --ls-wine: {{ section.settings.accent_color }};
    --ls-dark: {{ section.settings.dark_color }};
    --ls-ink: {{ section.settings.text_color }};
    --ls-cream: {{ section.settings.background_color }};
    --ls-paper: {{ section.settings.surface_color }};
    --ls-gold: {{ section.settings.detail_color }};
    --ls-line: {{ section.settings.text_color | color_modify: 'alpha', 0.16 }};
    --ls-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.72 }};
    --ls-brand: "Century Gothic Paneuropean", "Century Gothic", sans-serif;
    --ls-editorial: "GFS Didot", Didot, "Times New Roman", serif;
    --ls-width: {{ section.settings.content_width }}px;
    --ls-overlay: {{ section.settings.hero_overlay | divided_by: 100.0 }};
    display: block;
    width: 100%;
    background: var(--ls-cream);
    color: var(--ls-ink);
    font-family: var(--ls-editorial);
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.65;
    isolation: isolate;
    overflow-wrap: anywhere;
  }

  #{{ sid }} *,
  #{{ sid }} *::before,
  #{{ sid }} *::after {
    box-sizing: border-box;
  }

  #{{ sid }} [hidden] {
    display: none !important;
  }

  #{{ sid }} h1,
  #{{ sid }} h2,
  #{{ sid }} h3,
  #{{ sid }} p {
    color: inherit;
    margin: 0;
  }

  #{{ sid }} h1,
  #{{ sid }} h2,
  #{{ sid }} h3 {
    font-family: var(--ls-editorial);
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.025em;
  }

  #{{ sid }} a {
    color: inherit;
    text-decoration: none;
  }

  #{{ sid }} button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  #{{ sid }} img {
    display: block;
    max-width: 100%;
  }

  #{{ sid }} button:focus-visible,
  #{{ sid }} a:focus-visible {
    outline: 2px solid var(--ls-gold);
    outline-offset: 5px;
  }

  #{{ sid }} .ls-wrap {
    width: min(var(--ls-width), calc(100% - 48px));
    margin-inline: auto;
  }

  #{{ sid }} .ls-brand,
  #{{ sid }} .ls-eyebrow,
  #{{ sid }} .ls-button,
  #{{ sid }} .ls-nav,
  #{{ sid }} .ls-announcement,
  #{{ sid }} .ls-link,
  #{{ sid }} .ls-service-price,
  #{{ sid }} .ls-footer-label,
  #{{ sid }} .ls-copyright,
  #{{ sid }} .ls-close {
    font-family: var(--ls-brand);
  }

  #{{ sid }} .ls-eyebrow {
    font-size: 0.75em;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #{{ sid }} .ls-button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 14px 24px;
    border: 1px solid transparent;
    border-radius: 0;
    background: var(--ls-wine);
    color: #fff;
    font-size: 0.75em;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    transition: background 220ms ease, transform 220ms ease;
  }

  #{{ sid }} .ls-button:hover {
    background: var(--ls-dark);
    transform: translateY(-2px);
  }

  #{{ sid }} .ls-button-light {
    background: var(--ls-paper);
    color: var(--ls-dark);
  }

  #{{ sid }} .ls-button-light:hover {
    background: var(--ls-gold);
    color: #fff;
  }

  #{{ sid }} .ls-button-outline {
    background: transparent;
    color: #fff;
    border-color: rgb(255 255 255 / 65%);
  }

  #{{ sid }} .ls-button-outline:hover {
    background: rgb(255 255 255 / 12%);
  }

  #{{ sid }} .ls-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  #{{ sid }} .ls-link {
    display: inline-block;
    font-size: 0.75em;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 5px;
  }

  #{{ sid }} .ls-announcement {
    padding: 9px 18px;
    background: var(--ls-dark);
    color: #fff;
    font-size: 0.7em;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  #{{ sid }} .ls-hero-shell {
    position: relative;
  }

  #{{ sid }} .ls-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    border-bottom: 1px solid rgb(255 255 255 / 25%);
    color: #fff;
  }

  #{{ sid }} .ls-header-inner {
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 16px;
  }

  #{{ sid }} .ls-brand {
    font-size: 1.6em;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  #{{ sid }} .ls-logo-image {
    width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  #{{ sid }} .ls-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 0.72em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ sid }} .ls-nav-book {
    appearance: none;
    padding: 10px 16px;
    border: 1px solid rgb(255 255 255 / 70%);
    background: transparent;
    color: #fff;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  #{{ sid }} .ls-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.hero_height }}px;
    overflow: hidden;
    background: var(--ls-dark);
    color: #fff;
  }

  #{{ sid }} .ls-hero-media,
  #{{ sid }} .ls-hero-media img,
  #{{ sid }} .ls-hero-media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #{{ sid }} .ls-hero-media img {
    object-fit: cover;
    object-position: {{ section.settings.hero_image.presentation.focal_point | default: '65% 50%' }};
  }

  #{{ sid }} .ls-hero-media svg {
    object-fit: cover;
    fill: var(--ls-gold);
    opacity: 0.3;
  }

  #{{ sid }} .ls-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(20 8 10 / var(--ls-overlay)),
      rgb(20 8 10 / 35%) 60%,
      rgb(20 8 10 / 12%)
    );
  }

  #{{ sid }} .ls-hero-content {
    position: relative;
    z-index: 1;
    padding-block: 160px 100px;
  }

  #{{ sid }} .ls-hero-copy {
    max-width: 650px;
  }

  #{{ sid }} .ls-hero h1 {
    margin-block: 18px 24px;
    font-size: clamp(2.8em, 6vw, 5em);
    line-height: 1.04;
  }

  #{{ sid }} .ls-hero-description {
    max-width: 510px;
    color: rgb(255 255 255 / 87%);
  }

  #{{ sid }} .ls-intro,
  #{{ sid }} .ls-products,
  #{{ sid }} .ls-booking {
    padding-block: 100px;
    background: var(--ls-paper);
  }

  #{{ sid }} .ls-intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 10%;
  }

  #{{ sid }} .ls-heading {
    font-size: clamp(2.3em, 4.7vw, 4.3em);
    line-height: 1.08;
    margin-top: 12px;
  }

  #{{ sid }} .ls-intro-text {
    font-size: 1.4em;
    line-height: 1.45;
  }

  #{{ sid }} .ls-intro-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    border-top: 1px solid var(--ls-line);
    padding-top: 28px;
    margin-top: 30px;
  }

  #{{ sid }} .ls-intro-details p {
    margin-top: 8px;
    color: var(--ls-muted);
  }

  #{{ sid }} .ls-services {
    padding-block: 100px;
  }

  #{{ sid }} .ls-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 35px;
    margin-bottom: 42px;
  }

  #{{ sid }} .ls-section-description {
    max-width: 430px;
    color: var(--ls-muted);
  }

  #{{ sid }} .ls-service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 30px;
    border-top: 1px solid var(--ls-line);
  }

  #{{ sid }} .ls-service {
    position: relative;
    padding: 32px 0 82px;
    border-bottom: 1px solid var(--ls-line);
  }

  #{{ sid }} .ls-number {
    color: var(--ls-gold);
  }

  #{{ sid }} .ls-service h3 {
    font-size: 1.65em;
    line-height: 1.2;
    margin-block: 20px 12px;
  }

  #{{ sid }} .ls-service-description {
    color: var(--ls-muted);
  }

  #{{ sid }} .ls-service-price {
    position: absolute;
    bottom: 30px;
    left: 0;
    max-width: calc(100% - 60px);
    font-size: 0.72em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ sid }} .ls-service-more {
    position: absolute;
    right: 0;
    bottom: 22px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--ls-line);
    border-radius: 50%;
    background: transparent;
  }

  #{{ sid }} .ls-service-more:hover {
    background: var(--ls-wine);
    color: #fff;
  }

  #{{ sid }} .ls-teaser {
    position: relative;
    overflow: hidden;
    background: var(--ls-dark);
    color: #fff;
    padding: 100px 24px;
    text-align: center;
  }

  #{{ sid }} .ls-teaser::before {
    content: attr(data-brand);
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    font-family: var(--ls-brand);
    font-size: clamp(90px, 16vw, 250px);
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 10%);
    pointer-events: none;
  }

  #{{ sid }} .ls-teaser-inner {
    position: relative;
    max-width: 720px;
    margin-inline: auto;
  }

  #{{ sid }} .ls-teaser p {
    max-width: 500px;
    margin: 24px auto 30px;
    color: rgb(255 255 255 / 80%);
  }

  #{{ sid }} .ls-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }

  #{{ sid }} .ls-product-button {
    appearance: none;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
  }

  #{{ sid }} .ls-product-media {
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--ls-cream);
  }

  #{{ sid }} .ls-product-media img,
  #{{ sid }} .ls-product-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  #{{ sid }} .ls-product-button:hover img {
    transform: scale(1.035);
  }

  #{{ sid }} .ls-product-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding-block: 18px 12px;
    border-bottom: 1px solid var(--ls-line);
    font-family: var(--ls-editorial);
    font-size: 1.5em;
    line-height: 1.3;
  }

  #{{ sid }} .ls-product-note {
    margin-top: 28px;
    color: var(--ls-muted);
  }

  #{{ sid }} .ls-booking-card {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 9%;
    padding: 60px;
    border: 1px solid var(--ls-line);
  }

  #{{ sid }} .ls-booking-copy {
    margin-top: 22px;
    color: var(--ls-muted);
  }

  #{{ sid }} .ls-booking-card .ls-button {
    margin-top: 28px;
  }

  #{{ sid }} .ls-steps {
    list-style: none;
    counter-reset: ls-step;
    margin: 0;
    padding: 0;
  }

  #{{ sid }} .ls-steps li {
    counter-increment: ls-step;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    padding-block: 20px;
    border-bottom: 1px solid var(--ls-line);
  }

  #{{ sid }} .ls-steps li::before {
    content: "0" counter(ls-step);
    color: var(--ls-gold);
  }

  #{{ sid }} .ls-steps p {
    color: var(--ls-muted);
    margin-top: 4px;
  }

  #{{ sid }} .ls-footer {
    padding-block: 58px 30px;
    background: var(--ls-dark);
    color: #fff;
  }

  #{{ sid }} .ls-footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 40px;
  }

  #{{ sid }} .ls-footer-label {
    font-size: 0.72em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  #{{ sid }} .ls-footer p {
    margin-top: 16px;
    color: rgb(255 255 255 / 80%);
  }

  #{{ sid }} .ls-footer-links {
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  #{{ sid }} .ls-footer-links button {
    padding: 0;
    border: 0;
    background: transparent;
  }

  #{{ sid }} .ls-copyright {
    padding-top: 24px;
    margin-top: 40px;
    border-top: 1px solid rgb(255 255 255 / 18%);
    font-size: 0.72em;
    color: rgb(255 255 255 / 65%);
  }

  #{{ sid }} .ls-floating {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 30;
    box-shadow: 0 12px 32px rgb(0 0 0 / 20%);
  }

  #{{ sid }} dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    width: min(620px, calc(100% - 32px));
    max-width: none;
    max-height: 92dvh;
    border: 0;
    background: var(--ls-paper);
    color: var(--ls-ink);
    overflow: auto;
    overscroll-behavior: contain;
    box-shadow: 0 30px 90px rgb(0 0 0 / 30%);
  }

  #{{ sid }} dialog::backdrop {
    background: rgb(23 12 13 / 72%);
    backdrop-filter: blur(5px);
  }

  #{{ sid }} .ls-modal-inner {
    position: relative;
    padding: 52px 38px 38px;
  }

  #{{ sid }} .ls-modal-heading {
    font-size: 2.1em;
    line-height: 1.15;
    margin-block: 12px 20px;
  }

  #{{ sid }} .ls-modal-copy {
    color: var(--ls-muted);
  }

  #{{ sid }} .ls-modal-copy p + p {
    margin-top: 16px;
  }

  #{{ sid }} .ls-modal-inner .ls-button {
    margin-top: 28px;
  }

  #{{ sid }} .ls-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: var(--ls-paper);
    color: var(--ls-ink);
    font-size: 28px;
    line-height: 1;
  }

  #{{ sid }} .ls-booking-dialog {
    width: min(1080px, calc(100% - 24px));
  }

  #{{ sid }} .ls-booking-dialog-head {
    position: relative;
    padding: 24px 66px 20px 28px;
    border-bottom: 1px solid var(--ls-line);
  }

  #{{ sid }} .ls-booking-dialog-head h2 {
    font-size: 1.8em;
    line-height: 1.2;
    margin-top: 8px;
  }

  #{{ sid }} .ls-calendar-frame {
    display: block;
    width: 100%;
    height: 750px;
    border: 0;
    background: #fff;
  }

  #{{ sid }} .ls-calendar-help,
  #{{ sid }} .ls-booking-empty {
    padding: 22px 28px;
  }

  #{{ sid }} .ls-booking-empty {
    padding-block: 55px;
    text-align: center;
  }

  #{{ sid }} .ls-product-dialog-image {
    width: 100%;
    max-height: 55dvh;
    object-fit: contain;
    background: var(--ls-cream);
    margin-bottom: 24px;
  }

  #{{ sid }} .ls-richtext p + p {
    margin-top: 16px;
  }

  #{{ sid }} .ls-richtext a {
    text-decoration: underline;
  }

  #{{ sid }} .ls-reveal {
    animation: ls-enter-{{ section.id }} 700ms ease both;
  }

  @keyframes ls-enter-{{ section.id }} {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 800px) {
    #{{ sid }} .ls-header {
      position: relative;
      background: var(--ls-dark);
    }

    #{{ sid }} .ls-wrap {
      width: calc(100% - 32px);
    }

    #{{ sid }} .ls-header-inner {
      flex-wrap: wrap;
      gap: 16px;
      min-height: 76px;
    }

    #{{ sid }} .ls-nav {
      gap: 14px;
      font-size: max(12px, 0.72em);
    }

    #{{ sid }} .ls-nav a,
    #{{ sid }} .ls-footer-links > a,
    #{{ sid }} .ls-footer-links > button,
    #{{ sid }} .ls-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    #{{ sid }} .ls-nav-book {
      min-height: 44px;
    }

    #{{ sid }} .ls-hero {
      min-height: min(640px, 80svh);
    }

    #{{ sid }} .ls-hero-content {
      padding-block: 64px;
    }

    #{{ sid }} .ls-hero h1 {
      font-size: clamp(2.5em, 10vw, 3.6em);
    }

    #{{ sid }} .ls-hero::after {
      background: linear-gradient(
        180deg,
        rgb(20 8 10 / 40%),
        rgb(20 8 10 / var(--ls-overlay))
      );
    }

    #{{ sid }} .ls-intro,
    #{{ sid }} .ls-services,
    #{{ sid }} .ls-products,
    #{{ sid }} .ls-booking {
      padding-block: 65px;
    }

    #{{ sid }} .ls-intro-grid,
    #{{ sid }} .ls-booking-card {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    #{{ sid }} .ls-section-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 22px;
    }

    #{{ sid }} .ls-service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ sid }} .ls-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    #{{ sid }} .ls-product-title {
      font-size: 1.15em;
    }

    #{{ sid }} .ls-booking-card {
      padding: 32px 24px;
    }

    #{{ sid }} .ls-footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    #{{ sid }} .ls-footer-grid > :first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    #{{ sid }} .ls-header-inner {
      justify-content: center;
      gap: 8px;
      padding-block: 12px;
    }

    #{{ sid }} .ls-brand {
      max-width: 100%;
      font-size: 1.35em;
      text-align: center;
    }

    #{{ sid }} .ls-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: 4px 12px;
      text-align: center;
    }

    #{{ sid }} .ls-nav a {
      justify-content: center;
    }

    #{{ sid }} .ls-nav-book {
      grid-column: 1 / -1;
    }

    #{{ sid }} .ls-hero-content {
      padding-block: 44px 52px;
    }

    #{{ sid }} .ls-hero h1 {
      font-size: clamp(2em, 9.5vw, 2.8em);
      margin-block: 16px 20px;
    }

    #{{ sid }} .ls-heading {
      font-size: clamp(1.8em, 8vw, 2.5em);
    }

    #{{ sid }} .ls-intro-text {
      font-size: 1.15em;
    }

    #{{ sid }} .ls-intro,
    #{{ sid }} .ls-services,
    #{{ sid }} .ls-products,
    #{{ sid }} .ls-booking {
      padding-block: 48px;
    }

    #{{ sid }} .ls-teaser {
      padding: 56px 16px;
    }

    #{{ sid }} .ls-section-head {
      margin-bottom: 28px;
    }

    #{{ sid }} .ls-actions {
      flex-direction: column;
      margin-top: 24px;
    }

    #{{ sid }} .ls-button {
      max-width: 100%;
    }

    #{{ sid }} .ls-booking-card .ls-button,
    #{{ sid }} .ls-modal-inner .ls-button {
      width: 100%;
    }

    #{{ sid }} .ls-intro-details,
    #{{ sid }} .ls-footer-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    #{{ sid }} .ls-booking-card {
      padding: 28px 18px;
      gap: 24px;
    }

    #{{ sid }} .ls-service-grid,
    #{{ sid }} .ls-product-grid {
      grid-template-columns: 1fr;
    }

    #{{ sid }} .ls-product-grid {
      gap: 34px;
    }

    #{{ sid }} .ls-product-title {
      font-size: 1.25em;
    }

    #{{ sid }} dialog {
      width: calc(100% - 16px);
      max-height: calc(100dvh - 32px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
    }

    #{{ sid }} .ls-booking-dialog-head {
      position: sticky;
      top: 0;
      z-index: 3;
      padding: 18px 60px 16px 18px;
      background: var(--ls-paper);
    }

    #{{ sid }} .ls-booking-dialog-head h2 {
      font-size: 1.4em;
    }

    #{{ sid }} .ls-calendar-frame {
      height: 65dvh;
      min-height: 320px;
    }

    #{{ sid }} .ls-calendar-help {
      padding: 18px;
    }

    #{{ sid }} .ls-modal-inner {
      padding: 54px 24px 30px;
    }

    #{{ sid }} .ls-floating {
      position: sticky;
      display: flex;
      width: calc(100% - 32px);
      margin: 16px auto;
      right: auto;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      padding-inline: 18px;
    }
  }

  @media (max-width: 749px) {
    #{{ sid }} .ls-hero-media img {
      object-position: {{ section.settings.hero_mobile.presentation.focal_point | default: section.settings.hero_image.presentation.focal_point | default: '65% 50%' }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ sid }} *,
    #{{ sid }} *::before,
    #{{ sid }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<la-story-landing
  id="{{ sid }}"
  data-booking-url="{{ section.settings.koalendar_url | escape }}"
>
  {% if section.settings.announcement != blank %}
    <div class="ls-announcement">
      {{ section.settings.announcement | escape }}
    </div>
  {% endif %}

  <div class="ls-hero-shell" id="{{ sid }}-top">
    {% if section.settings.show_navigation %}
      <header class="ls-header">
        <div class="ls-wrap ls-header-inner">
          <a
            class="ls-brand"
            href="#{{ sid }}-top"
            aria-label="{{ section.settings.brand_name | escape }}"
          >
            {% if section.settings.logo != blank %}
              {{
                section.settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'ls-logo-image',
                  widths: '150, 250, 400, 600',
                  alt: logo_alt
              }}
            {% else %}
              {{ section.settings.brand_name | escape }}
            {% endif %}
          </a>

          <nav class="ls-nav" aria-label="Landing page navigation">
            {% if section.settings.show_services %}
              <a href="#{{ sid }}-services">Alterations</a>
            {% endif %}

            {% if section.settings.show_teaser %}
              <a href="#{{ sid }}-shop">Bridal shop</a>
            {% elsif section.settings.show_products %}
              <a href="#{{ sid }}-products">Bridal preview</a>
            {% endif %}

            {% if section.settings.show_intro %}
              <a class="ls-nav-atelier" href="#{{ sid }}-atelier">
                Our atelier
              </a>
            {% endif %}

            <button class="ls-nav-book" type="button" data-ls-book>
              {{ section.settings.booking_button | escape }}
            </button>
          </nav>
        </div>
      </header>
    {% endif %}

    <section class="ls-hero" aria-labelledby="{{ sid }}-hero-title">
      <div class="ls-hero-media">
        {% if section.settings.hero_image != blank %}
          <picture>
            {% if section.settings.hero_mobile != blank %}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ section.settings.hero_mobile | image_url: width: 600 }} 600w,
                  {{ section.settings.hero_mobile | image_url: width: 1000 }} 1000w
                "
                sizes="100vw"
              >
            {% endif %}

            {{
              section.settings.hero_image
              | image_url: width: 2400
              | image_tag:
                widths: '750, 1100, 1500, 2000, 2400',
                sizes: '100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: hero_alt
            }}
          </picture>
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="ls-wrap ls-hero-content ls-reveal">
        <div class="ls-hero-copy">
          <div class="ls-eyebrow">
            {{ section.settings.hero_eyebrow | escape }}
          </div>

          <h1 id="{{ sid }}-hero-title">
            {{ section.settings.hero_heading | escape | newline_to_br }}
          </h1>

          <div class="ls-hero-description ls-richtext">
            {{ section.settings.hero_description }}
          </div>

          <div class="ls-actions">
            <button
              class="ls-button ls-button-light"
              type="button"
              data-ls-book
            >
              {{ section.settings.booking_button | escape }}
            </button>

            {% if section.settings.show_services %}
              <a
                class="ls-button ls-button-outline"
                href="#{{ sid }}-services"
              >
                Explore services
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  </div>

  {% if section.settings.show_intro %}
    <section class="ls-intro" id="{{ sid }}-atelier">
      <div class="ls-wrap ls-intro-grid">
        <div>
          <div class="ls-eyebrow">
            {{ section.settings.intro_eyebrow | escape }}
          </div>
          <h2 class="ls-heading">
            {{ section.settings.intro_heading | escape | newline_to_br }}
          </h2>
        </div>

        <div>
          <div class="ls-intro-text ls-richtext">
            {{ section.settings.intro_text }}
          </div>

          <div class="ls-intro-details">
            <div>
              <strong>{{ section.settings.feature_one_title | escape }}</strong>
              <p>{{ section.settings.feature_one_text | escape }}</p>
            </div>
            <div>
              <strong>{{ section.settings.feature_two_title | escape }}</strong>
              <p>{{ section.settings.feature_two_text | escape }}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_services %}
    <section class="ls-services" id="{{ sid }}-services">
      <div class="ls-wrap">
        <div class="ls-section-head">
          <div>
            <div class="ls-eyebrow">
              {{ section.settings.services_eyebrow | escape }}
            </div>
            <h2 class="ls-heading">
              {{ section.settings.services_heading | escape }}
            </h2>
          </div>
          {% if section.settings.show_booking_section %}
            <a class="ls-link" href="#{{ sid }}-booking">
              How fittings work &rarr;
            </a>
          {% endif %}
        </div>

        <div class="ls-service-grid">
          {% for block in service_blocks %}
            <article
              class="ls-service"
              {{ block.shopify_attributes }}
            >
              <span class="ls-number">
                {{ forloop.index | prepend: '0' }}
              </span>

              <h3>{{ block.settings.title | escape }}</h3>

              <p class="ls-service-description">
                {{ block.settings.summary | escape }}
              </p>

              {% if section.settings.show_service_prices %}
                <span class="ls-service-price">
                  {{ block.settings.price_label | escape }}
                </span>
              {% endif %}

              <button
                class="ls-service-more"
                type="button"
                data-ls-preview="{{ sid }}-service-{{ block.id }}"
                aria-label="Preview {{ block.settings.title | escape }}"
              >
                <span aria-hidden="true">&nearr;</span>
              </button>

              <template id="{{ sid }}-service-{{ block.id }}">
                <div class="ls-eyebrow">Service details</div>
                <h2 class="ls-modal-heading" data-ls-detail-title>
                  {{ block.settings.title | escape }}
                </h2>
                <div class="ls-modal-copy ls-richtext">
                  {% if block.settings.details != blank %}
                    {{ block.settings.details }}
                  {% else %}
                    <p>{{ block.settings.summary | escape }}</p>
                  {% endif %}
                </div>

                {% if section.settings.show_service_prices and block.settings.price_label != blank %}
                  <p class="ls-modal-copy">
                    {{ block.settings.price_label | escape }}
                  </p>
                {% endif %}

                <button class="ls-button" type="button" data-ls-book>
                  {{ section.settings.booking_button | escape }}
                </button>
              </template>
            </article>
          {% endfor %}
        </div>

        {% if service_blocks.size == 0 and request.design_mode %}
          <p>Add Service blocks to display your alteration services.</p>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_teaser %}
    <section
      class="ls-teaser"
      id="{{ sid }}-shop"
      data-brand="{{ section.settings.brand_name | escape }}"
    >
      <div class="ls-teaser-inner">
        <div class="ls-eyebrow">
          {{ section.settings.teaser_label | escape }}
        </div>

        <h2 class="ls-heading">
          {{ section.settings.teaser_heading | escape }}
        </h2>

        <p>{{ section.settings.teaser_text | escape }}</p>

        {% if section.settings.show_products and section.settings.products != blank %}
          <a class="ls-link" href="#{{ sid }}-products">
            Preview the collection &rarr;
          </a>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_products %}
    {% if section.settings.products != blank or request.design_mode %}
      <section class="ls-products" id="{{ sid }}-products">
        <div class="ls-wrap">
          <div class="ls-section-head">
            <div>
              <div class="ls-eyebrow">
                {{ section.settings.products_eyebrow | escape }}
              </div>
              <h2 class="ls-heading">
                {{ section.settings.products_heading | escape }}
              </h2>
            </div>
            <p class="ls-section-description">
              {{ section.settings.products_description | escape }}
            </p>
          </div>

          <div class="ls-product-grid">
            {% for product in section.settings.products %}
              {% assign product_alt = product.featured_image.alt | default: product.title %}

              <article class="ls-product">
                <button
                  class="ls-product-button"
                  type="button"
                  data-ls-preview="{{ sid }}-product-{{ product.id }}"
                  aria-label="Preview {{ product.title | escape }}"
                >
                  <span class="ls-product-media">
                    {% if product.featured_image != blank %}
                      {{
                        product.featured_image
                        | image_url: width: 1000
                        | image_tag:
                          widths: '360, 540, 720, 1000',
                          sizes: '(min-width: 801px) 33vw, (min-width: 541px) 33vw, 100vw',
                          loading: 'lazy',
                          alt: product_alt
                      }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}
                  </span>

                  <span class="ls-product-title">
                    <span>{{ product.title | escape }}</span>
                    <span aria-hidden="true">&nearr;</span>
                  </span>
                </button>

                <template id="{{ sid }}-product-{{ product.id }}">
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'ls-product-dialog-image',
                        loading: 'lazy',
                        alt: product_alt
                    }}
                  {% endif %}

                  <div class="ls-eyebrow">
                    {{ section.settings.product_modal_label | escape }}
                  </div>

                  <h2 class="ls-modal-heading" data-ls-detail-title>
                    {{ product.title | escape }}
                  </h2>

                  {% if section.settings.show_product_descriptions %}
                    <p class="ls-modal-copy">
                      {{ product.description | strip_html | truncatewords: 70 | escape }}
                    </p>
                  {% endif %}

                  {% if section.settings.product_modal_note != blank %}
                    <p class="ls-modal-copy">
                      {{ section.settings.product_modal_note | escape }}
                    </p>
                  {% endif %}

                  {% if section.settings.product_booking_button %}
                    <button class="ls-button" type="button" data-ls-book>
                      {{ section.settings.booking_button | escape }}
                    </button>
                  {% endif %}
                </template>
              </article>
            {% else %}
              {% if request.design_mode %}
                {% for i in (1..3) %}
                  <div>
                    <div class="ls-product-media">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                    <p class="ls-product-title">Select a product</p>
                  </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>

          {% if section.settings.products_note != blank %}
            <p class="ls-product-note">
              {{ section.settings.products_note | escape }}
            </p>
          {% endif %}
        </div>
      </section>
    {% endif %}
  {% endif %}

  {% if section.settings.show_booking_section %}
    <section class="ls-booking" id="{{ sid }}-booking">
      <div class="ls-wrap">
        <div class="ls-booking-card">
          <div>
            <div class="ls-eyebrow">
              {{ section.settings.booking_eyebrow | escape }}
            </div>

            <h2 class="ls-heading">
              {{ section.settings.booking_heading | escape | newline_to_br }}
            </h2>

            <div class="ls-booking-copy ls-richtext">
              {{ section.settings.booking_text }}
            </div>

            <button class="ls-button" type="button" data-ls-book>
              {{ section.settings.booking_button | escape }}
            </button>
          </div>

          <ol class="ls-steps">
            <li>
              <div>
                <strong>{{ section.settings.step_one_title | escape }}</strong>
                <p>{{ section.settings.step_one_text | escape }}</p>
              </div>
            </li>
            <li>
              <div>
                <strong>{{ section.settings.step_two_title | escape }}</strong>
                <p>{{ section.settings.step_two_text | escape }}</p>
              </div>
            </li>
            <li>
              <div>
                <strong>{{ section.settings.step_three_title | escape }}</strong>
                <p>{{ section.settings.step_three_text | escape }}</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_footer %}
    <footer class="ls-footer">
      <div class="ls-wrap">
        <div class="ls-footer-grid">
          <div>
            <div class="ls-brand">
              {{ section.settings.brand_name | escape }}
            </div>
            <p>{{ section.settings.footer_tagline | escape }}</p>
          </div>

          <div>
            <div class="ls-footer-label">Visit</div>
            <div class="ls-richtext">
              {{ section.settings.visit_text }}
            </div>
          </div>

          <div>
            <div class="ls-footer-label">Explore</div>
            <div class="ls-footer-links">
              {% if section.settings.show_services %}
                <a href="#{{ sid }}-services">Alteration services</a>
              {% endif %}
              {% if section.settings.show_teaser %}
                <a href="#{{ sid }}-shop">Bridal shop</a>
              {% endif %}
              <button type="button" data-ls-book>
                {{ section.settings.booking_button | escape }}
              </button>
            </div>
          </div>
        </div>

        <div class="ls-copyright">
          &copy; {{ 'now' | date: '%Y' }}
          {{ section.settings.brand_name | escape }}
        </div>
      </div>
    </footer>
  {% endif %}

  {% if section.settings.show_floating_button and section.settings.koalendar_embed == blank %}
    <button
      class="ls-button ls-floating"
      type="button"
      data-ls-book
    >
      {{ section.settings.floating_button_label | escape }}
    </button>
  {% endif %}

  <dialog
    class="ls-detail-dialog"
    data-ls-detail-dialog
    aria-labelledby="{{ sid }}-detail-title"
  >
    <div class="ls-modal-inner">
      <button
        class="ls-close"
        type="button"
        data-ls-close
        aria-label="Close preview"
      >
        &times;
      </button>
      <div data-ls-detail-content></div>
    </div>
  </dialog>

  <dialog
    class="ls-booking-dialog"
    data-ls-booking-dialog
    aria-labelledby="{{ sid }}-booking-title"
  >
    <div class="ls-booking-dialog-head">
      <div class="ls-eyebrow">
        {{ section.settings.brand_name | escape }}
      </div>

      <h2 id="{{ sid }}-booking-title">
        {{ section.settings.booking_modal_title | escape }}
      </h2>

      <button
        class="ls-close"
        type="button"
        data-ls-close
        aria-label="Close booking"
      >
        &times;
      </button>
    </div>

    <div data-ls-calendar hidden>
      <iframe
        class="ls-calendar-frame"
        data-ls-calendar-frame
        title="{{ section.settings.booking_modal_title | escape }} — Koalendar"
      ></iframe>

      <div class="ls-calendar-help">
        <a
          class="ls-link"
          data-ls-calendar-link
          target="_blank"
          rel="noopener noreferrer"
        >
          Open calendar in a new tab &rarr;
        </a>
      </div>
    </div>

    <div class="ls-booking-empty" data-ls-booking-empty hidden>
      <p>{{ section.settings.booking_unavailable | escape }}</p>

      {% if request.design_mode %}
        <p>Add your Koalendar booking URL in this section’s settings.</p>
      {% endif %}
    </div>
  </dialog>
  {% if section.settings.koalendar_embed != blank %}
    <div data-ls-koalendar-embed>
      {{ section.settings.koalendar_embed }}
    </div>
  {% endif %}
</la-story-landing>

<script>
  (() => {
    if (customElements.get('la-story-landing')) return;

    class LaStoryLanding extends HTMLElement {
      connectedCallback() {
        if (this.controller) return;

        this.controller = new AbortController();
        this.detailDialog = this.querySelector('[data-ls-detail-dialog]');
        this.bookingDialog = this.querySelector('[data-ls-booking-dialog]');
        this.returnFocus = null;

        const options = { signal: this.controller.signal };

        this.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const bookingButton = target.closest('[data-ls-book]');
          if (bookingButton) {
            event.preventDefault();
            this.openBooking(bookingButton);
            return;
          }

          const previewButton = target.closest('[data-ls-preview]');
          if (previewButton) {
            const template = document.getElementById(
              previewButton.dataset.lsPreview
            );

            if (!template || !this.contains(template)) return;

            const content = this.querySelector('[data-ls-detail-content]');
            content.replaceChildren(template.content.cloneNode(true));

            const heading = content.querySelector('[data-ls-detail-title]');
            if (heading) heading.id = `${this.id}-detail-title`;

            this.openDialog(this.detailDialog, previewButton);
            return;
          }

          const closeButton = target.closest('[data-ls-close]');
          if (closeButton) {
            closeButton.closest('dialog')?.close();
          }
        }, options);

        this.querySelectorAll('dialog').forEach((dialog) => {
          dialog.addEventListener('click', (event) => {
            if (event.target !== dialog) return;

            const bounds = dialog.getBoundingClientRect();
            const outside =
              event.clientX < bounds.left ||
              event.clientX > bounds.right ||
              event.clientY < bounds.top ||
              event.clientY > bounds.bottom;

            if (outside) dialog.close();
          }, options);

          dialog.addEventListener('close', () => {
            if (this.querySelector('dialog[open]')) return;

            this.unlockScroll();

            if (this.returnFocus?.isConnected) {
              this.returnFocus.focus({ preventScroll: true });
            }
          }, options);
        });
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.controller = null;
        this.unlockScroll();
      }

      lockScroll() {
        if (this.hasScrollLock) return;

        const constructor = this.constructor;

        if (!constructor.scrollLocks) {
          constructor.previousOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
        }

        constructor.scrollLocks = (constructor.scrollLocks || 0) + 1;
        this.hasScrollLock = true;
      }

      unlockScroll() {
        if (!this.hasScrollLock) return;

        const constructor = this.constructor;
        constructor.scrollLocks = Math.max(
          0,
          (constructor.scrollLocks || 1) - 1
        );

        if (!constructor.scrollLocks) {
          document.body.style.overflow = constructor.previousOverflow || '';
        }

        this.hasScrollLock = false;
      }

      openDialog(dialog, trigger) {
        const existing = this.querySelector('dialog[open]');

        if (!existing) {
          this.returnFocus = trigger;
        }

        if (existing && existing !== dialog) {
          existing.close();
        }

        this.lockScroll();

        if (!dialog.open) {
          dialog.showModal();
        }

        dialog.querySelector('[data-ls-close]')?.focus();
      }

      openBooking(trigger) {
        const calendar = this.querySelector('[data-ls-calendar]');
        const empty = this.querySelector('[data-ls-booking-empty]');
        const frame = this.querySelector('[data-ls-calendar-frame]');
        const externalLink = this.querySelector('[data-ls-calendar-link]');

        let url = null;

        try {
          const embed = this.querySelector('[data-ls-koalendar-embed]');
          const embedUrl = embed?.textContent.match(
            /["']?url["']?\s*:\s*["'](https:\/\/[^"']+)["']/
          )?.[1];
          const candidate = new URL(embedUrl || this.dataset.bookingUrl);

          if (
            candidate.protocol === 'https:' &&
            (
              candidate.hostname === 'koalendar.com' ||
              candidate.hostname.endsWith('.koalendar.com')
            )
          ) {
            url = candidate;
          }
        } catch (_) {
          url = null;
        }

        if (url) {
          externalLink.href = url.href;
          url.searchParams.set('embed', 'true');

          if (frame.getAttribute('src') !== url.href) {
            frame.src = url.href;
          }

          calendar.hidden = false;
          empty.hidden = true;
        } else {
          calendar.hidden = true;
          empty.hidden = false;
        }

        this.openDialog(this.bookingDialog, trigger);
      }
    }

    customElements.define('la-story-landing', LaStoryLanding);
  })();
</script>

{% schema %}
{
  "name": "LA Story landing",
  "tag": "section",
  "class": "la-story-section",
  "max_blocks": 18,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand and typography"
    },
    {
      "type": "paragraph",
      "content": "Century Gothic Paneuropean is used for branding and controls. GFS Didot is used for headings and body text. Both load from the requested CDN stylesheets."
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "LA STORY"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Navigation logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo image width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 16,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 960,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Buttons and accent",
      "default": "#741D2B"
    },
    {
      "type": "color",
      "id": "dark_color",
      "label": "Dark panels",
      "default": "#3D0D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1D1816"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Main background",
      "default": "#F8F3EC"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Light panels",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "detail_color",
      "label": "Gold details",
      "default": "#B49055"
    },
    {
