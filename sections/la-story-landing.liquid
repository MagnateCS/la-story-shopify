{% comment %}
  ============================================================
  LA STORY — Luxury Services + Booking Landing Page
  ============================================================

  File:
  sections/la-story-luxury-booking.liquid

  Features:
  - Luxury/editorial bridal design
  - Century Gothic branding
  - Serif editorial headings
  - Animated hero entrance
  - Scroll reveal animations
  - Staggered service accordions
  - Individual service pricing
  - Koalendar embed
  - Floating booking CTA
  - Mobile responsive
  - Reduced-motion accessibility
{% endcomment %}

{% liquid
  assign section_id = 'la-story-' | append: section.id
  assign booking_anchor = '#booking-' | append: section.id
  assign booking_target = booking_anchor

  if section.settings.booking_url != blank and section.settings.embed_calendar == false
    assign booking_target = section.settings.booking_url
  endif
%}


<section
  id="{{ section_id }}"
  class="la-story-luxury"
  style="
    --ls-bg: {{ section.settings.background }};
    --ls-surface: {{ section.settings.surface }};
    --ls-heading: {{ section.settings.heading_color }};
    --ls-text: {{ section.settings.text_color }};
    --ls-primary: {{ section.settings.primary_color }};
    --ls-accent: {{ section.settings.accent_color }};
    --ls-border: {{ section.settings.border_color }};
  "
>

  <!-- =====================================================
       HERO
  ====================================================== -->

  <header class="ls-hero">

    <div class="ls-container ls-hero__inner">

      {% if section.settings.logo_text != blank %}
        <div class="ls-wordmark ls-reveal ls-reveal--soft">
          {{ section.settings.logo_text }}
        </div>
      {% endif %}


      <div class="ls-hero__content ls-reveal ls-reveal--hero">

        {% if section.settings.hero_eyebrow != blank %}
          <p class="ls-eyebrow">
            {{ section.settings.hero_eyebrow }}
          </p>
        {% endif %}


        {% if section.settings.hero_heading != blank %}
          <h1 class="ls-display ls-hero__heading">
            {{ section.settings.hero_heading }}
          </h1>
        {% endif %}


        {% if section.settings.hero_description != blank %}
          <div class="ls-hero__description">
            {{ section.settings.hero_description }}
          </div>
        {% endif %}


        <div class="ls-hero__action">

          <a
            href="{{ booking_target }}"
            class="ls-text-link ls-text-link--large"
            {% if section.settings.embed_calendar == false and section.settings.booking_url != blank %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
            {{ section.settings.booking_button_label }}

            <span aria-hidden="true">
              →
            </span>
          </a>

        </div>

      </div>


      {% if section.settings.hero_bottom_text != blank %}
        <div class="ls-hero__bottom ls-reveal ls-reveal--soft">
          {{ section.settings.hero_bottom_text }}
        </div>
      {% endif %}

    </div>

  </header>



  <!-- =====================================================
       SERVICES
  ====================================================== -->

  <section
    id="services-{{ section.id }}"
    class="ls-services"
  >

    <div class="ls-container">


      <!-- INTRO -->

      <div class="ls-intro ls-reveal">

        <div class="ls-intro__label">

          {% if section.settings.services_eyebrow != blank %}
            <p class="ls-eyebrow">
              {{ section.settings.services_eyebrow }}
            </p>
          {% endif %}

        </div>


        <div class="ls-intro__content">

          {% if section.settings.services_heading != blank %}
            <h2 class="ls-display ls-section-heading">
              {{ section.settings.services_heading }}
            </h2>
          {% endif %}


          {% if section.settings.services_description != blank %}
            <div class="ls-intro__description">
              {{ section.settings.services_description }}
            </div>
          {% endif %}

        </div>

      </div>



      <!-- SERVICE ACCORDIONS -->

      <div class="ls-service-list">

        {% assign category_number = 0 %}

        {% for block in section.blocks %}

          {% if block.type == 'service_category' %}

            {% assign category_number = category_number | plus: 1 %}
            {% assign animation_delay = category_number | minus: 1 | times: 90 %}

            <details
              class="ls-category ls-reveal"
              style="--ls-delay: {{ animation_delay }}ms;"
              {% if block.settings.open_by_default %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >

              <summary class="ls-category__summary">

                <div class="ls-category__summary-content">

                  <span class="ls-category__number">

                    {% if category_number < 10 %}
                      0{{ category_number }}
                    {% else %}
                      {{ category_number }}
                    {% endif %}

                  </span>


                  <div class="ls-category__title-wrap">

                    <h3 class="ls-category__title">
                      {{ block.settings.category_title }}
                    </h3>


                    {% if block.settings.category_subtitle != blank %}
                      <p class="ls-category__subtitle">
                        {{ block.settings.category_subtitle }}
                      </p>
                    {% endif %}

                  </div>

                </div>


                <span
                  class="ls-category__icon"
                  aria-hidden="true"
                >
                  <span></span>
                  <span></span>
                </span>

              </summary>



              <div class="ls-category__content">


                {% if block.settings.category_description != blank %}

                  <div class="ls-category__description">
                    {{ block.settings.category_description }}
                  </div>

                {% endif %}



                <div class="ls-service-rows">


                  <!-- SERVICE 1 -->

                  {% if block.settings.service_1_name != blank %}

                    <div class="ls-service-row">

                      <div class="ls-service-row__content">

                        <h4>
                          {{ block.settings.service_1_name }}
                        </h4>

                        {% if block.settings.service_1_description != blank %}
                          <p>
                            {{ block.settings.service_1_description }}
                          </p>
                        {% endif %}

                      </div>


                      {% if block.settings.service_1_price != blank %}

                        <div class="ls-service-row__price">
                          {{ block.settings.service_1_price }}
                        </div>

                      {% endif %}

                    </div>

                  {% endif %}



                  <!-- SERVICE 2 -->

                  {% if block.settings.service_2_name != blank %}

                    <div class="ls-service-row">

                      <div class="ls-service-row__content">

                        <h4>
                          {{ block.settings.service_2_name }}
                        </h4>

                        {% if block.settings.service_2_description != blank %}
                          <p>
                            {{ block.settings.service_2_description }}
                          </p>
                        {% endif %}

                      </div>


                      {% if block.settings.service_2_price != blank %}

                        <div class="ls-service-row__price">
                          {{ block.settings.service_2_price }}
                        </div>

                      {% endif %}

                    </div>

                  {% endif %}



                  <!-- SERVICE 3 -->

                  {% if block.settings.service_3_name != blank %}

                    <div class="ls-service-row">

                      <div class="ls-service-row__content">

                        <h4>
                          {{ block.settings.service_3_name }}
                        </h4>

                        {% if block.settings.service_3_description != blank %}
                          <p>
                            {{ block.settings.service_3_description }}
                          </p>
                        {% endif %}

                      </div>


                      {% if block.settings.service_3_price != blank %}

                        <div class="ls-service-row__price">
                          {{ block.settings.service_3_price }}
                        </div>

                      {% endif %}

                    </div>

                  {% endif %}



                  <!-- SERVICE 4 -->

                  {% if block.settings.service_4_name != blank %}

                    <div class="ls-service-row">

                      <div class="ls-service-row__content">

                        <h4>
                          {{ block.settings.service_4_name }}
                        </h4>

                        {% if block.settings.service_4_description != blank %}
                          <p>
                            {{ block.settings.service_4_description }}
                          </p>
                        {% endif %}

                      </div>


                      {% if block.settings.service_4_price != blank %}

                        <div class="ls-service-row__price">
                          {{ block.settings.service_4_price }}
                        </div>

                      {% endif %}

                    </div>

                  {% endif %}

                </div>



                <div class="ls-category__book">

                  <a
                    href="{{ booking_target }}"
                    class="ls-text-link"
                    {% if section.settings.embed_calendar == false and section.settings.booking_url != blank %}
                      target="_blank"
                      rel="noopener"
                    {% endif %}
                  >

                    Book a fitting

                    <span aria-hidden="true">
                      →
                    </span>

                  </a>

                </div>

              </div>

            </details>

          {% endif %}

        {% endfor %}

      </div>



      {% if section.settings.pricing_note != blank %}

        <div class="ls-pricing-note ls-reveal">
          {{ section.settings.pricing_note }}
        </div>

      {% endif %}

    </div>

  </section>



  <!-- =====================================================
       EDITORIAL STATEMENT
  ====================================================== -->

  {% if section.settings.statement != blank %}

    <section class="ls-statement ls-reveal">

      <div class="ls-container">

        <div class="ls-statement__line"></div>

        <p>
          {{ section.settings.statement }}
        </p>

      </div>

    </section>

  {% endif %}



  <!-- =====================================================
       BOOKING
  ====================================================== -->

  <section
    id="booking-{{ section.id }}"
    class="ls-booking"
  >

    <div class="ls-container">


      <div class="ls-booking__header ls-reveal">

        {% if section.settings.booking_eyebrow != blank %}

          <p class="ls-eyebrow">
            {{ section.settings.booking_eyebrow }}
          </p>

        {% endif %}


        {% if section.settings.booking_heading != blank %}

          <h2 class="ls-display ls-booking__heading">
            {{ section.settings.booking_heading }}
          </h2>

        {% endif %}


        {% if section.settings.booking_description != blank %}

          <div class="ls-booking__description">
            {{ section.settings.booking_description }}
          </div>

        {% endif %}

      </div>



      <div
        class="ls-booking__calendar ls-reveal"
        style="--ls-delay: 120ms;"
      >

        {% if section.settings.booking_url != blank %}


          {% if section.settings.embed_calendar %}

            <div class="ls-calendar">

              <iframe
                src="{{ section.settings.booking_url | escape }}"
                title="Book an appointment with LA Story"
                loading="lazy"
                allow="payment"
              ></iframe>

            </div>


            <div class="ls-calendar__fallback">

              <a
                href="{{ section.settings.booking_url }}"
                target="_blank"
                rel="noopener"
              >
                Open booking calendar

                <span aria-hidden="true">
                  ↗
                </span>
              </a>

            </div>


          {% else %}

            <div class="ls-external-booking">

              <a
                href="{{ section.settings.booking_url }}"
                target="_blank"
                rel="noopener"
                class="ls-primary-button"
              >

                {{ section.settings.booking_button_label }}

                <span aria-hidden="true">
                  →
                </span>

              </a>

            </div>

          {% endif %}


        {% else %}

          <div class="ls-calendar-placeholder">

            <span class="ls-calendar-placeholder__label">
              KOALENDAR
            </span>

            <h3>
              Add your booking calendar
            </h3>

            <p>
              Add your Koalendar booking URL in the Shopify Theme Editor to activate this section.
            </p>

          </div>

        {% endif %}

      </div>

    </div>

  </section>



  <!-- =====================================================
       CLOSING
  ====================================================== -->

  {% if section.settings.closing_text != blank %}

    <footer class="ls-closing ls-reveal">

      <div class="ls-container">

        <p>
          {{ section.settings.closing_text }}
        </p>

      </div>

    </footer>

  {% endif %}



  <!-- =====================================================
       FLOATING BOOKING CTA
  ====================================================== -->

  {% if section.settings.show_floating_button %}

    <a
      href="{{ booking_target }}"
      class="ls-floating-book"
      {% if section.settings.embed_calendar == false and section.settings.booking_url != blank %}
        target="_blank"
        rel="noopener"
      {% endif %}
    >

      <span>
        {{ section.settings.floating_button_label }}
      </span>

      <span
        class="ls-floating-book__arrow"
        aria-hidden="true"
      >
        →
      </span>

    </a>

  {% endif %}

</section>



<style>

  /* =====================================================
     BASE
  ====================================================== */

  #{{ section_id }} {
    background: var(--ls-bg);
    color: var(--ls-text);
    overflow: hidden;

    --ls-sans:
      "Century Gothic",
      "CenturyGothic",
      "Avenir Next",
      Avenir,
      Arial,
      sans-serif;

    --ls-serif:
      "Cormorant Garamond",
      Baskerville,
      "Times New Roman",
      Georgia,
      serif;
  }


  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }


  #{{ section_id }} a {
    color: inherit;
    text-decoration: none;
  }


  #{{ section_id }} .ls-container {
    width: min(calc(100% - 80px), 1360px);
    margin: 0 auto;
  }


  #{{ section_id }} .ls-display {
    margin: 0;

    font-family: var(--ls-serif);

    color: var(--ls-heading);

    font-weight: 400;

    letter-spacing: -0.035em;
  }


  #{{ section_id }} .ls-eyebrow {
    margin: 0;

    font-family: var(--ls-sans);

    color: var(--ls-accent);

    font-size: 10px;

    line-height: 1.4;

    font-weight: 400;

    letter-spacing: 0.22em;

    text-transform: uppercase;
  }



  /* =====================================================
     HERO
  ====================================================== */

  #{{ section_id }} .ls-hero {
    min-height: 92vh;

    display: flex;
  }


  #{{ section_id }} .ls-hero__inner {
    min-height: 92vh;

    display: flex;

    flex-direction: column;

    padding-top: 54px;

    padding-bottom: 50px;
  }


  #{{ section_id }} .ls-wordmark {
    font-family: var(--ls-sans);

    color: var(--ls-heading);

    font-size: clamp(18px, 2vw, 25px);

    line-height: 1;

    font-weight: 400;

    letter-spacing: 0.32em;

    text-transform: uppercase;
  }


  #{{ section_id }} .ls-hero__content {
    width: min(100%, 980px);

    margin: auto;

    padding: clamp(95px, 13vh, 165px) 0;
  }


  #{{ section_id }} .ls-hero__heading {
    max-width: 980px;

    margin-top: 24px;

    font-size: clamp(58px, 8vw, 118px);

    line-height: 0.94;
  }


  #{{ section_id }} .ls-hero__description {
    max-width: 520px;

    margin-top: 38px;

    font-family: var(--ls-sans);

    font-size: 13px;

    line-height: 1.9;

    letter-spacing: 0.01em;
  }


  #{{ section_id }} .ls-hero__description p {
    margin: 0;
  }


  #{{ section_id }} .ls-hero__action {
    margin-top: 40px;
  }


  #{{ section_id }} .ls-hero__bottom {
    font-family: var(--ls-sans);

    font-size: 9px;

    line-height: 1.5;

    letter-spacing: 0.16em;

    text-transform: uppercase;
  }



  /* =====================================================
     TEXT LINKS
  ====================================================== */

  #{{ section_id }} .ls-text-link {
    position: relative;

    display: inline-flex;

    align-items: center;

    gap: 25px;

    padding-bottom: 8px;

    font-family: var(--ls-sans);

    color: var(--ls-primary);

    font-size: 10px;

    line-height: 1.2;

    letter-spacing: 0.15em;

    text-transform: uppercase;

    transition:
      gap 450ms cubic-bezier(0.22, 1, 0.36, 1),
      color 300ms ease;
  }


  #{{ section_id }} .ls-text-link--large {
    font-size: 11px;
  }


  #{{ section_id }} .ls-text-link::after {
    content: "";

    position: absolute;

    left: 0;

    bottom: 0;

    width: 100%;

    height: 1px;

    background: currentColor;

    transform: scaleX(1);

    transform-origin: left center;

    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }


  #{{ section_id }} .ls-text-link > span {
    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }


  #{{ section_id }} .ls-text-link:hover {
    color: var(--ls-accent);

    gap: 32px;
  }


  #{{ section_id }} .ls-text-link:hover::after {
    transform: scaleX(0.35);
  }


  #{{ section_id }} .ls-text-link:hover > span {
    transform: translateX(6px);
  }



  /* =====================================================
     SERVICES
  ====================================================== */

  #{{ section_id }} .ls-services {
    padding:
      clamp(110px, 13vw, 190px)
      0;

    scroll-margin-top: 35px;
  }


  #{{ section_id }} .ls-intro {
    display: grid;

    grid-template-columns:
      minmax(150px, 0.35fr)
      minmax(0, 1fr);

    gap: 60px;

    margin-bottom:
      clamp(75px, 10vw, 130px);
  }


  #{{ section_id }} .ls-intro__content {
    max-width: 820px;
  }


  #{{ section_id }} .ls-section-heading {
    font-size: clamp(50px, 6vw, 84px);

    line-height: 0.98;
  }


  #{{ section_id }} .ls-intro__description {
    max-width: 520px;

    margin-top: 32px;

    font-family: var(--ls-sans);

    font-size: 12px;

    line-height: 1.9;
  }


  #{{ section_id }} .ls-intro__description p {
    margin: 0;
  }



  /* =====================================================
     ACCORDION
  ====================================================== */

  #{{ section_id }} .ls-service-list {
    border-top:
      1px solid
      var(--ls-border);
  }


  #{{ section_id }} .ls-category {
    border-bottom:
      1px solid
      var(--ls-border);
  }


  #{{ section_id }} .ls-category__summary {
    min-height: 138px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    padding: 28px 5px;

    list-style: none;

    cursor: pointer;

    transition:
      padding-left 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }


  #{{ section_id }} .ls-category__summary::-webkit-details-marker {
    display: none;
  }


  #{{ section_id }} .ls-category__summary::marker {
    display: none;
    content: "";
  }


  #{{ section_id }} .ls-category__summary:hover {
    padding-left: 15px;
  }


  #{{ section_id }} .ls-category__summary-content {
    display: flex;

    align-items: flex-start;

    gap: clamp(25px, 5vw, 75px);
  }


  #{{ section_id }} .ls-category__number {
    padding-top: 8px;

    font-family: var(--ls-sans);

    color: var(--ls-accent);

    font-size: 9px;

    letter-spacing: 0.15em;
  }


  #{{ section_id }} .ls-category__title {
    margin: 0;

    font-family: var(--ls-serif);

    color: var(--ls-heading);

    font-size: clamp(31px, 4vw, 52px);

    line-height: 1;

    font-weight: 400;

    letter-spacing: -0.025em;

    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
      color 300ms ease;
  }


  #{{ section_id }}
  .ls-category__summary:hover
  .ls-category__title {
    transform: translateX(5px);
  }


  #{{ section_id }} .ls-category__subtitle {
    max-width: 520px;

    margin: 10px 0 0;

    font-family: var(--ls-sans);

    font-size: 10px;

    line-height: 1.7;

    letter-spacing: 0.02em;
  }



  /* =====================================================
     PLUS / MINUS
  ====================================================== */

  #{{ section_id }} .ls-category__icon {
    position: relative;

    flex: 0 0 36px;

    width: 36px;

    height: 36px;
  }


  #{{ section_id }} .ls-category__icon span {
    position: absolute;

    left: 50%;

    top: 50%;

    width: 18px;

    height: 1px;

    background: var(--ls-primary);

    transform:
      translate(-50%, -50%);

    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms ease;
  }


  #{{ section_id }}
  .ls-category__icon span:nth-child(2) {
    transform:
      translate(-50%, -50%)
      rotate(90deg);
  }


  #{{ section_id }}
  .ls-category[open]
  .ls-category__icon span:nth-child(2) {
    opacity: 0;

    transform:
      translate(-50%, -50%)
      rotate(0);
  }



  /* =====================================================
     ACCORDION CONTENT
  ====================================================== */

  #{{ section_id }} .ls-category__content {
    padding:
      10px
      5px
      65px
      clamp(65px, 9vw, 150px);
  }


  #{{ section_id }}
  .ls-category[open]
  .ls-category__content {
    animation:
      ls-category-open
      650ms
      cubic-bezier(0.22, 1, 0.36, 1)
      both;
  }


  @keyframes ls-category-open {

    from {
      opacity: 0;

      transform: translateY(-12px);
    }

    to {
      opacity: 1;

      transform: translateY(0);
    }

  }


  #{{ section_id }} .ls-category__description {
    max-width: 650px;

    margin-bottom: 45px;

    font-family: var(--ls-sans);

    font-size: 12px;

    line-height: 1.9;
  }


  #{{ section_id }} .ls-category__description p {
    margin: 0;
  }



  /* =====================================================
     SERVICE ROWS
  ====================================================== */

  #{{ section_id }} .ls-service-rows {
    border-top:
      1px solid
      var(--ls-border);
  }


  #{{ section_id }} .ls-service-row {
    min-height: 95px;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: start;

    gap: 40px;

    padding: 24px 0;

    border-bottom:
      1px solid
      var(--ls-border);

    transition:
      padding-left 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }


  #{{ section_id }} .ls-service-row:hover {
    padding-left: 12px;
  }


  #{{ section_id }} .ls-service-row__content {
    max-width: 720px;
  }


  #{{ section_id }} .ls-service-row h4 {
    margin: 0;

    font-family: var(--ls-sans);

    color: var(--ls-heading);

    font-size: 12px;

    line-height: 1.5;

    font-weight: 500;

    letter-spacing: 0.035em;

    transition: color 300ms ease;
  }


  #{{ section_id }} .ls-service-row p {
    max-width: 650px;

    margin: 8px 0 0;

    font-family: var(--ls-sans);

    font-size: 10px;

    line-height: 1.75;
  }


  #{{ section_id }} .ls-service-row__price {
    white-space: nowrap;

    padding-top: 1px;

    font-family: var(--ls-sans);

    color: var(--ls-primary);

    font-size: 10px;

    line-height: 1.5;

    letter-spacing: 0.06em;

    text-transform: uppercase;

    transition: color 300ms ease;
  }


  #{{ section_id }} .ls-service-row:hover h4,
  #{{ section_id }} .ls-service-row:hover .ls-service-row__price {
    color: var(--ls-accent);
  }


  #{{ section_id }} .ls-category__book {
    margin-top: 35px;
  }


  #{{ section_id }} .ls-pricing-note {
    max-width: 700px;

    margin: 35px 0 0 auto;

    font-family: var(--ls-sans);

    font-size: 9px;

    line-height: 1.8;

    letter-spacing: 0.025em;
  }



  /* =====================================================
     STATEMENT
  ====================================================== */

  #{{ section_id }} .ls-statement {
    padding:
      30px
      0
      135px;
