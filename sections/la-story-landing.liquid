<script>
(function () {

  function initLAStorySection(section) {

    if (!section || section.dataset.lsInitialized === 'true') {
      return;
    }

    section.dataset.lsInitialized = 'true';


    /* ===================================================
       REDUCED MOTION
    =================================================== */

    const reduceMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;



    /* ===================================================
       SCROLL REVEALS
    =================================================== */

    const revealElements =
      section.querySelectorAll('.ls-reveal');


    if (reduceMotion) {

      revealElements.forEach(function (element) {
        element.classList.add('is-visible');
      });

    } else {

      const observer =
        new IntersectionObserver(
          function (entries, revealObserver) {

            entries.forEach(function (entry) {

              if (!entry.isIntersecting) {
                return;
              }

              entry.target.classList.add(
                'is-visible'
              );

              revealObserver.unobserve(
                entry.target
              );

            });

          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -8% 0px'
          }
        );


      revealElements.forEach(function (element) {
        observer.observe(element);
      });



      /*
        Hero animation begins immediately.
      */

      const heroRevealElements =
        section.querySelectorAll(
          '.ls-hero .ls-reveal'
        );


      requestAnimationFrame(function () {

        setTimeout(function () {

          heroRevealElements.forEach(
            function (element) {

              element.classList.add(
                'is-visible'
              );

            }
          );

        }, 80);

      });

    }



    /* ===================================================
       ACCORDION BEHAVIOR
    =================================================== */

    const categories =
      section.querySelectorAll(
        '.ls-category'
      );


    categories.forEach(
      function (category) {

        category.addEventListener(
          'toggle',
          function () {

            if (!category.open) {
              return;
            }


            /*
              Only one service category remains
              open at a time.
            */

            categories.forEach(
              function (otherCategory) {

                if (
                  otherCategory !== category &&
                  otherCategory.open
                ) {

                  otherCategory.removeAttribute(
                    'open'
                  );

                }

              }
            );

          }
        );

      }
    );



    /* ===================================================
       SUBTLE DESKTOP HERO PARALLAX
    =================================================== */

    if (
      !reduceMotion &&
      window.innerWidth >= 990
    ) {

      const heroHeading =
        section.querySelector(
          '.ls-hero__heading'
        );


      if (heroHeading) {

        let ticking = false;


        function updateHeroPosition() {

          const sectionRect =
            section.getBoundingClientRect();


          /*
            Only apply while the section hero
            is near the viewport.
          */

          if (
            sectionRect.top > window.innerHeight ||
            sectionRect.bottom < 0
          ) {
            ticking = false;
            return;
          }


          const scrollAmount =
            Math.max(
              0,
              window.scrollY
            );


          const movement =
            Math.min(
              scrollAmount * 0.025,
              20
            );


          heroHeading.style.transform =
            'translate3d(0,' +
            movement +
            'px,0)';


          ticking = false;

        }


        window.addEventListener(
          'scroll',
          function () {

            if (ticking) {
              return;
            }

            ticking = true;

            requestAnimationFrame(
              updateHeroPosition
            );

          },
          {
            passive: true
          }
        );

      }

    }

  }



  /* =====================================================
     INITIAL PAGE LOAD
  ====================================================== */

  function initAllLAStorySections() {

    document
      .querySelectorAll('.la-story-luxury')
      .forEach(function (section) {

        initLAStorySection(section);

      });

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initAllLAStorySections
    );

  } else {

    initAllLAStorySections();

  }



  /* =====================================================
     SHOPIFY THEME EDITOR SUPPORT
  ====================================================== */

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      const section =
        event.target.querySelector(
          '.la-story-luxury'
        ) ||
        (
          event.target.classList &&
          event.target.classList.contains(
            'la-story-luxury'
          )
            ? event.target
            : null
        );


      if (section) {

        delete section.dataset.lsInitialized;

        initLAStorySection(section);

      }

    }
  );

})();
</script>



