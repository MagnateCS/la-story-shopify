{% render 'ls-assets' %}

{% liquid
  assign instagram_url = section.settings.profile_url

  if instagram_url == blank
    assign instagram_url = 'https://www.instagram.com/lastoryofficial/'
  endif
%}

<div
  class="ls-root ls-instagram-root"
  data-ls-section="{{ section.id }}"
  data-ls-animate="{{ section.settings.animate }}"
  style="
    --ls-bg: {{ section.settings.background }};
    --ls-text: {{ section.settings.text_color }};
    --ls-accent: {{ section.settings.accent }};
    --ls-width: {{ section.settings.content_width }}px;
    --ls-pt: {{ section.settings.padding_top }}px;
    --ls-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ls-pad">
    <div class="ls-wrap">

      <!-- Section Heading -->
      <div class="ls-section-head ls-instagram-head ls-reveal">
        <div>
          {% if section.settings.eyebrow != blank %}
            <div class="ls-eyebrow">
              {{ section.settings.eyebrow | escape }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>

        <div class="ls-instagram-intro">
          {% if section.settings.description != blank %}
            <p>{{ section.settings.description | escape }}</p>
          {% endif %}

          {% if section.settings.show_header_link %}
            <a
              class="ls-instagram-profile-link"
              href="{{ instagram_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow {{ section.settings.username | escape }} on Instagram"
            >
              <span class="ls-instagram-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <rect
                    x="3"
                    y="3"
                    width="18"
                    height="18"
                    rx="5"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <circle
                    cx="17.4"
                    cy="6.7"
                    r="1"
                    fill="currentColor"
                  />
                </svg>
              </span>

              <span>
                {{ section.settings.username | escape }}
              </span>

              <span aria-hidden="true">↗</span>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Instagram Posts -->
      {% if section.blocks.size > 0 %}
        <div
          class="
            ls-instagram-grid
            ls-instagram-grid--{{ section.settings.layout }}
          "
          style="
            --ls-instagram-columns:
              {{ section.settings.columns }};
            --ls-instagram-gap:
              {{ section.settings.gap }}px;
          "
        >
          {% for block in section.blocks %}
            {% liquid
              assign post_url = block.settings.post_url

              if post_url == blank
                assign post_url = instagram_url
              endif
            %}

            <article
              class="
                ls-instagram-post
                ls-instagram-post--{{ block.settings.size }}
                ls-reveal
              "
              style="--ls-reveal-delay: {{ forloop.index0 | times: 70 }}ms;"
              {{ block.shopify_attributes }}
            >
              <a
                class="ls-instagram-post-link"
                href="{{ post_url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{% if block.settings.label != blank %}{{ block.settings.label | escape }}{% else %}View LA Story post on Instagram{% endif %}"
              >
                <span class="ls-instagram-photo">
                  {% if block.settings.image %}
                    {{
                      block.settings.image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '360, 540, 720, 900, 1100, 1400',
                        sizes: '(min-width: 990px) 33vw, (min-width: 700px) 50vw, 84vw',
                        loading: 'lazy',
                        class: 'ls-instagram-image'
                    }}
                  {% else %}
                    <span class="ls-instagram-placeholder">
                      {{ 'image' | placeholder_svg_tag }}
                    </span>
                  {% endif %}

                  <span class="ls-instagram-overlay"></span>

                  {% if block.settings.show_icon %}
                    <span
                      class="ls-instagram-post-icon"
                      aria-hidden="true"
                    >
                      {% if block.settings.media_type == 'reel' %}
                        <svg viewBox="0 0 24 24" fill="none">
                          <rect
                            x="3"
                            y="3"
                            width="18"
                            height="18"
                            rx="4"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <path
                            d="M9.5 8.5L15.5 12L9.5 15.5V8.5Z"
                            fill="currentColor"
                          />
                        </svg>
                      {% elsif block.settings.media_type == 'carousel' %}
                        <svg viewBox="0 0 24 24" fill="none">
                          <rect
                            x="7"
                            y="7"
                            width="13"
                            height="13"
                            rx="2"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <path
                            d="M4 16V6C4 4.895 4.895 4 6 4H16"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                          />
                        </svg>
                      {% else %}
                        <svg viewBox="0 0 24 24" fill="none">
                          <rect
                            x="3"
                            y="3"
                            width="18"
                            height="18"
                            rx="5"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <circle
                            cx="12"
                            cy="12"
                            r="4"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <circle
                            cx="17.4"
                            cy="6.7"
                            r="1"
                            fill="currentColor"
                          />
                        </svg>
                      {% endif %}
                    </span>
                  {% endif %}

                  <span class="ls-instagram-post-copy">
                    {% if block.settings.category != blank %}
                      <span class="ls-instagram-category">
                        {{ block.settings.category | escape }}
                      </span>
                    {% endif %}

                    <span class="ls-instagram-action">
                      {% if block.settings.label != blank %}
                        {{ block.settings.label | escape }}
                      {% else %}
                        View on Instagram
                      {% endif %}

                      <span aria-hidden="true">↗</span>
                    </span>
                  </span>
                </span>
              </a>
            </article>
          {% endfor %}
        </div>
      {% elsif request.design_mode %}
        <div class="ls-instagram-empty">
          <div class="ls-eyebrow">Instagram gallery</div>

          <h3>Add your Instagram posts</h3>

          <p>
            Add image blocks to this section and connect each one
            to its Instagram post.
          </p>
        </div>
      {% endif %}

      <!-- Bottom Profile CTA -->
      {% if section.settings.show_bottom_link %}
        <div class="ls-instagram-footer ls-reveal">
          <div class="ls-instagram-footer-line"></div>

          <a
            class="ls-instagram-footer-link"
            href="{{ instagram_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="ls-instagram-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="5"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <circle
                  cx="17.4"
                  cy="6.7"
                  r="1"
                  fill="currentColor"
                />
              </svg>
            </span>

            <span>
              {{ section.settings.button_label | escape }}
            </span>

            <span aria-hidden="true">↗</span>
          </a>

          <div class="ls-instagram-footer-line"></div>
        </div>
      {% endif %}

      {% if section.settings.note != blank %}
        <p class="ls-note">
          {{ section.settings.note | escape }}
        </p>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .ls-instagram-root {
    position: relative;
    overflow: hidden;
    background: var(--ls-bg);
    color: var(--ls-text);
  }

  #shopify-section-{{ section.id }} .ls-instagram-root::before {
    content: "";
    position: absolute;
    top: -280px;
    right: -220px;
    width: 620px;
    height: 620px;
    border: 1px solid color-mix(
      in srgb,
      var(--ls-text) 9%,
      transparent
    );
    border-radius: 50%;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .ls-instagram-root::after {
    content: "";
    position: absolute;
    bottom: -420px;
    left: -320px;
    width: 760px;
    height: 760px;
    border: 1px solid color-mix(
      in srgb,
      var(--ls-text) 7%,
      transparent
    );
    border-radius: 50%;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .ls-pad {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .ls-instagram-head {
    align-items: end;
  }

  #shopify-section-{{ section.id }} .ls-instagram-intro {
    width: min(100%, 440px);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-intro > p {
    margin-bottom: 22px;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-profile-link {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding-bottom: 7px;
    color: var(--ls-text);
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid
      color-mix(
        in srgb,
        var(--ls-text) 40%,
        transparent
      );
    transition:
      color 220ms ease,
      border-color 220ms ease;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-profile-link:hover {
    color: var(--ls-accent);
    border-color: var(--ls-accent);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-icon {
    display: inline-flex;
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .ls-instagram-grid {
    display: grid;
    grid-template-columns:
      repeat(
        var(--ls-instagram-columns),
        minmax(0, 1fr)
      );
    gap: var(--ls-instagram-gap);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-grid--editorial {
    grid-auto-flow: dense;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post {
    position: relative;
    min-width: 0;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post--wide {
    grid-column: span 2;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post--tall {
    grid-row: span 2;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-link {
    display: block;
    height: 100%;
    color: var(--ls-text);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-photo {
    position: relative;
    display: block;
    height: 100%;
    min-height: 390px;
    overflow: hidden;
    background:
      color-mix(
        in srgb,
        var(--ls-bg) 86%,
        var(--ls-text)
      );
    isolation: isolate;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post--tall
  .ls-instagram-photo {
    min-height: 796px;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-image,
  #shopify-section-{{ section.id }}
  .ls-instagram-placeholder,
  #shopify-section-{{ section.id }}
  .ls-instagram-placeholder svg {
    position: absolute;
    z-index: -3;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-image {
    object-fit: cover;
    transform: scale(1.001);
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 500ms ease;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-placeholder svg {
    background:
      color-mix(
        in srgb,
        var(--ls-bg) 84%,
        var(--ls-text)
      );
    fill:
      color-mix(
        in srgb,
        var(--ls-text) 20%,
        transparent
      );
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(16, 9, 11, 0.03) 30%,
        rgba(16, 9, 11, 0.84) 100%
      );
    opacity: 0.85;
    transition: opacity 350ms ease;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-photo::after {
    content: "";
    position: absolute;
    inset: 13px;
    border: 1px solid rgba(255, 253, 249, 0);
    pointer-events: none;
    transition:
      inset 350ms ease,
      border-color 350ms ease;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-link:hover
  .ls-instagram-photo::after {
    inset: 19px;
    border-color: rgba(255, 253, 249, 0.58);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-link:hover
  .ls-instagram-image {
    filter: saturate(0.85);
    transform: scale(1.055);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-link:hover
  .ls-instagram-overlay {
    opacity: 1;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-icon {
    position: absolute;
    top: 24px;
    right: 24px;
    display: grid;
    width: 42px;
    height: 42px;
    color: #fffdf9;
    background: rgba(26, 9, 13, 0.32);
    border: 1px solid rgba(255, 253, 249, 0.3);
    border-radius: 50%;
    backdrop-filter: blur(8px);
    place-items: center;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-icon svg {
    width: 20px;
    height: 20px;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-copy {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    padding: 28px;
    color: #fffdf9;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-category {
    font-size: 10px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.15em;
    opacity: 0.75;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-action {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 5px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    border-bottom: 1px solid rgba(255, 253, 249, 0.48);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-action span {
    transition: transform 220ms ease;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-post-link:hover
  .ls-instagram-action span {
    transform: translate(3px, -3px);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-top: 42px;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-footer-line {
    height: 1px;
    background:
      color-mix(
        in srgb,
        var(--ls-text) 20%,
        transparent
      );
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 14px 20px;
    color: var(--ls-text);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
    border: 1px solid
      color-mix(
        in srgb,
        var(--ls-text) 34%,
        transparent
      );
    transition:
      color 220ms ease,
      background-color 220ms ease,
      border-color 220ms ease,
      transform 220ms ease;
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-footer-link:hover {
    color: var(--ls-bg);
    background: var(--ls-text);
    border-color: var(--ls-text);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-empty {
    padding: 70px 24px;
    text-align: center;
    border: 1px dashed
      color-mix(
        in srgb,
        var(--ls-text) 30%,
        transparent
      );
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-empty h3 {
    margin: 12px 0;
    color: var(--ls-text);
    font-size: clamp(30px, 4vw, 46px);
  }

  #shopify-section-{{ section.id }}
  .ls-instagram-empty p {
    max-width: 480px;
    margin: auto;
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }}
    .ls-instagram-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-post--tall
    .ls-instagram-photo {
      min-height: 780px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }}
    .ls-instagram-head {
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-intro {
      width: 100%;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-grid {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      grid-template-columns: none;
      grid-template-rows: 1fr;
      gap: 10px;
      margin-right: -20px;
      padding-right: 20px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-grid::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-post,
    #shopify-section-{{ section.id }}
    .ls-instagram-post--wide,
    #shopify-section-{{ section.id }}
    .ls-instagram-post--tall {
      grid-row: auto;
      grid-column: auto;
      min-height: 0;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-photo,
    #shopify-section-{{ section.id }}
    .ls-instagram-post--tall
    .ls-instagram-photo {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-post-copy {
      display: block;
      padding: 23px;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-category {
      display: block;
      margin-bottom: 9px;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-footer {
      grid-template-columns: 1fr;
      margin-top: 28px;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-footer-line {
      display: none;
    }

    #shopify-section-{{ section.id }}
    .ls-instagram-footer-link {
      justify-content: center;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }}
    .ls-instagram-image,
    #shopify-section-{{ section.id }}
    .ls-instagram-photo::after,
    #shopify-section-{{ section.id }}
    .ls-instagram-action span,
    #shopify-section-{{ section.id }}
    .ls-instagram-footer-link {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "LA STORY · Instagram",
  "tag": "section",
  "class": "ls-shopify-section",
  "limit": 1,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Follow our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bridal inspiration, beautifully curated."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover new arrivals, atelier moments, and the details that make every LA Story gown unforgettable."
    },
    {
      "type": "text",
      "id": "username",
      "label": "Instagram username",
      "default": "@lastoryofficial"
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "checkbox",
      "id": "show_header_link",
      "label": "Show profile link beside introduction",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_link",
      "label": "Show profile button below gallery",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Profile button label",
      "default": "Follow @lastoryofficial"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Gallery note"
    },
    {
      "type": "header",
      "content": "Gallery layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "grid",
          "label": "Even grid"
        },
        {
          "value": "editorial",
          "label": "Editorial grid"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between posts",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#3D0D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "accent",
