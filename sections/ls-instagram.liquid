{% liquid
  assign instagram_url = section.settings.instagram_url

  if instagram_url == blank
    assign instagram_url = 'https://www.instagram.com/lastoryofficial/'
  endif
%}

<section
  id="InstagramProfile-{{ section.id }}"
  class="instagram-profile-section"
  style="
    --instagram-background: {{ section.settings.background_color }};
    --instagram-text: {{ section.settings.text_color }};
    --instagram-button-background: {{ section.settings.button_background }};
    --instagram-button-text: {{ section.settings.button_text_color }};
    --instagram-max-width: {{ section.settings.max_width }}px;
    --instagram-padding-top: {{ section.settings.padding_top }}px;
    --instagram-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="instagram-profile-container">
    {% if section.settings.eyebrow != blank %}
      <div class="instagram-profile-eyebrow">
        {{ section.settings.eyebrow | escape }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="instagram-profile-heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="instagram-profile-description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="instagram-profile-embed">
      <blockquote
        class="instagram-media"
        data-instgrm-permalink="{{ instagram_url | escape }}"
        data-instgrm-version="14"
        style="
          background: #ffffff;
          border: 0;
          border-radius: 3px;
          box-shadow:
            0 0 1px 0 rgba(0, 0, 0, 0.5),
            0 1px 10px 0 rgba(0, 0, 0, 0.15);
          margin: 0 auto;
          max-width: 540px;
          min-width: 280px;
          padding: 0;
          width: calc(100% - 2px);
        "
      >
        <div class="instagram-profile-placeholder">
          <a
            href="{{ instagram_url | escape }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View LA STORY on Instagram"
          >
            <span class="instagram-profile-placeholder-icon">
              <svg
                viewBox="0 0 24 24"
                width="36"
                height="36"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
              </svg>
            </span>

            <span>View LA STORY on Instagram</span>
          </a>
        </div>
      </blockquote>
    </div>

    {% if section.settings.button_label != blank %}
      <div class="instagram-profile-action">
        <a
          class="instagram-profile-button"
          href="{{ instagram_url | escape }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{{ section.settings.button_label | escape }}</span>

          <svg
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #InstagramProfile-{{ section.id }} {
    background: var(--instagram-background);
    color: var(--instagram-text);
    padding: var(--instagram-padding-top) 20px
      var(--instagram-padding-bottom);
  }

  #InstagramProfile-{{ section.id }} *,
  #InstagramProfile-{{ section.id }} *::before,
  #InstagramProfile-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-container {
    margin: 0 auto;
    max-width: var(--instagram-max-width);
    width: 100%;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    margin-bottom: 14px;
    text-align: center;
    text-transform: uppercase;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-heading {
    color: inherit;
    font-family: var(--font-heading-family, serif);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
    text-align: center;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-description {
    font-size: 16px;
    line-height: 1.7;
    margin: 20px auto 36px;
    max-width: 600px;
    opacity: 0.75;
    text-align: center;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-description p {
    margin: 0;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-embed {
    display: flex;
    justify-content: center;
    margin: 0 auto;
    min-height: 400px;
    width: 100%;
  }

  #InstagramProfile-{{ section.id }} .instagram-media {
    width: 100% !important;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-placeholder {
    align-items: center;
    display: flex;
    justify-content: center;
    min-height: 400px;
    padding: 60px 24px;
    text-align: center;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-placeholder a {
    align-items: center;
    color: #1f1a17;
    display: inline-flex;
    flex-direction: column;
    font-family: Arial, sans-serif;
    font-size: 15px;
    gap: 14px;
    text-decoration: none;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-placeholder-icon {
    display: inline-flex;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-action {
    margin-top: 32px;
    text-align: center;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-button {
    align-items: center;
    background: var(--instagram-button-background);
    border: 1px solid var(--instagram-button-background);
    color: var(--instagram-button-text);
    display: inline-flex;
    font-size: 13px;
    font-weight: 600;
    gap: 12px;
    justify-content: center;
    letter-spacing: 0.08em;
    min-height: 50px;
    padding: 12px 24px;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-button:hover {
    background: transparent;
    color: var(--instagram-text);
    transform: translateY(-2px);
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-button svg {
    transition: transform 180ms ease;
  }

  #InstagramProfile-{{ section.id }} .instagram-profile-button:hover svg {
    transform: translateX(3px);
  }

  @media screen and (max-width: 749px) {
    #InstagramProfile-{{ section.id }} {
      padding-left: 12px;
      padding-right: 12px;
    }

    #InstagramProfile-{{ section.id }} .instagram-profile-heading {
      font-size: clamp(34px, 11vw, 48px);
    }

    #InstagramProfile-{{ section.id }} .instagram-profile-description {
      font-size: 15px;
      margin-bottom: 28px;
      padding: 0 8px;
    }

    #InstagramProfile-{{ section.id }} .instagram-profile-embed {
      min-height: 360px;
    }

    #InstagramProfile-{{ section.id }} .instagram-profile-placeholder {
      min-height: 360px;
    }

    #InstagramProfile-{{ section.id }} .instagram-profile-button {
      width: 100%;
    }
  }
</style>

<script>
  (() => {
    const sectionId = {{ section.id | json }};

    function processInstagramEmbed() {
      if (
        window.instgrm &&
        window.instgrm.Embeds &&
        typeof window.instgrm.Embeds.process === 'function'
      ) {
        window.instgrm.Embeds.process();
      }
    }

    function loadInstagramEmbed() {
      const existingScript = document.querySelector(
        'script[src*="instagram.com/embed.js"]'
      );

      if (existingScript) {
        processInstagramEmbed();

        window.setTimeout(processInstagramEmbed, 300);
        return;
      }

      const script = document.createElement('script');

      script.src = 'https://www.instagram.com/embed.js';
      script.async = true;
      script.onload = processInstagramEmbed;

      document.body.appendChild(script);
    }

    loadInstagramEmbed();

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', (event) => {
        if (String(event.detail.sectionId) === String(sectionId)) {
          loadInstagramEmbed();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Instagram profile",
  "tag": "section",
  "class": "section-instagram-profile",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Behind the scenes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Our Story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover new arrivals, bridal inspiration and moments from our Simi Valley atelier.</p>"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow @lastoryofficial"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f8f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#231f1c"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#231f1c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 540,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Instagram profile"
    }
  ]
}
{% endschema %}