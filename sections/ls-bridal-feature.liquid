{% comment %}LA STORY — self-contained content section. Uses the theme’s installed Century Gothic font.{% endcomment %}
<style>
  #LS-{{ section.id }} {
    background: {{ section.settings.background }};
    color: {{ section.settings.foreground }};
    font-family: "Century Gothic", Arial, sans-serif;
    font-weight: 400;
    padding: 0;
  }

  #LS-{{ section.id }} * {
    box-sizing: border-box;
    font-family: "Century Gothic", Arial, sans-serif !important;
  }

  #LS-{{ section.id }} .ls-wrap {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  #LS-{{ section.id }} .ls-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 0;
    min-height: clamp(560px, 75svh, 900px);
  }

  /* Image: left half, filling the section height */
  #LS-{{ section.id }} .ls-media {
    position: relative;
    min-width: 0;
    background: #e8e2da;
    overflow: hidden;
  }

  #LS-{{ section.id }} .ls-media img,
  #LS-{{ section.id }} .ls-media svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Text: right half */
  #LS-{{ section.id }} .ls-split > div:last-child {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    padding: max(48px, {{ section.settings.spacing }}px)
      clamp(32px, 5vw, 96px);
  }

  #LS-{{ section.id }} h2,
  #LS-{{ section.id }} p {
    margin: 0;
    color: inherit;
    font-weight: 400;
    letter-spacing: normal;
  }

  #LS-{{ section.id }} h2 {
    font-size: clamp(32px, 3.3vw, 50px);
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  #LS-{{ section.id }} .ls-eyebrow {
    margin-bottom: 24px;
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  #LS-{{ section.id }} .ls-body {
    max-width: 48ch;
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.8;
  }

  #LS-{{ section.id }} .ls-body p + p {
    margin-top: 12px;
  }

  #LS-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #LS-{{ section.id }} a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  #LS-{{ section.id }} .ls-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 48px;
    margin-top: 32px;
    padding: 14px 28px;
    border: 1px solid currentColor;
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: .16em;
    text-transform: uppercase;
    text-align: center;
    transition: background .2s, color .2s;
  }

  #LS-{{ section.id }} .ls-button:hover {
    background: {{ section.settings.foreground }};
    color: {{ section.settings.background }};
  }

  @media (max-width: 749px) {
    #LS-{{ section.id }} .ls-split {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    #LS-{{ section.id }} .ls-media {
      aspect-ratio: 4 / 5;
      max-height: 640px;
    }

    #LS-{{ section.id }} .ls-split > div:last-child {
      padding: max(40px, calc({{ section.settings.spacing }}px * .65))
        24px;
    }

    #LS-{{ section.id }} h2 {
      font-size: clamp(30px, 8vw, 40px);
    }

    #LS-{{ section.id }} .ls-eyebrow {
      margin-bottom: 18px;
    }

    #LS-{{ section.id }} .ls-body {
      margin-top: 20px;
    }

    #LS-{{ section.id }} .ls-button {
      width: 100%;
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LS-{{ section.id }} .ls-button {
      transition: none;
    }
  }
</style>
<div id="LS-{{ section.id }}"><div class="ls-wrap"><div class="ls-split"><div class="ls-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '360, 540, 750, 1100, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', style: 'object-position: var(--image-position, center);' }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div><p class="ls-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="ls-body">{{ section.settings.body }}</div>{% if section.settings.link != blank and section.settings.label != blank %}<a class="ls-button" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% elsif request.design_mode %}<p class="ls-body">Choose a button link in this section’s settings.</p>{% endif %}</div></div></div></div>
{% schema %}
{
  "name": "LS \u2014 Bridal feature",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LA STORY BRIDAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A new chapter."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Explore the bridal collection with the personal attention of an atelier.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Discover bridal"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bridal image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f8f2ea"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text",
      "default": "#161616"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LS \u2014 Bridal feature"
    }
  ]
}
{% endschema %}
