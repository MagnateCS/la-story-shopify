    "custom_liquid_fFTVNG": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  LA STORY — INSTAGRAM PROFILE SECTION\n  Paste into a Shopify Custom Liquid section.\n\n  Instagram controls the content inside the embedded card.\n  The surrounding layout, typography, colors and CTA are custom.\n{% endcomment %}\n\n<section\n  class=\"las-instagram\"\n  aria-labelledby=\"las-instagram-title\"\n>\n  <div class=\"las-instagram__ornament las-instagram__ornament--one\"></div>\n  <div class=\"las-instagram__ornament las-instagram__ornament--two\"></div>\n\n  <div class=\"las-instagram__container\">\n\n    <!-- Editorial Content -->\n    <div class=\"las-instagram__content\">\n      <p class=\"las-instagram__eyebrow\">\n        Follow Our Story\n      </p>\n\n      <h2\n        class=\"las-instagram__title\"\n        id=\"las-instagram-title\"\n      >\n        Bridal inspiration,<br>\n        <em>beautifully curated.</em>\n      </h2>\n\n      <div class=\"las-instagram__divider\" aria-hidden=\"true\">\n        <span></span>\n        <svg viewBox=\"0 0 30 12\" fill=\"none\">\n          <path\n            d=\"M1 6C6 6 7 1 12 1C16 1 17 6 21 6C25 6 25 2 29 2\"\n            stroke=\"currentColor\"\n            stroke-width=\"1\"\n          />\n          <path\n            d=\"M1 6C6 6 7 11 12 11C16 11 17 6 21 6C25 6 25 10 29 10\"\n            stroke=\"currentColor\"\n            stroke-width=\"1\"\n          />\n        </svg>\n        <span></span>\n      </div>\n\n      <p class=\"las-instagram__description\">\n        Discover new arrivals, atelier moments and the details that make\n        every LA Story gown unforgettable.\n      </p>\n\n      <a\n        class=\"las-instagram__button\"\n        href=\"https://www.instagram.com/lastoryofficial/\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n        aria-label=\"Follow LA Story on Instagram\"\n      >\n        <span class=\"las-instagram__button-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <rect\n              x=\"3\"\n              y=\"3\"\n              width=\"18\"\n              height=\"18\"\n              rx=\"5\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.5\"\n            />\n            <circle\n              cx=\"12\"\n              cy=\"12\"\n              r=\"4\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.5\"\n            />\n            <circle\n              cx=\"17.4\"\n              cy=\"6.7\"\n              r=\"1\"\n              fill=\"currentColor\"\n            />\n          </svg>\n        </span>\n\n        <span class=\"las-instagram__button-copy\">\n          <small>Follow us on Instagram</small>\n          <strong>@lastoryofficial</strong>\n        </span>\n\n        <span class=\"las-instagram__button-arrow\" aria-hidden=\"true\">\n          ↗\n        </span>\n      </a>\n\n      <p class=\"las-instagram__location\">\n        Simi Valley, California\n      </p>\n    </div>\n\n    <!-- Official Instagram Embed -->\n    <div class=\"las-instagram__embed-column\">\n      <div class=\"las-instagram__frame\">\n        <span\n          class=\"las-instagram__frame-label\"\n          aria-hidden=\"true\"\n        >\n          LA STORY\n        </span>\n\n        <div class=\"las-instagram__embed\">\n          <blockquote\n            class=\"instagram-media\"\n            data-instgrm-permalink=\"https://www.instagram.com/lastoryofficial/?utm_source=ig_embed&amp;utm_campaign=loading\"\n            data-instgrm-version=\"14\"\n          >\n            <div class=\"las-instagram__fallback\">\n              <a\n                href=\"https://www.instagram.com/lastoryofficial/\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n              >\n                <span class=\"las-instagram__fallback-icon\">\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                    <rect\n                      x=\"3\"\n                      y=\"3\"\n                      width=\"18\"\n                      height=\"18\"\n                      rx=\"5\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"1.5\"\n                    />\n                    <circle\n                      cx=\"12\"\n                      cy=\"12\"\n                      r=\"4\"\n                      stroke=\"currentColor\"\n                      stroke-width=\"1.5\"\n                    />\n                    <circle\n                      cx=\"17.4\"\n                      cy=\"6.7\"\n                      r=\"1\"\n                      fill=\"currentColor\"\n                    />\n                  </svg>\n                </span>\n\n                <span>View LA Story on Instagram</span>\n                <strong>@lastoryofficial</strong>\n              </a>\n            </div>\n          </blockquote>\n        </div>\n\n        <span class=\"las-instagram__frame-caption\">\n          Bridal Boutique &amp; Atelier\n        </span>\n      </div>\n\n      <p class=\"las-instagram__note\">\n        New arrivals, bridal inspiration and atelier details\n      </p>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .las-instagram {\n    --las-ivory: #f8efe6;\n    --las-soft-ivory: #fffaf5;\n    --las-wine: #972e38;\n    --las-wine-dark: #6f2029;\n    --las-charcoal: #292524;\n    --las-muted: #746b67;\n    --las-gold: #b99a62;\n\n    position: relative;\n    overflow: hidden;\n    padding: clamp(76px, 10vw, 140px) 24px;\n    color: var(--las-charcoal);\n    background:\n      linear-gradient(\n        135deg,\n        rgba(255, 255, 255, 0.64),\n        transparent 48%\n      ),\n      var(--las-ivory);\n  }\n\n  .las-instagram *,\n  .las-instagram *::before,\n  .las-instagram *::after {\n    box-sizing: border-box;\n  }\n\n  .las-instagram__container {\n    position: relative;\n    z-index: 2;\n    display: grid;\n    grid-template-columns: minmax(0, 0.85fr) minmax(380px, 0.65fr);\n    align-items: center;\n    gap: clamp(54px, 8vw, 120px);\n    width: min(100%, 1180px);\n    margin: 0 auto;\n  }\n\n  .las-instagram__ornament {\n    position: absolute;\n    border: 1px solid rgba(151, 46, 56, 0.11);\n    border-radius: 50%;\n    pointer-events: none;\n  }\n\n  .las-instagram__ornament--one {\n    top: -280px;\n    right: -200px;\n    width: 630px;\n    height: 630px;\n  }\n\n  .las-instagram__ornament--two {\n    bottom: -350px;\n    left: -230px;\n    width: 700px;\n    height: 700px;\n  }\n\n  .las-instagram__eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin: 0 0 22px;\n    color: var(--las-wine);\n    font-family: Inter, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 600;\n    line-height: 1;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n\n  .las-instagram__eyebrow::before {\n    content: \"\";\n    width: 34px;\n    height: 1px;\n    background: currentColor;\n  }\n\n  .las-instagram__title {\n    max-width: 700px;\n    margin: 0;\n    color: var(--las-charcoal);\n    font-family: \"Cormorant Garamond\", \"Times New Roman\", serif;\n    font-size: clamp(48px, 6.2vw, 84px);\n    font-weight: 400;\n    line-height: 0.95;\n    letter-spacing: -0.035em;\n  }\n\n  .las-instagram__title em {\n    color: var(--las-wine);\n    font-weight: 400;\n  }\n\n  .las-instagram__divider {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    width: min(100%, 290px);\n    margin: 32px 0;\n    color: var(--las-gold);\n  }\n\n  .las-instagram__divider span {\n    flex: 1;\n    height: 1px;\n    background: rgba(185, 154, 98, 0.5);\n  }\n\n  .las-instagram__divider svg {\n    flex: 0 0 30px;\n    width: 30px;\n  }\n\n  .las-instagram__description {\n    max-width: 510px;\n    margin: 0 0 36px;\n    color: var(--las-muted);\n    font-family: Inter, Arial, sans-serif;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.8;\n  }\n\n  .las-instagram__button {\n    display: inline-flex;\n    align-items: center;\n    gap: 14px;\n    min-width: min(100%, 310px);\n    padding: 16px 18px;\n    color: white;\n    text-decoration: none;\n    background: var(--las-wine);\n    border: 1px solid var(--las-wine);\n    transition:\n      color 250ms ease,\n      background-color 250ms ease,\n      border-color 250ms ease,\n      transform 250ms ease,\n      box-shadow 250ms ease;\n  }\n\n  .las-instagram__button:hover {\n    color: var(--las-wine);\n    background: transparent;\n    border-color: var(--las-wine);\n    box-shadow: 0 14px 40px rgba(111, 32, 41, 0.12);\n    transform: translateY(-3px);\n  }\n\n  .las-instagram__button-icon {\n    flex: 0 0 34px;\n    width: 34px;\n    height: 34px;\n  }\n\n  .las-instagram__button-icon svg {\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n\n  .las-instagram__button-copy {\n    display: flex;\n    flex: 1;\n    flex-direction: column;\n    gap: 4px;\n    font-family: Inter, Arial, sans-serif;\n  }\n\n  .las-instagram__button-copy small {\n    opacity: 0.78;\n    font-size: 9px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .las-instagram__button-copy strong {\n    font-size: 14px;\n    font-weight: 500;\n  }\n\n  .las-instagram__button-arrow {\n    font-size: 20px;\n    transition: transform 250ms ease;\n  }\n\n  .las-instagram__button:hover\n  .las-instagram__button-arrow {\n    transform: translate(3px, -3px);\n  }\n\n  .las-instagram__location {\n    margin: 22px 0 0;\n    color: var(--las-muted);\n    font-family: Inter, Arial, sans-serif;\n    font-size: 10px;\n    letter-spacing: 0.17em;\n    text-transform: uppercase;\n  }\n\n  .las-instagram__embed-column {\n    width: 100%;\n    max-width: 540px;\n    justify-self: end;\n  }\n\n  .las-instagram__frame {\n    position: relative;\n    padding: 18px;\n    background: var(--las-soft-ivory);\n    border: 1px solid rgba(151, 46, 56, 0.16);\n    box-shadow:\n      0 28px 70px rgba(73, 51, 44, 0.13),\n      0 3px 12px rgba(73, 51, 44, 0.06);\n  }\n\n  .las-instagram__frame::before,\n  .las-instagram__frame::after {\n    content: \"\";\n    position: absolute;\n    width: 46px;\n    height: 46px;\n    pointer-events: none;\n  }\n\n  .las-instagram__frame::before {\n    top: 8px;\n    left: 8px;\n    border-top: 1px solid var(--las-gold);\n    border-left: 1px solid var(--las-gold);\n  }\n\n  .las-instagram__frame::after {\n    right: 8px;\n    bottom: 8px;\n    border-right: 1px solid var(--las-gold);\n    border-bottom: 1px solid var(--las-gold);\n  }\n\n  .las-instagram__frame-label {\n    position: absolute;\n    z-index: 3;\n    top: 50%;\n    left: -25px;\n    padding: 8px 5px;\n    color: var(--las-wine);\n    font-family: \"Cormorant Garamond\", serif;\n    font-size: 11px;\n    letter-spacing: 0.28em;\n    background: var(--las-ivory);\n    writing-mode: vertical-rl;\n    transform: translateY(-50%) rotate(180deg);\n  }\n\n  .las-instagram__frame-caption {\n    display: block;\n    padding: 16px 8px 3px;\n    color: var(--las-muted);\n    font-family: Inter, Arial, sans-serif;\n    font-size: 9px;\n    letter-spacing: 0.2em;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  .las-instagram__embed {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    min-height: 440px;\n    overflow: hidden;\n    background: white;\n  }\n\n  .las-instagram__embed .instagram-media {\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 0 !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n  }\n\n  .las-instagram__fallback {\n    display: grid;\n    min-height: 440px;\n    padding: 40px;\n    place-items: center;\n    color: var(--las-wine);\n    text-align: center;\n    background:\n      linear-gradient(\n        rgba(255, 250, 245, 0.95),\n        rgba(248, 239, 230, 0.95)\n      );\n  }\n\n  .las-instagram__fallback a {\n    display: flex;\n    align-items: center;\n    flex-direction: column;\n    gap: 12px;\n    color: inherit;\n    font-family: Inter, Arial, sans-serif;\n    text-decoration: none;\n  }\n\n  .las-instagram__fallback-icon {\n    display: block;\n    width: 54px;\n    height: 54px;\n    margin-bottom: 8px;\n  }\n\n  .las-instagram__fallback-icon svg {\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n\n  .las-instagram__fallback span:not(\n    .las-instagram__fallback-icon\n  ) {\n    color: var(--las-muted);\n    font-size: 11px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .las-instagram__fallback strong {\n    font-family: \"Cormorant Garamond\", serif;\n    font-size: 30px;\n    font-weight: 500;\n  }\n\n  .las-instagram__note {\n    margin: 18px 0 0;\n    color: var(--las-muted);\n    font-family: Inter, Arial, sans-serif;\n    font-size: 10px;\n    line-height: 1.5;\n    letter-spacing: 0.12em;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  @media screen and (max-width: 900px) {\n    .las-instagram__container {\n      grid-template-columns: 1fr;\n      gap: 58px;\n    }\n\n    .las-instagram__content {\n      text-align: center;\n    }\n\n    .las-instagram__eyebrow,\n    .las-instagram__divider {\n      justify-content: center;\n      margin-right: auto;\n      margin-left: auto;\n    }\n\n    .las-instagram__eyebrow::after {\n      content: \"\";\n      width: 34px;\n      height: 1px;\n      background: currentColor;\n    }\n\n    .las-instagram__title,\n    .las-instagram__description {\n      margin-right: auto;\n      margin-left: auto;\n    }\n\n    .las-instagram__location {\n      text-align: center;\n    }\n\n    .las-instagram__embed-column {\n      justify-self: center;\n    }\n  }\n\n  @media screen and (max-width: 560px) {\n    .las-instagram {\n      padding: 68px 14px;\n    }\n\n    .las-instagram__title {\n      font-size: clamp(44px, 13vw, 62px);\n    }\n\n    .las-instagram__description {\n      font-size: 14px;\n    }\n\n    .las-instagram__button {\n      width: 100%;\n      text-align: left;\n    }\n\n    .las-instagram__frame {\n      padding: 10px;\n    }\n\n    .las-instagram__frame-label {\n      display: none;\n    }\n\n    .las-instagram__embed {\n      min-height: 400px;\n    }\n\n    .las-instagram__frame-caption {\n      padding-top: 14px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .las-instagram__button,\n    .las-instagram__button-arrow {\n      transition: none;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function loadInstagramEmbed() {\n      if (window.instgrm && window.instgrm.Embeds) {\n        window.instgrm.Embeds.process();\n        return;\n      }\n\n      if (\n        document.querySelector(\n          'script[data-las-instagram-script]'\n        )\n      ) {\n        return;\n      }\n\n      var script = document.createElement('script');\n      script.src = 'https://www.instagram.com/embed.js';\n      script.async = true;\n      script.defer = true;\n      script.setAttribute(\n        'data-las-instagram-script',\n        'true'\n      );\n\n      script.onload = function () {\n        if (window.instgrm && window.instgrm.Embeds) {\n          window.instgrm.Embeds.process();\n        }\n      };\n\n      document.body.appendChild(script);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener(\n        'DOMContentLoaded',\n        loadInstagramEmbed\n      );\n    } else {\n      loadInstagramEmbed();\n    }\n\n    document.addEventListener(\n      'shopify:section:load',\n      loadInstagramEmbed\n    );\n  })();\n</script>",
