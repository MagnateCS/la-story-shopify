{% comment %}
  LA Story mobile drawer:
  - Three navigation levels
  - Native finger-controlled dragging
  - Larger labels and descriptions
  - Boutique image
  - Persistent booking button
{% endcomment %}

{% liquid
  assign drawer_description_lines = section.settings.drawer_descriptions | newline_to_br | split: '<br />'
%}

<la-multilevel-drawer>
  <button
    type="button"
    class="la-ml-toggle"
    aria-label="Open navigation"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="LaMenu-{{ section.id }}"
    data-open
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M4 6h16M4 12h16M4 18h16"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <dialog
    id="LaMenu-{{ section.id }}"
    class="la-ml-dialog"
    aria-label="{{ shop.name | escape }} navigation"
  >
    <div class="la-ml-scroller">
      <div class="la-ml-sheet color-{{ section.settings.brand_nav_color_scheme }}">

        <div class="la-ml-header">
          <span class="la-ml-logo">{{ shop.name | escape }}</span>

          <button
            type="button"
            class="la-ml-icon"
            aria-label="Close navigation"
            data-close
            autofocus
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="m6 6 12 12M18 6 6 18"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>

        <nav class="la-ml-navigation" aria-label="Mobile navigation">

          {% comment %} LEVEL 1: BRANDS {% endcomment %}

          <section
            class="la-ml-panel"
            data-panel="root"
            aria-labelledby="LaRootTitle-{{ section.id }}"
          >
            <h2
              id="LaRootTitle-{{ section.id }}"
              class="la-ml-title"
              tabindex="-1"
            >
              Explore {{ shop.name | escape }}
            </h2>

            <ul class="la-ml-list" role="list">
              {% for brand_link in brand_nav_links %}
                {% liquid
                  assign brand_index = forloop.index
                  assign drawer_description = ''
                  assign brand_label_key = brand_link.title | strip | downcase

                  for description_line in drawer_description_lines
                    assign description_parts = description_line | split: '|'
                    assign description_key = description_parts.first | strip | downcase

                    if description_key == brand_label_key and description_parts.size > 1
                      assign drawer_description = description_parts[1] | strip
                      break
                    endif
                  endfor
                %}

                {% capture brand_label %}
                  <span class="la-ml-label-group">
                    <span class="la-ml-label">
                      {{ brand_link.title | escape }}
                    </span>

                    {% if drawer_description != blank %}
                      <span class="la-ml-description">
                        {{ drawer_description | escape }}
                      </span>
                    {% endif %}
                  </span>
                {% endcapture %}

                <li>
                  {% if brand_link.links.size > 0 %}
                    <button
                      type="button"
                      class="la-ml-row la-ml-row--brand"
                      data-next="brand-{{ brand_index }}"
                      aria-controls="LaPanel-{{ section.id }}-{{ brand_index }}"
                      aria-expanded="false"
                    >
                      {{ brand_label }}

                      <svg class="la-ml-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                          d="m9 5 7 7-7 7"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                  {% else %}
                    <a
                      class="la-ml-row la-ml-row--brand"
                      href="{{ brand_link.url }}"
                      draggable="false"
                      {% if brand_link.current %}aria-current="page"{% endif %}
                    >
                      {{ brand_label }}
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>

            {% if section.settings.drawer_image != blank %}
              <figure class="la-ml-boutique">
                {% assign boutique_alt = section.settings.drawer_image.alt | default: 'LA Story boutique' %}

                {{
                  section.settings.drawer_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'la-ml-boutique-image',
                    widths: '320, 480, 640, 900',
                    sizes: '(max-width: 440px) 76vw, 360px',
                    loading: 'lazy',
                    alt: boutique_alt
                }}

                {% if section.settings.drawer_image_caption != blank %}
                  <figcaption class="la-ml-boutique-caption">
                    {{ section.settings.drawer_image_caption | escape }}
                  </figcaption>
                {% endif %}
              </figure>
            {% endif %}
          </section>

          {% comment %} LEVELS 2 AND 3 {% endcomment %}

          {% for brand_link in brand_nav_links %}
            {% assign brand_index = forloop.index %}

            {% if brand_link.links.size > 0 %}
              <section
                id="LaPanel-{{ section.id }}-{{ brand_index }}"
                class="la-ml-panel"
                data-panel="brand-{{ brand_index }}"
                aria-labelledby="LaTitle-{{ section.id }}-{{ brand_index }}"
                hidden
              >
                <button type="button" class="la-ml-back" data-back>
                  <span aria-hidden="true">‹</span>
                  All sections
                </button>

                <h2
                  id="LaTitle-{{ section.id }}-{{ brand_index }}"
                  class="la-ml-title la-ml-title--submenu"
                  tabindex="-1"
                >
                  {{ brand_link.title | escape }}
                </h2>

                <ul class="la-ml-list" role="list">
                  <li>
                    <a
                      class="la-ml-row la-ml-overview"
                      href="{{ brand_link.url }}"
                      draggable="false"
                      {% if brand_link.current %}aria-current="page"{% endif %}
                    >
                      Explore {{ brand_link.title | escape }}
                    </a>
                  </li>

                  {% for child_link in brand_link.links %}
                    {% assign child_index = forloop.index %}

                    <li>
                      {% if child_link.links.size > 0 %}
                        <button
                          type="button"
                          class="la-ml-row"
                          data-next="child-{{ brand_index }}-{{ child_index }}"
                          aria-controls="LaPanel-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                          aria-expanded="false"
                        >
                          <span>{{ child_link.title | escape }}</span>

                          <svg class="la-ml-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path
                              d="m9 5 7 7-7 7"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </button>
                      {% else %}
                        <a
                          class="la-ml-row"
                          href="{{ child_link.url }}"
                          draggable="false"
                          {% if child_link.current %}aria-current="page"{% endif %}
                        >
                          {{ child_link.title | escape }}
                        </a>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </section>

              {% for child_link in brand_link.links %}
                {% assign child_index = forloop.index %}

                {% if child_link.links.size > 0 %}
                  <section
                    id="LaPanel-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                    class="la-ml-panel"
                    data-panel="child-{{ brand_index }}-{{ child_index }}"
                    aria-labelledby="LaTitle-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                    hidden
                  >
                    <button type="button" class="la-ml-back" data-back>
                      <span aria-hidden="true">‹</span>
                      {{ brand_link.title | escape }}
                    </button>

                    <h2
                      id="LaTitle-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                      class="la-ml-title la-ml-title--submenu"
                      tabindex="-1"
                    >
                      {{ child_link.title | escape }}
                    </h2>

                    <ul class="la-ml-list" role="list">
                      <li>
                        <a
                          class="la-ml-row la-ml-overview"
                          href="{{ child_link.url }}"
                          draggable="false"
                          {% if child_link.current %}aria-current="page"{% endif %}
                        >
                          Explore {{ child_link.title | escape }}
                        </a>
                      </li>

                      {% for grandchild_link in child_link.links %}
                        <li>
                          <a
                            class="la-ml-row"
                            href="{{ grandchild_link.url }}"
                            draggable="false"
                            {% if grandchild_link.current %}aria-current="page"{% endif %}
                          >
                            {{ grandchild_link.title | escape }}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </section>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
        </nav>

        <div class="la-ml-footer">
          {% if section.settings.drawer_booking_url != blank %}
            <a
              class="la-ml-booking"
              href="{{ section.settings.drawer_booking_url }}"
              draggable="false"
            >
              <span>
                {{ section.settings.drawer_booking_label | default: 'Book an Appointment' | escape }}
              </span>

              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M4 12h15m-6-6 6 6-6 6"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>

            {% if section.settings.drawer_booking_note != blank %}
              <p class="la-ml-booking-note">
                {{ section.settings.drawer_booking_note | escape }}
              </p>
            {% endif %}
          {% endif %}

          <p class="la-ml-hint" aria-hidden="true">
            Drag left to close
          </p>
        </div>

      </div>

      <div class="la-ml-spacer" aria-hidden="true"></div>
    </div>
  </dialog>
</la-multilevel-drawer>

<style>
  la-multilevel-drawer {
    display: block;
    grid-area: leftA;
    justify-self: start;
  }

  .la-ml-dialog,
  .la-ml-dialog *,
  .la-ml-toggle {
    box-sizing: border-box;
  }

  .la-ml-toggle,
  .la-ml-icon {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 10px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    box-shadow: none;
    cursor: pointer;
  }

  .la-ml-toggle svg,
  .la-ml-icon svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  .la-ml-dialog {
    --la-sheet-width: min(90vw, 420px);
    --la-shade: 0.4;

    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    overflow: hidden;
  }

  .la-ml-dialog::backdrop {
    background: rgb(0 0 0 / var(--la-shade));
  }

  html:has(.la-ml-dialog[open]),
  html:has(.la-ml-dialog[open]) body {
    overflow: hidden;
  }

  .la-ml-scroller {
    display: grid;
    grid-template-columns: var(--la-sheet-width) 100%;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    direction: ltr;
  }

  .la-ml-scroller::-webkit-scrollbar {
    display: none;
  }

  .la-ml-sheet {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-width: 0;
    height: 100%;
    padding:
      max(18px, env(safe-area-inset-top))
      26px
      max(18px, env(safe-area-inset-bottom));
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
    font-family: "Century Gothic", Arial, sans-serif;
  }

  .la-ml-spacer {
    height: 100%;
    scroll-snap-align: end;
  }

  .la-ml-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgb(128 128 128 / 25%);
  }

  .la-ml-logo {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .la-ml-navigation {
    min-height: 0;
    padding: 8px 4px 24px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;
  }

  .la-ml-panel[hidden] {
    display: none !important;
  }

  .la-ml-title {
    margin: 22px 0 12px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
  }

  .la-ml-title--submenu {
    margin: 16px 0;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: 0.025em;
    text-transform: none;
  }

  .la-ml-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .la-ml-list > li {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid rgb(128 128 128 / 22%);
  }

  .la-ml-row {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 60px;
    margin: 0;
    padding: 18px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    text-decoration: none;
    box-shadow: none;
    overflow-wrap: anywhere;
    cursor: pointer;
    -webkit-user-drag: none;
  }

  .la-ml-row--brand {
    min-height: 100px;
    padding: 24px 0;
    letter-spacing: normal;
    text-transform: none;
  }

  .la-ml-label-group {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }

  .la-ml-label {
    font-size: clamp(23px, 6vw, 28px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.025em;
  }

  .la-ml-description {
    display: block;
    max-width: 27ch;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: normal;
    text-transform: none;
  }

  .la-ml-chevron {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .la-ml-overview {
    font-size: 13px;
  }

  .la-ml-back {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin: 0;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.5;
    box-shadow: none;
    cursor: pointer;
  }

  .la-ml-back > span {
    font-size: 26px;
    line-height: 1;
  }

  .la-ml-row[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .la-ml-dialog :is(a, button):focus-visible,
  .la-ml-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .la-ml-boutique {
    margin: 30px 0 0;
  }

  .la-ml-boutique-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .la-ml-boutique-caption {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.65;
    letter-spacing: 0.015em;
  }

  .la-ml-footer {
    padding-top: 18px;
    border-top: 1px solid rgb(128 128 128 / 25%);
  }

  .la-ml-booking {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    min-height: 54px;
    padding: 16px 18px;
    border: 1px solid var(--color-foreground, #111);
    border-radius: 0;
    background: var(--color-foreground, #111);
    color: var(--color-background, #fff);
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.025em;
    text-decoration: none;
    -webkit-user-drag: none;
  }

  .la-ml-booking svg {
    flex-shrink: 0;
  }

  .la-ml-booking-note {
    margin: 12px 0 0;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  .la-ml-hint {
    margin: 10px 0 0;
    padding: 0;
    font-family: inherit;
    font-size: 10px;
    line-height: 1.5;
    text-align: center;
    opacity: 0.65;
  }

  @media (hover: hover) {
    .la-ml-row:hover,
    .la-ml-back:hover {
      text-decoration: underline;
      text-underline-offset: 5px;
    }

    .la-ml-row--brand:hover {
      text-decoration: none;
    }

    .la-ml-row--brand:hover .la-ml-label {
      text-decoration: underline;
      text-underline-offset: 6px;
    }

    .la-ml-booking:hover {
      background: var(--color-background, #fff);
      color: var(--color-foreground, #111);
    }
  }

  @media (max-height: 550px) {
    .la-ml-sheet {
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }

    .la-ml-navigation {
      flex: none;
      overflow: visible;
    }

    .la-ml-header,
    .la-ml-footer {
      flex-shrink: 0;
    }
  }

  @media (max-width: 749px) {
    .la-desktop-brand-subnav {
      display: none;
    }
  }

  #header-component[data-menu-style="drawer"] .la-desktop-brand-subnav {
    display: none;
  }

  @media (min-width: 750px) {
    #header-component:not([data-menu-style="drawer"]) la-multilevel-drawer {
      display: none;
    }
  }
</style>

<script type="module">
  if (!customElements.get('la-multilevel-drawer')) {
    customElements.define('la-multilevel-drawer', class extends HTMLElement {
      connectedCallback() {
        if (this.controller) return;

        this.controller = new AbortController();
        const { signal } = this.controller;

        const dialog = this.querySelector('dialog');
        const opener = this.querySelector('[data-open]');
        const scroller = this.querySelector('.la-ml-scroller');
        const sheet = this.querySelector('.la-ml-sheet');
        const navigation = this.querySelector('.la-ml-navigation');
        const header = this.closest('header-component');

        const panels = new Map(
          [...this.querySelectorAll('[data-panel]')].map(panel => [
            panel.dataset.panel,
            panel
          ])
        );

        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );

        this.dialog = dialog;
        this.history = [];
        this.current = 'root';
        this.armed = false;
        this.animation = null;
        this.suppressClickUntil = 0;

        const resetScroll = () => {
          sheet.scrollTop = 0;
          navigation.scrollTop = 0;
        };

        const showPanel = (key, direction = 1, focusTarget = null) => {
          const next = panels.get(key);
          if (!next) return;

          this.animation?.cancel();

          panels.forEach(panel => {
            panel.hidden = panel !== next;
          });

          this.current = key;
          resetScroll();

          if (!reducedMotion.matches) {
            this.animation = next.animate(
              [
                {
                  opacity: 0,
                  transform: `translateX(${direction * 24}px)`
                },
                {
                  opacity: 1,
                  transform: 'translateX(0)'
                }
              ],
              {
                duration: 180,
                easing: 'ease-out'
              }
            );
          }

          const target = focusTarget || next.querySelector('h2');
          target?.focus({ preventScroll: true });
        };

        const resetPanels = () => {
          this.animation?.cancel();
          this.history = [];
          this.current = 'root';

          panels.forEach((panel, key) => {
            panel.hidden = key !== 'root';
          });

          this.querySelectorAll('[data-next]').forEach(button => {
            button.setAttribute('aria-expanded', 'false');
          });

          resetScroll();
        };

        const finishClose = () => {
          this.armed = false;

          if (dialog.open) {
            dialog.close();
          }

          opener.setAttribute('aria-expanded', 'false');
        };

        const close = (immediate = false) => {
          if (!dialog.open) return;

          if (immediate || reducedMotion.matches) {
            finishClose();
            return;
          }

          scroller.scrollTo({
            left: sheet.offsetWidth,
            behavior: 'smooth'
          });
        };

        const updateShade = () => {
          const width = Math.max(1, sheet.offsetWidth);
          const openness = Math.max(
            0,
            Math.min(1, 1 - scroller.scrollLeft / width)
          );

          dialog.style.setProperty(
            '--la-shade',
            String(openness * 0.4)
          );
        };

        opener.addEventListener('click', () => {
          if (dialog.open) return;

          resetPanels();
          this.suppressClickUntil = 0;
          dialog.style.setProperty('--la-shade', '0.4');
          dialog.showModal();

          scroller.scrollTo({
            left: 0,
            behavior: 'instant'
          });

          this.armed = true;
          opener.setAttribute('aria-expanded', 'true');
        }, { signal });

        dialog.addEventListener('cancel', event => {
          event.preventDefault();
          close();
        }, { signal });

        dialog.addEventListener('close', () => {
          if (dialog.open) return;

          this.armed = false;
          opener.setAttribute('aria-expanded', 'false');
          resetPanels();

          if (opener.getClientRects().length) {
            opener.focus({ preventScroll: true });
          }
        }, { signal });

        scroller.addEventListener('scroll', () => {
          updateShade();
          this.suppressClickUntil = performance.now() + 150;
        }, { signal, passive: true });

        this.visibilityObserver = new IntersectionObserver(entries => {
          const entry = entries.at(-1);

          if (
            dialog.open &&
            this.armed &&
            entry.intersectionRatio < 0.002 &&
            scroller.scrollLeft >= sheet.offsetWidth - 2
          ) {
            finishClose();
          }
        }, {
          root: scroller,
          threshold: [0, 0.002, 1]
        });

        this.visibilityObserver.observe(sheet);

        dialog.addEventListener('click', event => {
          if (
            event.detail !== 0 &&
            performance.now() < this.suppressClickUntil
          ) {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          if (
            event.target.closest('[data-close]') ||
            !sheet.contains(event.target)
          ) {
            close();
            return;
          }

          const nextButton = event.target.closest('[data-next]');

          if (nextButton) {
            this.history.push({
              panel: this.current,
              trigger: nextButton
            });

            nextButton.setAttribute('aria-expanded', 'true');
            showPanel(nextButton.dataset.next, 1);
            return;
          }

          if (event.target.closest('[data-back]')) {
            const previous = this.history.pop();
            if (!previous) return;

            previous.trigger.setAttribute('aria-expanded', 'false');
            showPanel(previous.panel, -1, previous.trigger);
            return;
          }

          if (event.target.closest('a[href]')) {
            close(true);
          }
        }, { signal, capture: true });

        const syncLayout = () => {
          if (!dialog.open) return;

          if (
            window.matchMedia('(min-width: 750px)').matches &&
            header?.dataset.menuStyle !== 'drawer'
          ) {
            close(true);
          }
        };

        window.addEventListener('resize', syncLayout, { signal });

        this.headerObserver = new MutationObserver(syncLayout);

        if (header) {
          this.headerObserver.observe(header, {
            attributes: true,
            attributeFilter: ['data-menu-style']
          });
        }
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.visibilityObserver?.disconnect();
        this.headerObserver?.disconnect();
        this.animation?.cancel();

        if (this.dialog?.open) {
          this.dialog.close();
        }

        this.controller = null;
      }
    });
  }
</script>