{% comment %}
  Mobile brand navigation.
  Uses the existing brand menu and preserves its URLs.
  Swipe left within the drawer to close.
{% endcomment %}

<la-brand-drawer>
  <button
    class="la-drawer-toggle"
    type="button"
    aria-label="Open navigation"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="LaBrandDrawer-{{ section.id }}"
    data-la-open
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M4 6h16M4 12h16M4 18h16"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <dialog
    id="LaBrandDrawer-{{ section.id }}"
    class="la-drawer color-{{ section.settings.brand_nav_color_scheme }}"
    aria-labelledby="LaBrandDrawerTitle-{{ section.id }}"
  >
    <div class="la-drawer__surface">
      <div class="la-drawer__heading">
        <span
          id="LaBrandDrawerTitle-{{ section.id }}"
          class="la-drawer__title"
        >
          {{ shop.name | escape }}
        </span>

        <button
          class="la-drawer__close"
          type="button"
          aria-label="Close navigation"
          data-la-close
          autofocus
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m6 6 12 12M18 6 6 18"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <nav class="la-drawer__nav" aria-label="Mobile brand navigation">
        {% for brand_link in brand_nav_links %}
          {% if brand_link.links.size > 0 %}
            <details
              class="la-drawer__group"
              {% if brand_link.handle == active_brand_link.handle %}
                open
              {% endif %}
            >
              <summary class="la-drawer__brand">
                <span>{{ brand_link.title | escape }}</span>
                <span class="la-drawer__indicator" aria-hidden="true">+</span>
              </summary>

              <ul class="la-drawer__links" role="list">
                <li>
                  <a
                    href="{{ brand_link.url }}"
                    {% if brand_link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    Explore {{ brand_link.title | escape }}
                  </a>
                </li>

                {% for child_link in brand_link.links %}
                  <li>
                    <a
                      href="{{ child_link.url }}"
                      {% if child_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ child_link.title | escape }}
                    </a>

                    {% if child_link.links.size > 0 %}
                      <ul class="la-drawer__nested" role="list">
                        {% for grandchild_link in child_link.links %}
                          <li>
                            <a
                              href="{{ grandchild_link.url }}"
                              {% if grandchild_link.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ grandchild_link.title | escape }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% else %}
            <a
              class="la-drawer__brand la-drawer__standalone"
              href="{{ brand_link.url }}"
              {% if brand_link.current %}
                aria-current="page"
              {% endif %}
            >
              {{ brand_link.title | escape }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>

      <p class="la-drawer__hint" aria-hidden="true">
        Swipe left to close
      </p>
    </div>
  </dialog>
</la-brand-drawer>

<style>
  la-brand-drawer {
    display: block;
    grid-area: leftA;
    justify-self: start;
  }

  .la-drawer-toggle,
  .la-drawer__close {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    min-height: 48px;
    padding: 12px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    box-shadow: none;
  }

  .la-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(88vw, 390px);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
    font-family: "Century Gothic", Arial, sans-serif;
    overflow: auto;
    overscroll-behavior: contain;
    touch-action: pan-y pinch-zoom;
    transform: translateX(-100%);
    transition:
      transform 240ms ease,
      display 240ms allow-discrete,
      overlay 240ms allow-discrete;
  }

  .la-drawer[open] {
    transform: translateX(0);
  }

  @starting-style {
    .la-drawer[open] {
      transform: translateX(-100%);
    }
  }

  .la-drawer::backdrop {
    background: rgb(0 0 0 / 40%);
    opacity: 0;
    transition:
      opacity 240ms ease,
      display 240ms allow-discrete,
      overlay 240ms allow-discrete;
  }

  .la-drawer[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .la-drawer[open]::backdrop {
      opacity: 0;
    }
  }

  html:has(.la-drawer[open]),
  html:has(.la-drawer[open]) body {
    overflow: hidden;
  }

  .la-drawer__surface {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding:
      max(18px, env(safe-area-inset-top))
      24px
      max(24px, env(safe-area-inset-bottom));
  }

  .la-drawer__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid currentColor;
  }

  .la-drawer__title {
    font-size: 19px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .la-drawer__nav {
    margin-top: 16px;
  }

  .la-drawer__group,
  .la-drawer__standalone {
    border-bottom: 1px solid rgb(128 128 128 / 25%);
  }

  .la-drawer__brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 18px 0;
    font-family: inherit;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .la-drawer__brand::-webkit-details-marker {
    display: none;
  }

  .la-drawer__indicator {
    font-size: 24px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .la-drawer__group[open] > summary .la-drawer__indicator {
    transform: rotate(45deg);
  }

  .la-drawer__links,
  .la-drawer__nested {
    margin: 0;
    padding: 0 0 16px;
    list-style: none;
  }

  .la-drawer__nested {
    padding: 0 0 8px 18px;
  }

  .la-drawer__links a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 4px;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.5;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .la-drawer a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .la-drawer a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .la-drawer :is(a, button, summary):focus-visible,
  .la-drawer-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .la-drawer__hint {
    margin: auto 0 0;
    padding-top: 32px;
    font-size: 12px;
    opacity: 0.65;
  }

  @media (max-width: 749px) {
    .la-desktop-brand-subnav {
      display: none;
    }
  }

  #header-component[data-menu-style="drawer"] .la-desktop-brand-subnav {
    display: none;
  }

  @media (min-width: 750px) {
    #header-component:not([data-menu-style="drawer"]) la-brand-drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .la-drawer,
    .la-drawer::backdrop,
    .la-drawer__indicator {
      transition: none;
    }
  }
</style>

<script type="module">
  if (!customElements.get('la-brand-drawer')) {
    customElements.define('la-brand-drawer', class extends HTMLElement {
      connectedCallback() {
        if (this.controller) return;

        this.controller = new AbortController();
        const { signal } = this.controller;
        const dialog = this.querySelector('dialog');
        const opener = this.querySelector('[data-la-open]');
        const closer = this.querySelector('[data-la-close]');
        const header = this.closest('header-component');

        this.dialog = dialog;

        const close = () => {
          if (dialog.open) dialog.close();
        };

        opener.addEventListener('click', () => {
          if (!dialog.open) {
            dialog.showModal();
            opener.setAttribute('aria-expanded', 'true');
          }
        }, { signal });

        closer.addEventListener('click', close, { signal });

        // Native dialog also handles Escape and keyboard focus containment.
        dialog.addEventListener('close', () => {
          opener.setAttribute('aria-expanded', 'false');
          this.start = null;

          if (opener.getClientRects().length) {
            opener.focus({ preventScroll: true });
          }
        }, { signal });

        // Backdrop clicks target the dialog, so check its actual bounds.
        const outside = (event) => {
          const rect = dialog.getBoundingClientRect();
          return (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          );
        };

        dialog.addEventListener('pointerdown', (event) => {
          this.backdropPress = outside(event);

          if (event.pointerType !== 'touch' || !event.isPrimary) return;
          if (this.backdropPress) return;

          this.start = {
            id: event.pointerId,
            x: event.clientX,
            y: event.clientY
          };
        }, { signal, passive: true });

        // No preventDefault: vertical scrolling and pinch zoom remain native.
        dialog.addEventListener('pointerup', (event) => {
          if (!this.start || event.pointerId !== this.start.id) return;

          const dx = event.clientX - this.start.x;
          const dy = event.clientY - this.start.y;
          this.start = null;

          if (dx < -72 && Math.abs(dx) > Math.abs(dy) * 1.5) {
            this.suppressClickUntil = performance.now() + 500;
            close();
          }
        }, { signal, passive: true });

        dialog.addEventListener('pointercancel', () => {
          this.start = null;
          this.backdropPress = false;
        }, { signal, passive: true });

        dialog.addEventListener('click', (event) => {
          if (performance.now() < (this.suppressClickUntil || 0)) {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          if (this.backdropPress && outside(event)) close();
          this.backdropPress = false;

          if (event.target.closest('a[href]')) close();
        }, { signal, capture: true });

        // Close when the theme switches back to the desktop menu.
        const syncLayout = () => {
          const desktop = window.matchMedia('(min-width: 750px)').matches;
          if (desktop && header?.dataset.menuStyle !== 'drawer') close();
        };

        window.addEventListener('resize', syncLayout, { signal });

        this.observer = new MutationObserver(syncLayout);
        if (header) {
          this.observer.observe(header, {
            attributes: true,
            attributeFilter: ['data-menu-style']
          });
        }
      }

      disconnectedCallback() {
        if (this.dialog?.open) this.dialog.close();
        this.controller?.abort();
        this.observer?.disconnect();
        this.controller = null;
      }
    });
  }
</script>