{% comment %}
  LA Story multi-level mobile navigation.

  Level 1: Brands
  Level 2: Brand child links
  Level 3: Grandchild links

  Native horizontal scrolling controls drawer dragging.
{% endcomment %}

<la-multilevel-drawer>
  <button
    type="button"
    class="la-ml-toggle"
    aria-label="Open navigation"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="LaMenu-{{ section.id }}"
    data-open
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M4 6h16M4 12h16M4 18h16"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <dialog
    id="LaMenu-{{ section.id }}"
    class="la-ml-dialog"
    aria-label="{{ shop.name | escape }} navigation"
  >
    <div class="la-ml-scroller">
      <div
        class="la-ml-sheet color-{{ section.settings.brand_nav_color_scheme }}"
      >
        <div class="la-ml-header">
          <span class="la-ml-logo">
            {{ shop.name | escape }}
          </span>

          <button
            type="button"
            class="la-ml-icon"
            aria-label="Close navigation"
            data-close
            autofocus
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="m6 6 12 12M18 6 6 18"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>

        <nav class="la-ml-navigation" aria-label="Mobile navigation">
          {% comment %} LEVEL 1 {% endcomment %}

          <section
            class="la-ml-panel"
            data-panel="root"
            aria-labelledby="LaRootTitle-{{ section.id }}"
          >
            <h2
              id="LaRootTitle-{{ section.id }}"
              class="la-ml-title"
              tabindex="-1"
            >
              Explore
            </h2>

            <ul class="la-ml-list" role="list">
              {% for brand_link in brand_nav_links %}
                {% assign brand_index = forloop.index %}

                <li>
                  {% if brand_link.links.size > 0 %}
                    <button
                      type="button"
                      class="la-ml-row la-ml-row--brand"
                      data-next="brand-{{ brand_index }}"
                      aria-controls="LaPanel-{{ section.id }}-{{ brand_index }}"
                      aria-expanded="false"
                    >
                      <span>{{ brand_link.title | escape }}</span>
                      <span class="la-ml-arrow" aria-hidden="true">›</span>
                    </button>
                  {% else %}
                    <a
                      class="la-ml-row la-ml-row--brand"
                      href="{{ brand_link.url }}"
                      draggable="false"
                      {% if brand_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ brand_link.title | escape }}
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </section>

          {% comment %} LEVELS 2 AND 3 {% endcomment %}

          {% for brand_link in brand_nav_links %}
            {% assign brand_index = forloop.index %}

            {% if brand_link.links.size > 0 %}
              <section
                id="LaPanel-{{ section.id }}-{{ brand_index }}"
                class="la-ml-panel"
                data-panel="brand-{{ brand_index }}"
                aria-labelledby="LaTitle-{{ section.id }}-{{ brand_index }}"
                hidden
              >
                <button type="button" class="la-ml-back" data-back>
                  <span aria-hidden="true">‹</span>
                  All sections
                </button>

                <h2
                  id="LaTitle-{{ section.id }}-{{ brand_index }}"
                  class="la-ml-title"
                  tabindex="-1"
                >
                  {{ brand_link.title | escape }}
                </h2>

                <ul class="la-ml-list" role="list">
                  <li>
                    <a
                      class="la-ml-row la-ml-overview"
                      href="{{ brand_link.url }}"
                      draggable="false"
                      {% if brand_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      Explore {{ brand_link.title | escape }}
                    </a>
                  </li>

                  {% for child_link in brand_link.links %}
                    {% assign child_index = forloop.index %}

                    <li>
                      {% if child_link.links.size > 0 %}
                        <button
                          type="button"
                          class="la-ml-row"
                          data-next="child-{{ brand_index }}-{{ child_index }}"
                          aria-controls="LaPanel-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                          aria-expanded="false"
                        >
                          <span>{{ child_link.title | escape }}</span>
                          <span class="la-ml-arrow" aria-hidden="true">›</span>
                        </button>
                      {% else %}
                        <a
                          class="la-ml-row"
                          href="{{ child_link.url }}"
                          draggable="false"
                          {% if child_link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ child_link.title | escape }}
                        </a>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </section>

              {% for child_link in brand_link.links %}
                {% assign child_index = forloop.index %}

                {% if child_link.links.size > 0 %}
                  <section
                    id="LaPanel-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                    class="la-ml-panel"
                    data-panel="child-{{ brand_index }}-{{ child_index }}"
                    aria-labelledby="LaTitle-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                    hidden
                  >
                    <button type="button" class="la-ml-back" data-back>
                      <span aria-hidden="true">‹</span>
                      {{ brand_link.title | escape }}
                    </button>

                    <h2
                      id="LaTitle-{{ section.id }}-{{ brand_index }}-{{ child_index }}"
                      class="la-ml-title"
                      tabindex="-1"
                    >
                      {{ child_link.title | escape }}
                    </h2>

                    <ul class="la-ml-list" role="list">
                      <li>
                        <a
                          class="la-ml-row la-ml-overview"
                          href="{{ child_link.url }}"
                          draggable="false"
                          {% if child_link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          Explore {{ child_link.title | escape }}
                        </a>
                      </li>

                      {% for grandchild_link in child_link.links %}
                        <li>
                          <a
                            class="la-ml-row"
                            href="{{ grandchild_link.url }}"
                            draggable="false"
                            {% if grandchild_link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ grandchild_link.title | escape }}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </section>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
        </nav>

        <p class="la-ml-hint" aria-hidden="true">
          Drag left to close
        </p>
      </div>

      <div class="la-ml-spacer" aria-hidden="true"></div>
    </div>
  </dialog>
</la-multilevel-drawer>

<style>
  la-multilevel-drawer {
    display: block;
    grid-area: leftA;
    justify-self: start;
  }

  .la-ml-dialog,
  .la-ml-dialog *,
  .la-ml-toggle {
    box-sizing: border-box;
  }

  .la-ml-toggle,
  .la-ml-icon {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 10px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    box-shadow: none;
    cursor: pointer;
  }

  .la-ml-toggle svg,
  .la-ml-icon svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  .la-ml-dialog {
    --la-sheet-width: min(88vw, 390px);
    --la-shade: 0.4;

    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    overflow: hidden;
  }

  .la-ml-dialog::backdrop {
    background: rgb(0 0 0 / var(--la-shade));
  }

  html:has(.la-ml-dialog[open]),
  html:has(.la-ml-dialog[open]) body {
    overflow: hidden;
  }

  .la-ml-scroller {
    display: grid;
    grid-template-columns: var(--la-sheet-width) 100%;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    direction: ltr;
  }

  .la-ml-scroller::-webkit-scrollbar {
    display: none;
  }

  .la-ml-sheet {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding:
      max(18px, env(safe-area-inset-top))
      24px
      max(24px, env(safe-area-inset-bottom));
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    scroll-snap-align: start;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
    font-family: "Century Gothic", Arial, sans-serif;
  }

  .la-ml-spacer {
    height: 100%;
    scroll-snap-align: end;
  }

  .la-ml-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid currentColor;
  }

  .la-ml-logo {
    font-size: 19px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .la-ml-navigation {
    padding-top: 12px;
  }

  .la-ml-panel[hidden] {
    display: none !important;
  }

  .la-ml-title {
    margin: 20px 0;
    font-family: inherit;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: inherit;
  }

  .la-ml-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .la-ml-list > li {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid rgb(128 128 128 / 22%);
  }

  .la-ml-row {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 58px;
    margin: 0;
    padding: 16px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    text-decoration: none;
    box-shadow: none;
    overflow-wrap: anywhere;
    cursor: pointer;
    -webkit-user-drag: none;
  }

  .la-ml-row--brand {
    min-height: 68px;
    font-size: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .la-ml-arrow {
    flex-shrink: 0;
    font-size: 28px;
    line-height: 1;
  }

  .la-ml-overview {
    font-size: 13px;
  }

  .la-ml-back {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin: 0;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.5;
    box-shadow: none;
    cursor: pointer;
  }

  .la-ml-back > span {
    font-size: 26px;
    line-height: 1;
  }

  .la-ml-row[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .la-ml-dialog :is(a, button):focus-visible,
  .la-ml-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .la-ml-hint {
    margin: auto 0 0;
    padding-top: 32px;
    font-family: inherit;
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.6;
  }

  @media (hover: hover) {
    .la-ml-row:hover,
    .la-ml-back:hover {
      text-decoration: underline;
      text-underline-offset: 5px;
    }
  }

  @media (max-width: 749px) {
    .la-desktop-brand-subnav {
      display: none;
    }
  }

  #header-component[data-menu-style="drawer"]
    .la-desktop-brand-subnav {
    display: none;
  }

  @media (min-width: 750px) {
    #header-component:not([data-menu-style="drawer"])
      la-multilevel-drawer {
      display: none;
    }
  }
</style>

<script type="module">
  if (!customElements.get('la-multilevel-drawer')) {
    customElements.define('la-multilevel-drawer', class extends HTMLElement {
      connectedCallback() {
        if (this.controller) return;

        this.controller = new AbortController();
        const { signal } = this.controller;

        const dialog = this.querySelector('dialog');
        const opener = this.querySelector('[data-open]');
        const scroller = this.querySelector('.la-ml-scroller');
        const sheet = this.querySelector('.la-ml-sheet');
        const header = this.closest('header-component');

        const panels = new Map(
          [...this.querySelectorAll('[data-panel]')].map(panel => [
            panel.dataset.panel,
            panel
          ])
        );

        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );

        this.dialog = dialog;
        this.history = [];
        this.current = 'root';
        this.armed = false;
        this.animation = null;
        this.suppressClickUntil = 0;

        const showPanel = (key, direction = 1, focusTarget = null) => {
          const next = panels.get(key);
          if (!next) return;

          this.animation?.cancel();

          panels.forEach(panel => {
            panel.hidden = panel !== next;
          });

          this.current = key;
          sheet.scrollTop = 0;

          if (!reducedMotion.matches) {
            this.animation = next.animate(
              [
                {
                  opacity: 0,
                  transform: `translateX(${direction * 24}px)`
                },
                {
                  opacity: 1,
                  transform: 'translateX(0)'
                }
              ],
              {
                duration: 180,
                easing: 'ease-out'
              }
            );
          }

          const target = focusTarget || next.querySelector('h2');
          target?.focus({ preventScroll: true });
        };

        const resetPanels = () => {
          this.animation?.cancel();
          this.history = [];
          this.current = 'root';

          panels.forEach((panel, key) => {
            panel.hidden = key !== 'root';
          });

          this.querySelectorAll('[data-next]').forEach(button => {
            button.setAttribute('aria-expanded', 'false');
          });

          sheet.scrollTop = 0;
        };

        const finishClose = () => {
          this.armed = false;

          if (dialog.open) dialog.close();

          opener.setAttribute('aria-expanded', 'false');
        };

        const close = (immediate = false) => {
          if (!dialog.open) return;

          if (immediate || reducedMotion.matches) {
            finishClose();
            return;
          }

          // Scroll the sheet completely out of view.
          // IntersectionObserver finishes the dismissal.
          scroller.scrollTo({
            left: sheet.offsetWidth,
            behavior: 'smooth'
          });
        };

        const updateShade = () => {
          const width = Math.max(1, sheet.offsetWidth);
          const openness = Math.max(
            0,
            Math.min(1, 1 - scroller.scrollLeft / width)
          );

          dialog.style.setProperty(
            '--la-shade',
            String(openness * 0.4)
          );
        };

        opener.addEventListener('click', () => {
          if (dialog.open) return;

          resetPanels();
          this.suppressClickUntil = 0;
          dialog.style.setProperty('--la-shade', '0.4');
          dialog.showModal();

          scroller.scrollTo({
            left: 0,
            behavior: 'instant'
          });

          this.armed = true;
          opener.setAttribute('aria-expanded', 'true');
        }, { signal });

        dialog.addEventListener('cancel', event => {
          event.preventDefault();
          close();
        }, { signal });

        dialog.addEventListener('close', () => {
          if (dialog.open) return;

          this.armed = false;
          opener.setAttribute('aria-expanded', 'false');
          resetPanels();

          if (opener.getClientRects().length) {
            opener.focus({ preventScroll: true });
          }
        }, { signal });

        scroller.addEventListener('scroll', () => {
          updateShade();

          // Prevent a native drag from activating a link on release.
          this.suppressClickUntil = performance.now() + 150;
        }, { signal, passive: true });

        this.visibilityObserver = new IntersectionObserver(entries => {
          const entry = entries.at(-1);

          if (
            dialog.open &&
            this.armed &&
            entry.intersectionRatio < 0.002 &&
            scroller.scrollLeft >= sheet.offsetWidth - 2
          ) {
            finishClose();
          }
        }, {
          root: scroller,
          threshold: [0, 0.002, 1]
        });

        this.visibilityObserver.observe(sheet);

        dialog.addEventListener('click', event => {
          if (
            event.detail !== 0 &&
            performance.now() < this.suppressClickUntil
          ) {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          const closeButton = event.target.closest('[data-close]');

          if (closeButton || !sheet.contains(event.target)) {
            close();
            return;
          }

          const nextButton = event.target.closest('[data-next]');

          if (nextButton) {
            this.history.push({
              panel: this.current,
              trigger: nextButton
            });

            nextButton.setAttribute('aria-expanded', 'true');
            showPanel(nextButton.dataset.next, 1);
            return;
          }

          if (event.target.closest('[data-back]')) {
            const previous = this.history.pop();
            if (!previous) return;

            previous.trigger.setAttribute('aria-expanded', 'false');
            showPanel(previous.panel, -1, previous.trigger);
            return;
          }

          if (event.target.closest('a[href]')) {
            close(true);
          }
        }, { signal, capture: true });

        const syncLayout = () => {
          if (!dialog.open) return;

          if (
            window.matchMedia('(min-width: 750px)').matches &&
            header?.dataset.menuStyle !== 'drawer'
          ) {
            close(true);
          }
        };

        window.addEventListener('resize', syncLayout, { signal });

        this.headerObserver = new MutationObserver(syncLayout);

        if (header) {
          this.headerObserver.observe(header, {
            attributes: true,
            attributeFilter: ['data-menu-style']
          });
        }
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.visibilityObserver?.disconnect();
        this.headerObserver?.disconnect();
        this.animation?.cancel();

        if (this.dialog?.open) this.dialog.close();

        this.controller = null;
      }
    });
  }
</script>