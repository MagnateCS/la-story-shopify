{% comment %}
  LA Story mobile brand drawer.
  Drag left to close; drag right to return.
  Requires brand_nav_links, active_brand_link, and section.
{% endcomment %}

<la-brand-drawer>
  <button
    class="la-drawer-toggle"
    type="button"
    aria-label="Open navigation"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="LaBrandDrawer-{{ section.id }}"
    data-la-open
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M4 6h16M4 12h16M4 18h16"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <dialog
    id="LaBrandDrawer-{{ section.id }}"
    class="la-drawer color-{{ section.settings.brand_nav_color_scheme }}"
    aria-labelledby="LaBrandDrawerTitle-{{ section.id }}"
  >
    <div class="la-drawer__surface">
      <div class="la-drawer__heading">
        <span
          id="LaBrandDrawerTitle-{{ section.id }}"
          class="la-drawer__title"
        >
          {{ shop.name | escape }}
        </span>

        <button
          class="la-drawer__close"
          type="button"
          aria-label="Close navigation"
          data-la-close
          autofocus
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m6 6 12 12M18 6 6 18"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <nav
        class="la-drawer__nav"
        aria-label="Mobile brand navigation"
      >
        {% for brand_link in brand_nav_links %}
          {% if brand_link.links.size > 0 %}
            <details
              class="la-drawer__group"
              {% if brand_link.handle == active_brand_link.handle %}
                open
              {% endif %}
            >
              <summary class="la-drawer__brand">
                <span>{{ brand_link.title | escape }}</span>

                <span
                  class="la-drawer__indicator"
                  aria-hidden="true"
                >+</span>
              </summary>

              <ul class="la-drawer__links" role="list">
                <li>
                  <a
                    href="{{ brand_link.url }}"
                    draggable="false"
                    {% if brand_link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    Explore {{ brand_link.title | escape }}
                  </a>
                </li>

                {% for child_link in brand_link.links %}
                  <li>
                    <a
                      href="{{ child_link.url }}"
                      draggable="false"
                      {% if child_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ child_link.title | escape }}
                    </a>

                    {% if child_link.links.size > 0 %}
                      <ul
                        class="la-drawer__nested"
                        role="list"
                      >
                        {% for grandchild_link in child_link.links %}
                          <li>
                            <a
                              href="{{ grandchild_link.url }}"
                              draggable="false"
                              {% if grandchild_link.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ grandchild_link.title | escape }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% else %}
            <a
              class="la-drawer__brand la-drawer__standalone"
              href="{{ brand_link.url }}"
              draggable="false"
              {% if brand_link.current %}
                aria-current="page"
              {% endif %}
            >
              {{ brand_link.title | escape }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>

      <p class="la-drawer__hint" aria-hidden="true">
        Drag left to close
      </p>
    </div>
  </dialog>
</la-brand-drawer>

<style>
  la-brand-drawer {
    display: block;
    grid-area: leftA;
    justify-self: start;
  }

  .la-drawer,
  .la-drawer *,
  .la-drawer-toggle {
    box-sizing: border-box;
  }

  .la-drawer-toggle,
  .la-drawer__close {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 10px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    box-shadow: none;
  }

  .la-drawer-toggle svg,
  .la-drawer__close svg {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .la-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(88vw, 390px);
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-height: 100vh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;

    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
    font-family: "Century Gothic", Arial, sans-serif;

    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y pinch-zoom;

    transform: translateX(-100%);
    transition: transform 240ms ease;
  }

  .la-drawer[open] {
    transform: translateX(var(--la-drag-x, 0px));
  }

  @starting-style {
    .la-drawer[open] {
      transform: translateX(-100%);
    }
  }

  .la-drawer::backdrop {
    background: rgb(0 0 0 / 40%);
    opacity: var(--la-backdrop-opacity, 1);
    transition: opacity 240ms ease;
  }

  @starting-style {
    .la-drawer[open]::backdrop {
      opacity: 0;
    }
  }

  .la-drawer.is-dragging,
  .la-drawer.is-dragging::backdrop {
    transition: none;
  }

  .la-drawer.is-dragging,
  .la-drawer.is-dragging * {
    user-select: none;
    -webkit-user-select: none;
  }

  .la-drawer a {
    -webkit-user-drag: none;
  }

  html:has(.la-drawer[open]),
  html:has(.la-drawer[open]) body {
    overflow: hidden;
  }

  .la-drawer__surface {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding:
      max(18px, env(safe-area-inset-top))
      24px
      max(24px, env(safe-area-inset-bottom));
  }

  .la-drawer__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid currentColor;
  }

  .la-drawer__title {
    font-family: inherit;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .la-drawer__nav {
    margin-top: 16px;
  }

  .la-drawer__group,
  .la-drawer__standalone {
    border-bottom: 1px solid rgb(128 128 128 / 25%);
  }

  .la-drawer__brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 18px 0;
    font-family: inherit;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .la-drawer__brand::-webkit-details-marker {
    display: none;
  }

  .la-drawer__indicator {
    flex-shrink: 0;
    font-size: 24px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .la-drawer__group[open] > summary .la-drawer__indicator {
    transform: rotate(45deg);
  }

  .la-drawer__links,
  .la-drawer__nested {
    margin: 0;
    padding: 0 0 16px;
    list-style: none;
  }

  .la-drawer__nested {
    padding: 0 0 8px 18px;
  }

  .la-drawer__links a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 4px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .la-drawer a[aria-current="page"],
  .la-drawer a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .la-drawer :is(a, button, summary):focus-visible,
  .la-drawer-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .la-drawer__hint {
    margin: auto 0 0;
    padding-top: 32px;
    font-family: inherit;
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.65;
  }

  @media (max-width: 749px) {
    .la-desktop-brand-subnav {
      display: none;
    }
  }

  #header-component[data-menu-style="drawer"]
    .la-desktop-brand-subnav {
    display: none;
  }

  @media (min-width: 750px) {
    #header-component:not([data-menu-style="drawer"])
      la-brand-drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .la-drawer,
    .la-drawer::backdrop,
    .la-drawer__indicator {
      transition: none;
    }
  }
</style>

<script type="module">
  if (!customElements.get('la-brand-drawer')) {
    customElements.define('la-brand-drawer', class extends HTMLElement {
      connectedCallback() {
        if (this.controller) return;

        this.controller = new AbortController();

        const { signal } = this.controller;
        const dialog = this.querySelector('dialog');
        const opener = this.querySelector('[data-la-open]');
        const closer = this.querySelector('[data-la-close]');
        const header = this.closest('header-component');
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );

        this.dialog = dialog;
        this.drag = null;
        this.closing = false;
        this.backdropPress = false;
        this.suppressClickUntil = 0;

        const setPosition = (x, width) => {
          dialog.style.setProperty('--la-drag-x', `${x}px`);

          dialog.style.setProperty(
            '--la-backdrop-opacity',
            String(
              Math.max(0, Math.min(1, 1 + x / Math.max(1, width)))
            )
          );
        };

        const clearPosition = () => {
          dialog.classList.remove('is-dragging');
          dialog.style.removeProperty('--la-drag-x');
          dialog.style.removeProperty('--la-backdrop-opacity');
        };

        const releasePointer = () => {
          const drag = this.drag;
          this.drag = null;

          if (drag && dialog.hasPointerCapture(drag.id)) {
            dialog.releasePointerCapture(drag.id);
          }
        };

        const reset = () => {
          clearTimeout(this.closeTimer);
          releasePointer();
          clearPosition();
          this.closing = false;
          this.backdropPress = false;
        };

        const finishClose = () => {
          clearTimeout(this.closeTimer);

          if (dialog.open) {
            dialog.close();
          }

          reset();
          opener.setAttribute('aria-expanded', 'false');
        };

        const close = (immediate = false) => {
          if (!dialog.open) return;
          if (this.closing && !immediate) return;

          releasePointer();

          if (immediate || reducedMotion.matches) {
            finishClose();
            return;
          }

          this.closing = true;

          // Commit the finger-controlled position first.
          dialog.getBoundingClientRect();
          dialog.classList.remove('is-dragging');
          dialog.getBoundingClientRect();

          setPosition(-dialog.offsetWidth, dialog.offsetWidth);

          // Fallback if transitionend does not fire.
          clearTimeout(this.closeTimer);
          this.closeTimer = setTimeout(finishClose, 280);
        };

        const snapOpen = () => {
          releasePointer();

          // Animate from the current drag position back to fully open.
          dialog.getBoundingClientRect();
          dialog.classList.remove('is-dragging');
          dialog.getBoundingClientRect();

          setPosition(0, dialog.offsetWidth);
        };

        const outside = (event) => {
          const rect = dialog.getBoundingClientRect();

          return (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          );
        };

        opener.addEventListener('click', () => {
          if (dialog.open) return;

          reset();
          this.suppressClickUntil = 0;
          dialog.showModal();
          opener.setAttribute('aria-expanded', 'true');
        }, { signal });

        closer.addEventListener('click', () => {
          close();
        }, { signal });

        dialog.addEventListener('cancel', (event) => {
          event.preventDefault();
          close();
        }, { signal });

        dialog.addEventListener('transitionend', (event) => {
          if (
            this.closing &&
            event.target === dialog &&
            event.propertyName === 'transform'
          ) {
            finishClose();
          }
        }, { signal });

        dialog.addEventListener('close', () => {
          // Ignore a queued close event if the dialog was reopened.
          if (dialog.open) return;

          reset();
          opener.setAttribute('aria-expanded', 'false');

          if (opener.getClientRects().length) {
            opener.focus({ preventScroll: true });
          }
        }, { signal });

        dialog.addEventListener('pointerdown', (event) => {
          // Let multi-touch gestures remain available for pinch zoom.
          if (!event.isPrimary) {
            if (this.drag) snapOpen();
            return;
          }

          if (
            !dialog.open ||
            this.closing ||
            event.button !== 0
          ) {
            return;
          }

          this.backdropPress = outside(event);
          if (this.backdropPress) return;

          // Read the visible position so a returning drawer can be grabbed.
          const transform = getComputedStyle(dialog).transform;
          const offset = transform === 'none'
            ? 0
            : new DOMMatrixReadOnly(transform).m41;

          this.drag = {
            id: event.pointerId,
            startX: event.clientX,
            startY: event.clientY,
            offset,
            width: dialog.offsetWidth,
            x: offset,
            active: false
          };
        }, { signal, passive: true });

        dialog.addEventListener('pointermove', (event) => {
          const drag = this.drag;

          if (!drag || event.pointerId !== drag.id) return;

          const dx = event.clientX - drag.startX;
          const dy = event.clientY - drag.startY;

          if (!drag.active) {
            // Small tolerance prevents taps from becoming accidental drags.
            if (Math.max(Math.abs(dx), Math.abs(dy)) < 6) return;

            // Preserve normal vertical scrolling inside the navigation.
            if (Math.abs(dy) >= Math.abs(dx)) {
              this.drag = null;
              return;
            }

            drag.active = true;
            dialog.classList.add('is-dragging');
            dialog.setPointerCapture(event.pointerId);
          }

          if (event.cancelable) {
            event.preventDefault();
          }

          // The panel follows the finger in either direction.
          drag.x = Math.max(
            -drag.width,
            Math.min(0, drag.offset + dx)
          );

          setPosition(drag.x, drag.width);
        }, { signal, passive: false });

        const finishDrag = (event, cancelled = false) => {
          const drag = this.drag;

          if (!drag || event.pointerId !== drag.id) return;

          if (!drag.active) {
            releasePointer();
            return;
          }

          // Do not activate links or accordion headings after dragging.
          this.suppressClickUntil = performance.now() + 400;
          this.backdropPress = false;

          const shouldClose =
            !cancelled &&
            Math.abs(drag.x) >= drag.width * 0.3;

          if (shouldClose) {
            close();
          } else {
            snapOpen();
          }
        };

        dialog.addEventListener('pointerup', (event) => {
          finishDrag(event);
        }, { signal });

        dialog.addEventListener('pointercancel', (event) => {
          this.backdropPress = false;
          finishDrag(event, true);
        }, { signal });

        dialog.addEventListener('lostpointercapture', (event) => {
          if (this.drag?.id === event.pointerId) {
            finishDrag(event, true);
          }
        }, { signal });

        dialog.addEventListener('dragstart', (event) => {
          event.preventDefault();
        }, { signal });

        dialog.addEventListener('click', (event) => {
          if (
            event.detail !== 0 &&
            performance.now() < this.suppressClickUntil
          ) {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
          }

          if (this.backdropPress && outside(event)) {
            close();
          }

          this.backdropPress = false;

          if (event.target.closest('a[href]')) {
            close(true);
          }
        }, { signal, capture: true });

        const syncLayout = () => {
          const desktop = window.matchMedia(
            '(min-width: 750px)'
          ).matches;

          if (
            desktop &&
            header?.dataset.menuStyle !== 'drawer'
          ) {
            close(true);
          } else if (this.drag) {
            snapOpen();
          }
        };

        window.addEventListener('resize', syncLayout, { signal });

        this.observer = new MutationObserver(syncLayout);

        if (header) {
          this.observer.observe(header, {
            attributes: true,
            attributeFilter: ['data-menu-style']
          });
        }
      }

      disconnectedCallback() {
        clearTimeout(this.closeTimer);
        this.controller?.abort();
        this.observer?.disconnect();

        if (
          this.drag &&
          this.dialog?.hasPointerCapture(this.drag.id)
        ) {
          this.dialog.releasePointerCapture(this.drag.id);
        }

        if (this.dialog?.open) {
          this.dialog.close();
        }

        this.dialog?.classList.remove('is-dragging');
        this.dialog?.style.removeProperty('--la-drag-x');
        this.dialog?.style.removeProperty('--la-backdrop-opacity');

        this.drag = null;
        this.closing = false;
        this.controller = null;
      }
    });
  }
</script>