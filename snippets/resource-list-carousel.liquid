{%- doc -%}
  Renders a carousel of predictive search results cards

  @param {string} ref - The ref of the slideshow
  @param {object} slides - An array of HTML for the slides to display in the carousel
  @param {number} slide_count - The number of slides to display in the carousel
  @param {object} settings - The block or sections settings from the parent block/section.
  @param {string} [slide_width_max] - The maximum width of the slides in the carousel.

  @example
  {% render 'resource-list-carousel', slides: slides, slide_count: slide_count, settings: block.settings %}
{%- enddoc -%}

{% liquid
  assign slideshow_ref = ref | default: 'resourceListCarousel'

  if settings.section_width == 'page-width'
    assign slideshow_gutters = 'start end'
    assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset);'
  else
    assign slideshow_gutters = null
    assign gutter_style = '--gutter-slide-width: 0px;'
  endif

  assign show_arrows = false
  if settings.icons_style != 'none'
    assign show_arrows = true
  endif
%}

{% capture slides %}
  {% for item in slides limit: slides.size %}
    {% render 'slideshow-slide',
      index: forloop.index0,
      children: item,
      class: 'resource-list__slide'
    %}
  {% endfor %}
{% endcapture %}

<div
  class="resource-list-carousel-wrapper"
  data-resource-auto-scroll
  data-auto-scroll-speed="18"
  data-auto-resume-delay="3000"
  style="
    {{ gutter_style }}
    --slide-width-max: {{ slide_width_max | default: '300px' }};
  "
>
  {% render 'slideshow',
    ref: slideshow_ref,
    class: 'resource-list__carousel',
    slides: slides,
    show_arrows: show_arrows,
    icon_style: settings.icons_style,
    icon_shape: settings.icons_shape,
    auto_hide_controls: false,
    infinite: false,
    initial_slide: 0,
    slide_count: slide_count,
    slideshow_gutters: slideshow_gutters
  %}
</div>

{% stylesheet %}
  .resource-list__carousel {
    --slide-width: 60vw;
    width: 100%;
    position: relative;
    container-type: inline-size;
    container-name: resource-list-carousel;

    .slideshow-control[disabled] {
      display: none;
    }

    .slideshow-control--next {
      margin-inline-start: auto;
    }
  }

  @container resource-list-carousel (max-width: 749px) {
    .resource-list__carousel .resource-list__slide {
      --slide-width: clamp(
        150px,
        var(--mobile-card-size, 60cqw),
        var(--slide-width-max)
      );
    }
  }

  @container resource-list-carousel (min-width: 750px) {
    .resource-list__carousel .resource-list__slide {
      --section-slide-width: calc(
        (
          100%
          - (var(--resource-list-column-gap) * (var(--column-count) - 1))
          - var(--peek-next-slide-size)
        )
        / var(--column-count)
      );

      --fallback-slide-width: clamp(
        150px,
        var(--mobile-card-size, 60cqw),
        var(--slide-width-max)
      );

      --slide-width: var(
        --section-slide-width,
        var(--fallback-slide-width)
      );
    }
  }

  .resource-list__carousel slideshow-slides {
    gap: var(--resource-list-column-gap);

    /*
      Extra room so hover effects don't get clipped.
    */
    margin-block: -16px;
    padding-block: 16px;

    /*
      Important for smooth manual + automatic scrolling.
    */
    scroll-behavior: auto;
  }

  .resource-list__carousel slideshow-arrows {
    padding-inline: var(--util-page-margin-offset);
  }

  .resource-list__carousel .resource-list__slide {
    width: var(--slide-width);
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-width: 0;
  }

  /*
   * Resource list carousels have peeking slides on both sides.
   * We try to load them beforehand.
   */
  .resource-list__carousel
    :is(
      slideshow-slide:has(+ slideshow-slide[aria-hidden='false']),
      slideshow-slide[aria-hidden='false'] + slideshow-slide
    ) {
    content-visibility: auto;

    slideshow-component[actioned] & {
      content-visibility: visible;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const initializeResourceCarouselAutoScroll = (wrapper) => {
      if (!wrapper || wrapper.dataset.autoScrollInitialized === 'true') {
        return;
      }

      const scroller = wrapper.querySelector('slideshow-slides');

      if (!scroller) {
        return;
      }

      wrapper.dataset.autoScrollInitialized = 'true';

      /*
       * CUSTOMIZE THESE VALUES ABOVE ON THE WRAPPER:
       *
       * data-auto-scroll-speed="18"
       * data-auto-resume-delay="3000"
       *
       * speed = pixels per second
       * delay = milliseconds before auto scroll resumes
       */
      const speed = Number(wrapper.dataset.autoScrollSpeed || 18);
      const resumeDelay = Number(wrapper.dataset.autoResumeDelay || 3000);

      let pausedUntil = 0;
      let lastFrameTime = null;
      let lastAutoPosition = scroller.scrollLeft;

      /*
       * Used so normal automatic scrolling doesn't accidentally
       * trigger our manual interaction detection.
       */
      let autoScrollActive = false;

      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

      const pauseAutoScroll = () => {
        pausedUntil = performance.now() + resumeDelay;
        lastFrameTime = null;
      };

      /*
       * Mouse wheel / trackpad
       */
      scroller.addEventListener(
        'wheel',
        () => {
          pauseAutoScroll();
        },
        { passive: true }
      );

      /*
       * Mobile touch
       */
      scroller.addEventListener(
        'touchstart',
        () => {
          pauseAutoScroll();
        },
        { passive: true }
      );

      scroller.addEventListener(
        'touchmove',
        () => {
          pauseAutoScroll();
        },
        { passive: true }
      );

      /*
       * Mouse drag / scrollbar interaction / clicking inside carousel
       */
      scroller.addEventListener(
        'pointerdown',
        () => {
          pauseAutoScroll();
        },
        { passive: true }
      );

      /*
       * Keyboard interaction
       */
      scroller.addEventListener('keydown', (event) => {
        const interactionKeys = [
          'ArrowLeft',
          'ArrowRight',
          'PageUp',
          'PageDown',
          'Home',
          'End',
          ' ',
        ];

        if (interactionKeys.includes(event.key)) {
          pauseAutoScroll();
        }
      });

      /*
       * Detect scrolling caused manually.
       *
       * Automatic scroll positions are saved in lastAutoPosition,
       * so we can distinguish our own animation from user scrolling.
       */
      scroller.addEventListener(
        'scroll',
        () => {
          if (autoScrollActive) {
            return;
          }

          const difference = Math.abs(
            scroller.scrollLeft - lastAutoPosition
          );

          if (difference > 3) {
            pauseAutoScroll();
          }
        },
        { passive: true }
      );

      const animate = (time) => {
        /*
         * Respect accessibility preference.
         */
        if (reducedMotion.matches) {
          requestAnimationFrame(animate);
          return;
        }

        /*
         * User interacted recently.
         */
        if (time < pausedUntil) {
          lastFrameTime = time;
          lastAutoPosition = scroller.scrollLeft;

          requestAnimationFrame(animate);
          return;
        }

        if (lastFrameTime === null) {
          lastFrameTime = time;
        }

        /*
         * Amount of time since last animation frame.
         */
        const deltaSeconds = Math.min(
          (time - lastFrameTime) / 1000,
          0.05
        );

        lastFrameTime = time;

        const maxScroll =
          scroller.scrollWidth - scroller.clientWidth;

        /*
         * Continue scrolling until we hit the very end.
         */
        if (scroller.scrollLeft < maxScroll - 1) {
          const distance = speed * deltaSeconds;

          autoScrollActive = true;

          scroller.scrollLeft = Math.min(
            scroller.scrollLeft + distance,
            maxScroll
          );

          lastAutoPosition = scroller.scrollLeft;

          /*
           * Clear on next frame so native scroll events caused by our
           * own movement aren't treated as user interaction.
           */
          requestAnimationFrame(() => {
            autoScrollActive = false;
            lastAutoPosition = scroller.scrollLeft;
          });
        }

        requestAnimationFrame(animate);
      };

      requestAnimationFrame(animate);
    };

    const initializeAllResourceCarousels = () => {
      document
        .querySelectorAll('[data-resource-auto-scroll]')
        .forEach(initializeResourceCarouselAutoScroll);
    };

    /*
     * Initial page load
     */
    initializeAllResourceCarousels();

    /*
     * Shopify Theme Editor support
     */
    document.addEventListener(
      'shopify:section:load',
      initializeAllResourceCarousels
    );

    /*
     * Predictive search / dynamically rendered Shopify content support.
     */
    const observer = new MutationObserver(() => {
      initializeAllResourceCarousels();
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });
  })();
</script>