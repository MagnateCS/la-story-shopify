{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif
  %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled'
                  %}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%- liquid
            assign option_index = forloop.index0
            assign dropdown_id = section.id | append: '-' | append: block.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.position
            assign option_name_handle = product_option.name | handleize
          -%}

          <div class="variant-option variant-option--dropdowns">
            <span
              class="variant-option__custom-label"
              id="OptionLabel-{{ dropdown_id }}"
            >
              {{- product_option.name | escape -}}
            </span>

            <variant-custom-select
              class="variant-option__custom-select"
              {% if option_name_handle == 'size' %}
                data-default-value="0"
                data-default-key="{{ section.id }}-{{ product_resource.id }}-{{ product_option.position }}"
              {% endif %}
            >
              {%- comment -%}
                This native select remains the source of truth. The custom menu below
                updates it and dispatches the same bubbling change event the original
                variant picker listens for.
              {%- endcomment -%}
              <select
                id="Option-{{ block.id }}-{{ option_index }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select variant-option__select--native"
                data-native-select
                tabindex="-1"
                aria-hidden="true"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>

              <button
                type="button"
                class="variant-option__custom-trigger"
                aria-expanded="false"
                aria-haspopup="listbox"
                aria-controls="OptionList-{{ dropdown_id }}"
                aria-labelledby="OptionLabel-{{ dropdown_id }} OptionValue-{{ dropdown_id }}"
                data-custom-select-trigger
              >
                <span
                  id="OptionValue-{{ dropdown_id }}"
                  class="variant-option__custom-value"
                  data-custom-select-value
                >
                  {{- product_option.selected_value | escape -}}
                </span>
                <svg
                  aria-hidden="true"
                  focusable="false"
                  class="variant-option__custom-caret"
                  viewBox="0 0 12 8"
                >
                  <path d="M1 1.25 6 6.25l5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25"/>
                </svg>
              </button>

              <div
                id="OptionList-{{ dropdown_id }}"
                class="variant-option__custom-menu"
                role="listbox"
                aria-labelledby="OptionLabel-{{ dropdown_id }}"
                data-custom-select-menu
                hidden
              >
                {%- for product_option_value in product_option.values -%}
                  <button
                    type="button"
                    class="variant-option__custom-item{% if product_option_value.available == false %} variant-option__custom-item--unavailable{% endif %}"
                    role="option"
                    aria-selected="{% if product_option_value.selected %}true{% else %}false{% endif %}"
                    data-option-index="{{ forloop.index0 }}"
                  >
                    <span>{{ product_option_value | escape }}</span>
                    {%- if product_option_value.available == false -%}
                      <span class="variant-option__custom-status">{{ 'content.unavailable' | t }}</span>
                    {%- endif -%}
                    <svg
                      aria-hidden="true"
                      class="variant-option__custom-check"
                      viewBox="0 0 16 16"
                    >
                      <path d="m3 8.25 3.1 3.1L13 4.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"/>
                    </svg>
                  </button>
                {%- endfor -%}
              </div>
            </variant-custom-select>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% stylesheet %}
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  .variant-option__custom-label {
    display: block;
    margin-bottom: 10px;
    color: var(--color-foreground);
    font: inherit;
  }

  .variant-option__custom-select {
    display: block;
    position: relative;
    width: 100%;
  }

  .variant-option__select--native {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .variant-option__custom-trigger {
    display: flex;
    width: 100%;
    min-height: 66px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 22px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    border-radius: var(--style-border-radius-inputs, 4px);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .variant-option__custom-trigger:hover,
  .variant-option__custom-trigger[aria-expanded='true'] {
    border-color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    background: color-mix(in srgb, var(--color-foreground) 3%, transparent);
  }

  .variant-option__custom-trigger:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .variant-option__custom-value {
    line-height: 1.2;
  }

  .variant-option__custom-caret {
    flex: 0 0 auto;
    width: 12px;
    height: 8px;
    opacity: 0.75;
    transition: transform 180ms ease;
  }

  .variant-option__custom-trigger[aria-expanded='true'] .variant-option__custom-caret {
    transform: rotate(180deg);
  }

  .variant-option__custom-menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    max-height: min(320px, 45vh);
    overflow-y: auto;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    border-radius: var(--style-border-radius-inputs, 4px);
    background: var(--color-background);
    box-shadow: 0 16px 36px color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .variant-option__custom-menu[hidden] {
    display: none;
  }

  .variant-option__custom-item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    width: 100%;
    min-height: 56px;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .variant-option__custom-item:last-child {
    border-bottom: 0;
  }

  .variant-option__custom-item:hover,
  .variant-option__custom-item:focus-visible {
    outline: 0;
    background: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }

  .variant-option__custom-item[aria-selected='true'] {
    background: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }

  .variant-option__custom-status {
    opacity: 0.55;
    font-size: 0.8em;
    letter-spacing: 0.04em;
  }

  .variant-option__custom-item--unavailable > span:first-child {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    opacity: 0.58;
  }

  .variant-option__custom-check {
    width: 16px;
    height: 16px;
    opacity: 0;
  }

  .variant-option__custom-item[aria-selected='true'] .variant-option__custom-check {
    opacity: 1;
  }

  .variant-picker--center,
  .variant-picker--center .variant-option {
    width: 100%;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    justify-content: right;
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .variant-option__custom-trigger,
    .variant-option__custom-caret,
    .variant-option__custom-item {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('variant-custom-select')) {
    const initializedDefaultKeys = new Set();

    class VariantCustomSelect extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;

        this.initialized = true;
        this.select = this.querySelector('[data-native-select]');
        this.trigger = this.querySelector('[data-custom-select-trigger]');
        this.value = this.querySelector('[data-custom-select-value]');
        this.menu = this.querySelector('[data-custom-select-menu]');
        this.items = Array.from(this.querySelectorAll('[data-option-index]'));

        if (!this.select || !this.trigger || !this.menu || !this.items.length) return;

        this.onDocumentClick = this.handleDocumentClick.bind(this);
        this.onKeydown = this.handleKeydown.bind(this);
        this.onNativeChange = this.syncFromNativeSelect.bind(this);

        this.trigger.addEventListener('click', () => this.toggle());
        this.addEventListener('keydown', this.onKeydown);
        this.select.addEventListener('change', this.onNativeChange);
        document.addEventListener('click', this.onDocumentClick);

        const defaultChanged = this.applyDefaultValueOnce();

        this.items.forEach((item) => {
          item.addEventListener('click', () => {
            this.choose(Number(item.dataset.optionIndex));
          });
        });

        this.syncFromNativeSelect();

        if (defaultChanged) {
          queueMicrotask(() => {
            if (this.isConnected) {
              this.select.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        }
      }

      disconnectedCallback() {
        document.removeEventListener('click', this.onDocumentClick);
        this.removeEventListener('keydown', this.onKeydown);
        this.select?.removeEventListener('change', this.onNativeChange);
      }

      get isOpen() {
        return this.trigger.getAttribute('aria-expanded') === 'true';
      }

      open() {
        this.menu.hidden = false;
        this.trigger.setAttribute('aria-expanded', 'true');

        requestAnimationFrame(() => {
          const selectedItem = this.items[this.select.selectedIndex] || this.items[0];
          selectedItem?.focus();
        });
      }

      close({ restoreFocus = false } = {}) {
        this.menu.hidden = true;
        this.trigger.setAttribute('aria-expanded', 'false');
        if (restoreFocus) this.trigger.focus();
      }

      toggle() {
        if (this.isOpen) {
          this.close();
        } else {
          this.open();
        }
      }

      applyDefaultValueOnce() {
        const defaultValue = this.dataset.defaultValue;
        const defaultKey = this.dataset.defaultKey;

        if (!defaultValue || !defaultKey || initializedDefaultKeys.has(defaultKey)) {
          return false;
        }

        initializedDefaultKeys.add(defaultKey);

        const defaultIndex = Array.from(this.select.options).findIndex(
          (option) => option.value === defaultValue
        );

        if (defaultIndex < 0 || defaultIndex === this.select.selectedIndex) {
          return false;
        }

        this.select.selectedIndex = defaultIndex;
        return true;
      }

      choose(index) {
        if (!Number.isInteger(index) || !this.select.options[index]) return;

        const changed = this.select.selectedIndex !== index;
        this.select.selectedIndex = index;
        this.syncFromNativeSelect();
        this.close({ restoreFocus: true });

        if (changed) {
          this.select.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      syncFromNativeSelect() {
        const selectedIndex = Math.max(this.select.selectedIndex, 0);
        const selectedOption = this.select.options[selectedIndex];
        const selectedItem = this.items[selectedIndex];

        if (selectedItem && this.value) {
          const itemLabel = selectedItem.querySelector('span');
          this.value.textContent = itemLabel?.textContent.trim() || selectedOption?.value || '';
        }

        this.items.forEach((item, index) => {
          item.setAttribute('aria-selected', String(index === selectedIndex));
        });
      }

      handleDocumentClick(event) {
        if (this.isOpen && !this.contains(event.target)) {
          this.close();
        }
      }

      handleKeydown(event) {
        const activeIndex = this.items.indexOf(document.activeElement);

        if (event.key === 'Escape' && this.isOpen) {
          event.preventDefault();
          this.close({ restoreFocus: true });
          return;
        }

        if (event.target === this.trigger && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
          event.preventDefault();
          this.open();
          return;
        }

        if (!this.isOpen || activeIndex < 0) return;

        let nextIndex = activeIndex;

        if (event.key === 'ArrowDown') nextIndex = (activeIndex + 1) % this.items.length;
        if (event.key === 'ArrowUp') nextIndex = (activeIndex - 1 + this.items.length) % this.items.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = this.items.length - 1;

        if (nextIndex !== activeIndex) {
          event.preventDefault();
          this.items[nextIndex].focus();
        }
      }
    }

    customElements.define('variant-custom-select', VariantCustomSelect);
  }
{% endjavascript %}
