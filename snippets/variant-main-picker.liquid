{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign measurement_image = block_settings.custom_size_measurement_image
  assign measurement_image_alt = measurement_image.alt | default: 'Custom size measurement guide'
  assign has_size_option = false
  assign custom_size_id = 'CustomSize-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product_resource.id
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
%}

{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif
  %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign normalized_option_name = product_option.name | strip | downcase
          if normalized_option_name == 'size'
            assign has_size_option = true
            assign has_custom_size_variant = false
            for product_option_value in product_option.values
              assign normalized_option_value = product_option_value.name | strip | downcase
              if normalized_option_value == 'custom size'
                assign has_custom_size_variant = true
              endif
            endfor
          endif

          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if normalized_option_name == 'size' -%}
          <div class="variant-option variant-option--dropdowns custom-size-option">
            <span class="custom-size-option__title" id="CustomSizeLabel-{{ block.id }}-{{ forloop.index0 }}">
              {{- product_option.name | escape -}}
            </span>

            <div class="custom-size-option__dropdown" data-custom-size-dropdown>
              <button
                type="button"
                class="custom-size-option__trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="CustomSizeLabel-{{ block.id }}-{{ forloop.index0 }} CustomSizeValue-{{ block.id }}-{{ forloop.index0 }}"
                aria-controls="CustomSizeMenu-{{ block.id }}-{{ forloop.index0 }}"
                data-custom-size-trigger
              >
                <span id="CustomSizeValue-{{ block.id }}-{{ forloop.index0 }}" data-custom-size-dropdown-label>
                  {{- product_option.selected_value | escape -}}
                </span>
                <svg aria-hidden="true" viewBox="0 0 12 8">
                  <path d="m1.5 1.5 4.5 4 4.5-4"></path>
                </svg>
              </button>

              <div
                id="CustomSizeMenu-{{ block.id }}-{{ forloop.index0 }}"
                class="custom-size-option__menu"
                role="listbox"
                aria-labelledby="CustomSizeLabel-{{ block.id }}-{{ forloop.index0 }}"
                data-custom-size-menu
                hidden
              >
                {%- for product_option_value in product_option.values -%}
                  {%- assign normalized_option_value = product_option_value.name | strip | downcase -%}
                  <button
                    type="button"
                    class="custom-size-option__item{% if product_option_value.selected %} is-selected{% endif %}{% if normalized_option_value == 'custom size' %} custom-size-option__item--custom{% endif %}"
                    role="option"
                    aria-selected="{% if product_option_value.selected %}true{% else %}false{% endif %}"
                    data-custom-size-dropdown-option
                    data-value="{{ product_option_value | escape }}"
                    {% if product_option_value.available == false %}
                      data-unavailable="true"
                    {% endif %}
                  >
                    <span>{{ product_option_value | escape }}</span>
                    {%- if product_option_value.available == false -%}
                      <span class="custom-size-option__availability">{{ 'content.unavailable' | t }}</span>
                    {%- endif -%}
                    <svg aria-hidden="true" viewBox="0 0 12 10">
                      <path d="m1 5 3 3 7-7"></path>
                    </svg>
                  </button>
                {%- endfor -%}
                {%- unless has_custom_size_variant -%}
                  <button
                    type="button"
                    class="custom-size-option__item custom-size-option__item--custom"
                    role="option"
                    aria-selected="false"
                    data-custom-size-dropdown-option
                    data-value="__custom_size__"
                  >
                    <span>Custom Size</span>
                    <svg aria-hidden="true" viewBox="0 0 12 10">
                      <path d="m1 5 3 3 7-7"></path>
                    </svg>
                  </button>
                {%- endunless -%}
              </div>
            </div>

            <select
              id="CustomSizeOption-{{ block.id }}-{{ forloop.index0 }}"
              class="custom-size-option__select"
              data-custom-size-select
              tabindex="-1"
              aria-hidden="true"
              hidden
            >
              {%- for product_option_value in product_option.values -%}
                {%- assign normalized_option_value = product_option_value.name | strip | downcase -%}
                <option
                  value="{{ product_option_value | escape }}"
                  {% if normalized_option_value == 'custom size' %}
                    data-custom-size-option
                    data-real-variant="true"
                  {% endif %}
                  {% if product_option_value.selected %}
                    selected
                  {% endif %}
                >
                  {{- product_option_value | escape -}}
                </option>
              {%- endfor -%}
              {%- unless has_custom_size_variant -%}
                <option value="__custom_size__" data-custom-size-option>Custom Size</option>
              {%- endunless -%}
            </select>

            <select
              id="Option-{{ block.id }}-{{ forloop.index0 }}"
              name="options[{{ product_option.name | escape }}]"
              class="variant-option__select custom-size-option__native-select"
              data-custom-size-native-select
              tabindex="-1"
              aria-hidden="true"
              hidden
            >
              {%- for product_option_value in product_option.values -%}
                <option
                  value="{{ product_option_value | escape }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-variant-id="{{ product_option_value.variant.id }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.selected %}
                    selected="selected"
                  {% endif %}
                >
                  {{- product_option_value | escape -}}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- elsif product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    # If the variant has no featured media, and we have a combined listing product, then fall back to
                    # using the featured media of the child product that is linked to this option value.
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled'
                  %}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>

    {%- if has_size_option -%}
      <section class="custom-size" data-custom-size>
        <button
          type="button"
          class="custom-size__backdrop"
          aria-label="Close custom size measurements"
          data-custom-size-close
          data-custom-size-backdrop
          hidden
        ></button>

        <div
          id="{{ custom_size_id }}"
          class="custom-size__panel"
          data-custom-size-panel
          aria-labelledby="{{ custom_size_id }}-title"
          hidden
        >
          <div class="custom-size__sheet-header">
            <div>
              <span class="custom-size__eyebrow">Made to measure</span>
              <h2 id="{{ custom_size_id }}-title">Enter your measurements</h2>
            </div>
            <button
              type="button"
              class="custom-size__close"
              aria-label="Close custom size measurements"
              data-custom-size-close
            >
              <svg aria-hidden="true" viewBox="0 0 16 16">
                <path d="m3 3 10 10M13 3 3 13"></path>
              </svg>
            </button>
          </div>

          <input
            type="hidden"
            name="properties[Custom Size]"
            value="Yes"
            form="{{ product_form_id }}"
            data-custom-size-field
            disabled
          >
          <input
            type="hidden"
            name="properties[Measurement Unit]"
            value="in"
            form="{{ product_form_id }}"
            data-custom-size-field
            data-custom-size-unit-value
            disabled
          >

          <fieldset class="custom-size__unit">
            <legend class="custom-size__unit-legend">Measurement unit</legend>

            <label class="custom-size__unit-option">
              <input
                type="radio"
                name="CustomSizeUnit-{{ section.id }}-{{ block.id }}-{{ product_resource.id }}"
                value="in"
                data-unit
                checked
              >
              <span>IN</span>
            </label>

            <label class="custom-size__unit-option">
              <input
                type="radio"
                name="CustomSizeUnit-{{ section.id }}-{{ block.id }}-{{ product_resource.id }}"
                value="cm"
                data-unit
              >
              <span>CM</span>
            </label>
          </fieldset>

          <p class="custom-size__note">
            <strong>Bust:</strong> Wear the bra you will be wearing with the dress, then pull the tape across the fullest part of the bust.
          </p>

          <div class="custom-size__layout{% if measurement_image == blank %} custom-size__layout--no-image{% endif %}">
            <div class="custom-size__fields">
              <label class="custom-size__field">
                <span>Bust</span>
                <span class="custom-size__control">
                  <input
                    type="number"
                    inputmode="decimal"
                    step="0.1"
                    min="28.5"
                    max="69.5"
                    placeholder="28.5 – 69.5"
                    name="properties[Bust]"
                    form="{{ product_form_id }}"
                    data-custom-size-field
                    data-measurement
                    data-in-min="28.5"
                    data-in-max="69.5"
                    data-cm-min="72.4"
                    data-cm-max="176.5"
                    disabled
                  >
                  <span data-unit-label>in</span>
                </span>
              </label>

              <label class="custom-size__field">
                <span>Waist</span>
                <span class="custom-size__control">
                  <input
                    type="number"
                    inputmode="decimal"
                    step="0.1"
                    min="22"
                    max="70"
                    placeholder="22 – 70"
                    name="properties[Waist]"
                    form="{{ product_form_id }}"
                    data-custom-size-field
                    data-measurement
                    data-in-min="22"
                    data-in-max="70"
                    data-cm-min="55.9"
                    data-cm-max="177.8"
                    disabled
                  >
                  <span data-unit-label>in</span>
                </span>
              </label>

              <label class="custom-size__field">
                <span>Hips</span>
                <span class="custom-size__control">
                  <input
                    type="number"
                    inputmode="decimal"
                    step="0.1"
                    min="30"
                    max="74.5"
                    placeholder="30 – 74.5"
                    name="properties[Hips]"
                    form="{{ product_form_id }}"
                    data-custom-size-field
                    data-measurement
                    data-in-min="30"
                    data-in-max="74.5"
                    data-cm-min="76.2"
                    data-cm-max="189.2"
                    disabled
                  >
                  <span data-unit-label>in</span>
                </span>
              </label>

              <label class="custom-size__field">
                <span>Hollow to Floor</span>
                <span class="custom-size__control">
                  <input
                    type="number"
                    inputmode="decimal"
                    step="0.1"
                    min="41"
                    max="100"
                    placeholder="41 – 100"
                    name="properties[Hollow to Floor]"
                    form="{{ product_form_id }}"
                    data-custom-size-field
                    data-measurement
                    data-in-min="41"
                    data-in-max="100"
                    data-cm-min="104.1"
                    data-cm-max="254"
                    disabled
                  >
                  <span data-unit-label>in</span>
                </span>
              </label>

              <label class="custom-size__field">
                <span>Height (Bare Foot)</span>
                <span class="custom-size__control">
                  <input
                    type="number"
                    inputmode="decimal"
                    step="0.1"
                    min="54"
                    max="107.5"
                    placeholder="54 – 107.5"
                    name="properties[Height (Bare Foot)]"
                    form="{{ product_form_id }}"
                    data-custom-size-field
                    data-measurement
                    data-in-min="54"
                    data-in-max="107.5"
                    data-cm-min="137.2"
                    data-cm-max="273.1"
                    disabled
                  >
                  <span data-unit-label>in</span>
                </span>
              </label>

              <label class="custom-size__field">
                <span>Extra Length</span>
                <span class="custom-size__control">
                  <select
                    name="properties[Extra Length]"
                    form="{{ product_form_id }}"
                    data-custom-size-field
                    data-extra-length
                    disabled
                  >
                    <option value="0" data-inches="0">0</option>
                    <option value="1" data-inches="1">1</option>
                    <option value="2" data-inches="2">2</option>
                    <option value="3" data-inches="3">3</option>
                    <option value="4" data-inches="4">4</option>
                    <option value="5" data-inches="5">5</option>
                  </select>
                  <span data-unit-label>in</span>
                </span>
              </label>
            </div>

            {%- if measurement_image != blank -%}
              {{
                measurement_image
                | image_url: width: 900
                | image_tag:
                  class: 'custom-size__diagram',
                  widths: '240, 360, 480, 720, 900',
                  sizes: '(max-width: 749px) 150px, 210px',
                  loading: 'lazy',
                  alt: measurement_image_alt
              }}
            {%- endif -%}
          </div>

          <p class="custom-size__help">All measurements are required and will be saved with this item.</p>

          <div class="custom-size__sheet-footer">
            <button type="button" class="custom-size__done" data-custom-size-done>
              Save measurements
            </button>
          </div>
        </div>
      </section>

      <script>
        (() => {
          const script = document.currentScript;
          const picker = script && script.closest('variant-picker');
          const root = picker && picker.querySelector('[data-custom-size]');

          if (!root || root.dataset.customSizeReady === 'true') return;
          root.dataset.customSizeReady = 'true';

          const sizeSelect = picker.querySelector('[data-custom-size-select]');
          const nativeSizeSelect = picker.querySelector('[data-custom-size-native-select]');
          const dropdown = picker.querySelector('[data-custom-size-dropdown]');
          const dropdownTrigger = picker.querySelector('[data-custom-size-trigger]');
          const dropdownLabel = picker.querySelector('[data-custom-size-dropdown-label]');
          const dropdownMenu = picker.querySelector('[data-custom-size-menu]');
          const dropdownOptions = [...picker.querySelectorAll('[data-custom-size-dropdown-option]')];
          const panel = root.querySelector('[data-custom-size-panel]');
          const fields = [...root.querySelectorAll('[data-custom-size-field]')];
          const requiredFields = [...root.querySelectorAll('[data-measurement]'), root.querySelector('[data-extra-length]')].filter(Boolean);
          const unitValue = root.querySelector('[data-custom-size-unit-value]');
          const unitInputs = [...root.querySelectorAll('[data-unit]')];
          const closeButtons = [...root.querySelectorAll('[data-custom-size-close]')];
          const backdrop = root.querySelector('[data-custom-size-backdrop]');
          const doneButton = root.querySelector('[data-custom-size-done]');
          const mobileQuery = window.matchMedia('(max-width: 749px)');
          const focusableSelector = 'button:not([disabled]), input:not([disabled]), select:not([disabled]), [href], [tabindex]:not([tabindex="-1"])';
          let activeUnit = 'in';
          let customSizeActive = false;
          let lastFocusedElement = null;

          if (!sizeSelect || !nativeSizeSelect || !dropdown || !dropdownTrigger || !dropdownLabel || !dropdownMenu) return;

          const syncDropdown = () => {
            const selectedItem = dropdownOptions.find((option) => option.dataset.value === sizeSelect.value);
            if (!selectedItem) return;

            dropdownLabel.textContent = selectedItem.querySelector('span')?.textContent.trim() || selectedItem.textContent.trim();
            dropdownOptions.forEach((option) => {
              const selected = option === selectedItem;
              option.classList.toggle('is-selected', selected);
              option.setAttribute('aria-selected', String(selected));
            });
          };

          const setMenuOpen = (open, moveFocus = false) => {
            dropdownMenu.hidden = !open;
            dropdownTrigger.setAttribute('aria-expanded', String(open));
            dropdown.classList.toggle('is-open', open);

            if (open && moveFocus) {
              const selectedItem = dropdownOptions.find((option) => option.getAttribute('aria-selected') === 'true');
              (selectedItem || dropdownOptions[0])?.focus();
            }
          };

          const setPanelOpen = (open, moveFocus = false) => {
            const isMobile = mobileQuery.matches;

            panel.hidden = !open;
            if (backdrop) backdrop.hidden = !open || !isMobile;
            sizeSelect.setAttribute('aria-expanded', String(open && isMobile));

            if (open && isMobile) {
              lastFocusedElement = document.activeElement;
              panel.setAttribute('role', 'dialog');
              panel.setAttribute('aria-modal', 'true');
              document.body.classList.add('custom-size-sheet-open');
            } else {
              panel.removeAttribute('role');
              panel.removeAttribute('aria-modal');
              document.body.classList.remove('custom-size-sheet-open');
            }

            if (open && moveFocus) {
              const focusTarget = isMobile
                ? panel.querySelector('[data-custom-size-close]')
                : root.querySelector('[data-measurement]');
              requestAnimationFrame(() => focusTarget?.focus());
            } else if (!open && isMobile && lastFocusedElement instanceof HTMLElement) {
              requestAnimationFrame(() => lastFocusedElement?.focus());
              lastFocusedElement = null;
            }
          };

          const setCustomSizeActive = (active, openPanel = false, moveFocus = false) => {
            customSizeActive = active;
            fields.forEach((field) => {
              field.disabled = !active;
            });
            requiredFields.forEach((field) => {
              field.required = active;
            });

            if (!active) {
              setPanelOpen(false);
            } else if (mobileQuery.matches) {
              setPanelOpen(openPanel, moveFocus);
            } else {
              setPanelOpen(true, moveFocus);
            }
          };

          const closeMobileSheet = () => {
            if (mobileQuery.matches) setPanelOpen(false);
          };

          const handleViewportChange = () => {
            if (!customSizeActive) {
              setPanelOpen(false);
              return;
            }

            setPanelOpen(!mobileQuery.matches);
          };

          const setUnit = (nextUnit) => {
            if (nextUnit === activeUnit) return;

            const multiplier = nextUnit === 'cm' ? 2.54 : 1 / 2.54;
            root.querySelectorAll('[data-measurement]').forEach((input) => {
              if (input.value) {
                input.value = String(Math.round(Number(input.value) * multiplier * 10) / 10);
              }

              const min = input.dataset[`${nextUnit}Min`];
              const max = input.dataset[`${nextUnit}Max`];
              input.min = min;
              input.max = max;
              input.placeholder = `${min} – ${max}`;
            });

            const extraLength = root.querySelector('[data-extra-length]');
            if (extraLength) {
              [...extraLength.options].forEach((option) => {
                const inches = Number(option.dataset.inches);
                const value = nextUnit === 'cm' ? Math.round(inches * 2.54 * 10) / 10 : inches;
                option.value = String(value);
                option.textContent = String(value);
              });
            }

            activeUnit = nextUnit;
            unitValue.value = nextUnit;
            root.querySelectorAll('[data-unit-label]').forEach((label) => {
              label.textContent = nextUnit;
            });
            unitInputs.forEach((input) => {
              input.checked = input.value === nextUnit;
            });
          };

          sizeSelect.addEventListener('change', (event) => {
            event.stopPropagation();
            syncDropdown();

            const selectedOption = sizeSelect.selectedOptions[0];
            const isCustomSize = selectedOption?.hasAttribute('data-custom-size-option');

            if (isCustomSize) {
              setCustomSizeActive(true, true, true);

              if (selectedOption.dataset.realVariant === 'true') {
                nativeSizeSelect.value = selectedOption.value;
                nativeSizeSelect.dispatchEvent(new Event('change', { bubbles: true }));
              }
              return;
            }

            setCustomSizeActive(false);
            nativeSizeSelect.value = sizeSelect.value;
            nativeSizeSelect.dispatchEvent(new Event('change', { bubbles: true }));
          });

          dropdownTrigger.addEventListener('click', () => {
            setMenuOpen(dropdownMenu.hidden, true);
          });

          dropdownTrigger.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
              event.preventDefault();
              setMenuOpen(true, true);
            }
          });

          dropdownOptions.forEach((option) => {
            option.addEventListener('click', () => {
              sizeSelect.value = option.dataset.value;
              const selectedCustomSize = sizeSelect.selectedOptions[0]?.hasAttribute('data-custom-size-option') === true;
              setMenuOpen(false);
              sizeSelect.dispatchEvent(new Event('change', { bubbles: true }));
              if (!selectedCustomSize) dropdownTrigger.focus();
            });
          });

          dropdownMenu.addEventListener('keydown', (event) => {
            const currentIndex = dropdownOptions.indexOf(document.activeElement);

            if (event.key === 'Escape') {
              event.preventDefault();
              setMenuOpen(false);
              dropdownTrigger.focus();
              return;
            }

            if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
              event.preventDefault();
              const direction = event.key === 'ArrowDown' ? 1 : -1;
              const nextIndex = (currentIndex + direction + dropdownOptions.length) % dropdownOptions.length;
              dropdownOptions[nextIndex]?.focus();
              return;
            }

            if (event.key === 'Home' || event.key === 'End') {
              event.preventDefault();
              dropdownOptions[event.key === 'Home' ? 0 : dropdownOptions.length - 1]?.focus();
            }
          });

          dropdown.addEventListener('focusout', (event) => {
            if (!dropdown.contains(event.relatedTarget)) setMenuOpen(false);
          });

          document.addEventListener('pointerdown', (event) => {
            if (!dropdown.contains(event.target)) setMenuOpen(false);
          });

          unitInputs.forEach((input) => {
            input.addEventListener('change', () => {
              if (input.checked) setUnit(input.value);
            });
          });

          closeButtons.forEach((button) => {
            button.addEventListener('click', closeMobileSheet);
          });

          doneButton?.addEventListener('click', () => {
            const invalidField = requiredFields.find((field) => !field.checkValidity());

            if (invalidField) {
              invalidField.reportValidity();
              invalidField.focus();
              return;
            }

            closeMobileSheet();
          });

          requiredFields.forEach((field) => {
            field.addEventListener('invalid', () => {
              if (mobileQuery.matches && panel.hidden) setPanelOpen(true);
            });
          });

          document.addEventListener('keydown', (event) => {
            if (!mobileQuery.matches || panel.hidden) return;

            if (event.key === 'Escape') {
              event.preventDefault();
              closeMobileSheet();
              return;
            }

            if (event.key !== 'Tab') return;

            const focusableElements = [...panel.querySelectorAll(focusableSelector)]
              .filter((element) => element.offsetParent !== null);
            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];

            if (!firstElement || !lastElement) return;

            if (event.shiftKey && document.activeElement === firstElement) {
              event.preventDefault();
              lastElement.focus();
            } else if (!event.shiftKey && document.activeElement === lastElement) {
              event.preventDefault();
              firstElement.focus();
            }
          });

          if (typeof mobileQuery.addEventListener === 'function') {
            mobileQuery.addEventListener('change', handleViewportChange);
          } else {
            mobileQuery.addListener(handleViewportChange);
          }

          syncDropdown();
          setCustomSizeActive(
            sizeSelect.selectedOptions[0]?.hasAttribute('data-custom-size-option') === true,
            false
          );
        })();
      </script>
    {%- endif -%}
  </variant-picker>
{% endunless %}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  /* Custom size option */
  .custom-size-option {
    --custom-size-surface: #faf5ed;
    --custom-size-surface-hover: #f1e7db;
    --custom-size-border: #d8c7b3;
    --custom-size-ink: #6b5b50;
    --custom-size-muted: #9b8c80;
    --custom-size-selected: #44352c;

    position: relative;
    align-items: stretch;
    text-align: left;
  }

  .custom-size-option__title {
    display: block;
    margin-bottom: 8px;
    color: var(--custom-size-ink);
    font: inherit;
    font-size: 0.9em;
    line-height: 1.2;
  }

  .custom-size-option__dropdown {
    position: relative;
    width: 100%;
  }

  .custom-size-option__trigger {
    display: flex;
    width: 100%;
    min-height: 50px;
    margin: 0;
    padding: 12px 16px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--custom-size-border);
    border-radius: 4px;
    background: var(--custom-size-surface);
    color: var(--custom-size-ink);
    font: inherit;
    font-size: 0.92em;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .custom-size-option__trigger:hover,
  .custom-size-option__dropdown.is-open .custom-size-option__trigger {
    border-color: #bca58e;
    background: #fcf8f2;
  }

  .custom-size-option__trigger:focus-visible {
    outline: 1px solid var(--custom-size-selected);
    outline-offset: 3px;
  }

  .custom-size-option__trigger svg {
    width: 11px;
    height: 8px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }

  .custom-size-option__dropdown.is-open .custom-size-option__trigger svg {
    transform: rotate(180deg);
  }

  .custom-size-option__menu {
    position: absolute;
    display: flex;
    z-index: 20;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    max-height: min(320px, 55vh);
    padding: 5px;
    flex-direction: column;
    overflow-y: auto;
    border: 1px solid var(--custom-size-border);
    border-radius: 4px;
    background: var(--custom-size-surface);
    box-shadow: 0 14px 30px rgb(68 53 44 / 12%);
  }

  .custom-size-option__menu[hidden] {
    display: none;
  }

  .custom-size-option__item {
    display: grid;
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 10px;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--custom-size-ink);
    font: inherit;
    font-size: 0.9em;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }

  .custom-size-option__item:hover,
  .custom-size-option__item:focus-visible {
    outline: 0;
    background: var(--custom-size-surface-hover);
  }

  .custom-size-option__item.is-selected {
    background: var(--custom-size-selected);
    color: var(--custom-size-surface);
  }

  .custom-size-option__item svg {
    display: none;
    width: 12px;
    height: 10px;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .custom-size-option__item.is-selected svg {
    display: block;
  }

  .custom-size-option__item--custom {
    order: -1;
    margin-bottom: 5px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--custom-size-border);
    border-radius: 2px 2px 0 0;
  }

  .custom-size-option__item--custom.is-selected {
    border-bottom-color: var(--custom-size-selected);
  }

  .custom-size-option__availability {
    color: var(--custom-size-muted);
    font-size: 0.78em;
  }

  .custom-size-option__item.is-selected .custom-size-option__availability {
    color: inherit;
    opacity: 0.72;
  }

  .custom-size-option__select {
    display: none;
  }

  .custom-size-option__native-select {
    display: none;
  }

  .custom-size {
    width: 100%;
    margin-top: 12px;
    text-align: left;
  }

  .custom-size__backdrop,
  .custom-size__sheet-header,
  .custom-size__sheet-footer {
    display: none;
  }

  .custom-size__backdrop[hidden],
  .custom-size__panel[hidden] {
    display: none;
  }

  .custom-size__panel {
    padding: 20px;
    border: 1px solid #d8c7b3;
    border-radius: 4px;
    background: #faf5ed;
  }

  .custom-size__unit {
    display: inline-flex;
    width: auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    gap: 8px;
  }

  .custom-size__unit-legend {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .custom-size__unit-option {
    position: relative;
    display: inline-flex;
    margin: 0;
    cursor: pointer;
  }

  .custom-size__unit-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .custom-size__unit-option span {
    display: inline-grid;
    min-width: 48px;
    min-height: 36px;
    padding: 7px 14px;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: currentcolor;
    font: inherit;
    font-size: 0.88em;
    line-height: 1;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .custom-size__unit-option:hover span {
    border-color: color-mix(in srgb, currentcolor 45%, transparent);
  }

  .custom-size__unit-option input:checked + span {
    border-color: var(--color-foreground, #44352c);
    background: var(--color-foreground, #44352c);
    color: var(--color-background, #faf5ed);
  }

  .custom-size__unit-option input:focus-visible + span {
    outline: var(--focus-outline-width, 2px) solid currentcolor;
    outline-offset: var(--focus-outline-offset, 2px);
  }

  .custom-size__note {
    margin: 16px 0 20px;
    padding: 12px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, currentcolor 4%, transparent);
    font-size: 0.9em;
    line-height: 1.45;
  }

  .custom-size__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    align-items: center;
    gap: 24px;
  }

  .custom-size__layout--no-image {
    grid-template-columns: minmax(0, 1fr);
  }

  .custom-size__fields {
    display: grid;
    gap: 12px;
  }

  .custom-size__field {
    display: grid;
    grid-template-columns: minmax(130px, 1fr) minmax(150px, 0.85fr);
    align-items: center;
    gap: 12px;
  }

  .custom-size__control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24px;
    align-items: center;
    gap: 8px;
  }

  .custom-size__control input,
  .custom-size__control select {
    width: 100%;
    min-height: 42px;
    padding: 8px 10px;
    border: var(--style-border-width-inputs, 1px) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background: transparent;
    color: currentcolor;
    font: inherit;
  }

  .custom-size__control input:focus-visible,
  .custom-size__control select:focus-visible {
    outline: var(--focus-outline-width, 2px) solid currentcolor;
    outline-offset: var(--focus-outline-offset, 2px);
  }

  .custom-size__diagram {
    display: block;
    width: 100%;
    height: auto;
    max-width: 210px;
    justify-self: center;
    object-fit: contain;
  }

  .custom-size__help {
    margin: 18px 0 0;
    font-size: 0.82em;
    opacity: 0.75;
  }

  @media screen and (max-width: 749px) {
    body.custom-size-sheet-open {
      overflow: hidden;
      overscroll-behavior: none;
    }

    .custom-size {
      margin-top: 0;
    }

    .custom-size__backdrop {
      position: fixed;
      z-index: 999;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: rgb(30 22 17 / 48%);
      cursor: default;
      animation: custom-size-backdrop-in 180ms ease-out both;
      -webkit-tap-highlight-color: transparent;
    }

    .custom-size__panel {
      position: fixed;
      z-index: 1000;
      right: 0;
      bottom: 0;
      left: 0;
      width: 100%;
      max-height: min(88dvh, 760px);
      padding: 0 18px calc(18px + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      border-width: 1px 0 0;
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -18px 55px rgb(30 22 17 / 20%);
      animation: custom-size-sheet-in 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
      -webkit-overflow-scrolling: touch;
    }

    .custom-size__panel::before {
      position: sticky;
      z-index: 2;
      top: 6px;
      display: block;
      width: 38px;
      height: 4px;
      margin: 6px auto -10px;
      border-radius: 999px;
      background: color-mix(in srgb, currentcolor 20%, transparent);
      content: '';
    }

    .custom-size__sheet-header {
      position: sticky;
      z-index: 1;
      top: 0;
      display: flex;
      margin-inline: -18px;
      padding: 28px 18px 14px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      border-bottom: 1px solid #d8c7b3;
      background: #faf5ed;
    }

    .custom-size__sheet-header h2 {
      margin: 2px 0 0;
      color: #44352c;
      font: inherit;
      font-size: 1.15em;
      font-weight: 600;
      line-height: 1.25;
    }

    .custom-size__eyebrow {
      display: block;
      color: #9b8c80;
      font-size: 0.72em;
      letter-spacing: 0.08em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .custom-size__close {
      display: grid;
      width: 40px;
      height: 40px;
      padding: 0;
      flex: 0 0 auto;
      place-items: center;
      border: 1px solid #d8c7b3;
      border-radius: 50%;
      background: transparent;
      color: #44352c;
      cursor: pointer;
    }

    .custom-size__close svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentcolor;
      stroke-linecap: round;
      stroke-width: 1.4;
    }

    .custom-size__unit {
      margin-top: 18px;
    }

    .custom-size__layout {
      grid-template-columns: 1fr;
    }

    .custom-size__diagram {
      max-width: 150px;
    }

    .custom-size__field {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .custom-size__sheet-footer {
      position: sticky;
      bottom: calc(-18px - env(safe-area-inset-bottom));
      display: block;
      margin: 18px -18px calc(-18px - env(safe-area-inset-bottom));
      padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
      border-top: 1px solid #d8c7b3;
      background: #faf5ed;
    }

    .custom-size__done {
      width: 100%;
      min-height: 48px;
      padding: 12px 18px;
      border: 1px solid #44352c;
      border-radius: 4px;
      background: #44352c;
      color: #faf5ed;
      font: inherit;
      font-weight: 600;
      cursor: pointer;
    }

    .custom-size__close:focus-visible,
    .custom-size__done:focus-visible {
      outline: 2px solid #44352c;
      outline-offset: 3px;
    }

    @keyframes custom-size-sheet-in {
      from {
        opacity: 0.85;
        transform: translateY(100%);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes custom-size-backdrop-in {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .custom-size__panel,
      .custom-size__backdrop {
        animation: none;
      }
    }
  }
{% endstylesheet %}
