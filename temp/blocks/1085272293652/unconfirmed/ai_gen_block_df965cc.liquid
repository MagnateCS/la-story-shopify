{% doc %}
  @prompt
    Create a social media links block for the footer to replace the existing Social media links block. Include left, center, and right icon alignment options, working on mobile and desktop. Support the theme's existing social platforms and add Yelp with a recognizable Yelp icon and a configurable Yelp profile URL. Display only platforms with a URL entered, use accessible link labels, and match the existing footer styling. Do not remove or change the existing block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-social-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-footer-social-{{ ai_gen_id }}__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-footer-social-{{ ai_gen_id }}--left .ai-footer-social-{{ ai_gen_id }}__list { justify-content: flex-start; }
  .ai-footer-social-{{ ai_gen_id }}--center .ai-footer-social-{{ ai_gen_id }}__list { justify-content: center; }
  .ai-footer-social-{{ ai_gen_id }}--right .ai-footer-social-{{ ai_gen_id }}__list { justify-content: flex-end; }

  .ai-footer-social-{{ ai_gen_id }}__link {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }

  .ai-footer-social-{{ ai_gen_id }}__link:hover { color: {{ block.settings.hover_color }}; }
  .ai-footer-social-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .ai-footer-social-{{ ai_gen_id }}__link svg { display: block; width: 24px; height: 24px; fill: currentColor; }
  .ai-footer-social-{{ ai_gen_id }}__link .ai-footer-social-{{ ai_gen_id }}__yelp { fill: #d32323; }

  @media screen and (max-width: 749px) {
    .ai-footer-social-{{ ai_gen_id }} { width: 100%; }
  }
{% endstyle %}

<div class="ai-footer-social-{{ ai_gen_id }} ai-footer-social-{{ ai_gen_id }}--{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
  <ul class="ai-footer-social-{{ ai_gen_id }}__list" aria-label="Social media links">
    {% if settings.social_instagram_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.25-3.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5z"/></svg></a></li>{% endif %}
    {% if settings.social_facebook_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.3v3h2.8v8h3.4z"/></svg></a></li>{% endif %}
    {% if settings.social_youtube_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg></a></li>{% endif %}
    {% if settings.social_tiktok_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.6 6.2a5.2 5.2 0 0 1-3.2-1.1V15a6.3 6.3 0 1 1-6.3-6.3c.4 0 .8 0 1.2.1v3.5a2.9 2.9 0 1 0 1.6 2.6V2h3.5a5.2 5.2 0 0 0 3.2 4.2v3.5z"/></svg></a></li>{% endif %}
    {% if settings.social_pinterest_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-1.8.2-2.7l1.3-5.5s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.5-.3 1 .5 1.8 1.5 1.8 1.8 0 3.1-2.3 3.1-5 0-2.1-1.4-3.7-4-3.7-2.9 0-4.7 2.2-4.7 4.6 0 .8.2 1.4.6 1.9.2.2.2.3.1.6l-.2.7c-.1.2-.3.3-.5.2-1.3-.5-1.9-1.9-1.9-3.5 0-2.6 2.2-5.8 6.6-5.8 3.5 0 5.8 2.5 5.8 5.2 0 3.6-2 6.3-4.9 6.3-1 0-2-.6-2.3-1.2l-.7 2.8c-.2.9-.7 1.8-1.1 2.5A10 10 0 1 0 12 2z"/></svg></a></li>{% endif %}
    {% if settings.social_twitter_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.6 22H2.5l7.3-8.4L1.8 2h6.5l4.5 6.8L18.9 2zm-1.1 18h1.7L7.3 3.9H5.5L17.8 20z"/></svg></a></li>{% endif %}
    {% if settings.social_snapchat_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_snapchat_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on Snapchat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c-2.7 0-4.4 2-4.4 5.1 0 .9.2 2 .3 2.6-.4.3-1.1.5-1.7.2-.4-.2-.8 0-.9.4-.1.5.4.9 1.1 1.1.5.2 1.1.2 1.5.2-.2.8-.9 1.6-1.9 2.2-.9.5-1.8.7-2.4.8-.5.1-.7.5-.5.9.2.4.7.6 1.2.6.7.1 1.2.5 1.4 1 .2.6.6.7 1.3.7.6 0 1.6.3 2.3 1 .7.6 1.6.9 2.7.9s2-.3 2.7-.9c.7-.7 1.7-1 2.3-1 .7 0 1.1-.1 1.3-.7.2-.5.7-.9 1.4-1 .5 0 1-.2 1.2-.6.2-.4 0-.8-.5-.9-.6-.1-1.5-.3-2.4-.8-1-.6-1.7-1.4-1.9-2.2.4 0 1 0 1.5-.2.7-.2 1.2-.6 1.1-1.1-.1-.4-.5-.6-.9-.4-.6.3-1.3.1-1.7-.2.1-.6.3-1.7.3-2.6C16.4 4 14.7 2 12 2z"/></svg></a></li>{% endif %}
    {% if settings.social_linkedin_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_linkedin_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zM3.3 9h3.8v12H3.3V9zm6.2 0h3.6v1.6h.1A4 4 0 0 1 16.8 8c3.9 0 4.6 2.5 4.6 5.7V21h-3.8v-6.5c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V21H9.5V9z"/></svg></a></li>{% endif %}
    {% if settings.social_vimeo_link != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ settings.social_vimeo_link }}" target="_blank" rel="noopener noreferrer" aria-label="Visit us on Vimeo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 7.2c-.1 3-2.2 7.1-6.2 12.1-2.1 2.7-3.9 4-5.4 4-1 0-1.9-.9-2.6-2.8L5.4 13C4.6 10.2 3.8 9 3 9c-.2 0-.9.5-2 1.5L0 8.6l3.7-3.3C5.3 3.9 6.5 3.2 7.3 3.1c1.9-.2 3 .9 3.5 3.4.5 2.7.8 4.3 1 4.9.5 2.2 1.1 3.3 1.8 3.3.5 0 1.2-.7 2.1-2.2.9-1.5 1.4-2.6 1.5-3.4.1-1.3-.4-2-1.5-2-.5 0-1 .1-1.5.3 1-3.3 2.8-4.9 5.5-4.8 2 .1 2.9 1.4 2.8 3.6z"/></svg></a></li>{% endif %}
    {% if block.settings.yelp_url != blank %}<li><a class="ai-footer-social-{{ ai_gen_id }}__link" href="{{ block.settings.yelp_url }}" target="_blank" rel="noopener noreferrer" aria-label="Find us on Yelp"><svg class="ai-footer-social-{{ ai_gen_id }}__yelp" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.1 2.2c-.5 0-.9.4-.9 1l.1 7.4c0 .5.4.8.9.6l3.1-1.5c.4-.2.5-.6.3-1L13 2.7c-.2-.4-.5-.6-.9-.5zM3.5 8.1c-.4.2-.6.7-.3 1.2l4.1 6.2c.3.4.7.4 1 .1l2.1-2.8c.3-.4.2-.8-.2-1.1L4.6 8.2c-.4-.3-.8-.3-1.1-.1zm16.1.1c-.2 0-.4.1-.6.2l-6.3 3.5c-.5.3-.5.7-.2 1.1l2.1 2.7c.3.4.7.4 1 .1l4.6-6.1c.4-.5.1-1.2-.5-1.4l-.1-.1zM9.8 16l-3.3.8c-.5.1-.7.5-.6 1l1.1 3.8c.2.6.9.8 1.4.4l3-4.3c.3-.4.1-.9-.4-1l-1.2-.7zm5.1 1.1c-.5-.1-.8.2-.8.7l-.2 3.3c0 .6.5 1 1 .8l3.6-1.4c.6-.2.7-.9.3-1.3l-2.8-2c-.3-.1-.7-.1-1.1-.1z"/></svg></a></li>{% endif %}
  </ul>
</div>

{% schema %}
{
  "name": "Footer social links",
  "settings": [
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"alignment","label":"Icon alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"header","content":"Yelp"},
    {"type":"url","id":"yelp_url","label":"Yelp profile URL"},
    {"type":"color","id":"hover_color","label":"Hover color","default":"#B79A68"}
  ],
  "presets": [{"name":"Footer social links"}],
  "tag": null,
  "class": "footer-social-links"
}
{% endschema %}