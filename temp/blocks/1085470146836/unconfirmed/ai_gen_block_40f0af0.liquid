{% doc %}
  @prompt
    Create a customer service section in order for customers to contact via phone or email.  , allow me to change the font style please 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-customer-service-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 40px 32px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-customer-service-{{ ai_gen_id }} *,
  .ai-customer-service-{{ ai_gen_id }} *::before,
  .ai-customer-service-{{ ai_gen_id }} *::after { box-sizing: border-box; }

  .ai-customer-service__inner-{{ ai_gen_id }} { max-width: 960px; margin: 0 auto; }

  .ai-customer-service__heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.1;
  }

  .ai-customer-service__intro-{{ ai_gen_id }} {
    margin: 0 0 28px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-customer-service__contacts-{{ ai_gen_id }} { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .ai-customer-service__card-{{ ai_gen_id }} { display: flex; align-items: center; gap: 18px; min-width: 0; padding: 22px; border: 1px solid {{ block.settings.border_color }}; background: {{ block.settings.card_color }}; }
  .ai-customer-service__icon-{{ ai_gen_id }} { display: grid; flex: 0 0 46px; width: 46px; height: 46px; place-items: center; border-radius: 50%; background: {{ block.settings.icon_background }}; color: {{ block.settings.icon_color }}; }
  .ai-customer-service__icon-{{ ai_gen_id }} svg { width: 21px; height: 21px; }
  .ai-customer-service__label-{{ ai_gen_id }} { margin: 0 0 5px; color: {{ block.settings.heading_color }}; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .ai-customer-service__link-{{ ai_gen_id }} { color: {{ block.settings.text_color }}; font-size: 17px; line-height: 1.4; overflow-wrap: anywhere; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .ai-customer-service__link-{{ ai_gen_id }}:hover { color: {{ block.settings.link_hover_color }}; }
  .ai-customer-service__link-{{ ai_gen_id }}:focus-visible { outline: 2px solid {{ block.settings.link_hover_color }}; outline-offset: 4px; }

  @media screen and (max-width: 640px) {
    .ai-customer-service-{{ ai_gen_id }} { padding: 32px 20px; }
    .ai-customer-service__contacts-{{ ai_gen_id }} { grid-template-columns: 1fr; }
    .ai-customer-service__card-{{ ai_gen_id }} { padding: 18px; }
  }
{% endstyle %}

<div class="ai-customer-service-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-customer-service__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}<h2 class="ai-customer-service__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.intro != blank %}<p class="ai-customer-service__intro-{{ ai_gen_id }}">{{ block.settings.intro | escape }}</p>{% endif %}
    <div class="ai-customer-service__contacts-{{ ai_gen_id }}">
      {% if block.settings.phone_number != blank %}
        {% assign phone_link = block.settings.phone_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' %}
        <div class="ai-customer-service__card-{{ ai_gen_id }}">
          <span class="ai-customer-service__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.8 2.1Z"/></svg></span>
          <div><p class="ai-customer-service__label-{{ ai_gen_id }}">{{ block.settings.phone_label | escape }}</p><a class="ai-customer-service__link-{{ ai_gen_id }}" href="tel:{{ phone_link | escape }}">{{ block.settings.phone_number | escape }}</a></div>
        </div>
      {% endif %}
      {% if block.settings.email_address != blank %}
        <div class="ai-customer-service__card-{{ ai_gen_id }}">
          <span class="ai-customer-service__icon-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
          <div><p class="ai-customer-service__label-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</p><a class="ai-customer-service__link-{{ ai_gen_id }}" href="mailto:{{ block.settings.email_address | escape }}">{{ block.settings.email_address | escape }}</a></div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer service",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We’re here to help" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Have a question? Get in touch with our customer service team." },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Call us" },
    { "type": "text", "id": "phone_number", "label": "Phone number" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email us" },
    { "type": "text", "id": "email_address", "label": "Email address" },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "cormorant_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "oswald_n4" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F2EA" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFAF3" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#3D3028" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3D3028" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#D8C8B8" },
    { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#3D3028" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#FFFAF3" },
    { "type": "color", "id": "link_hover_color", "label": "Link hover", "default": "#6D503A" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Customer service" }],
  "tag": null,
  "class": "customer-service-block"
}
{% endschema %}