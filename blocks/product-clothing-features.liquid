{% comment %}
  Clothing Features — reusable Shopify theme block

  Save as:
    /blocks/clothing-features.liquid

  This is a single theme block. It intentionally does not define local child
  blocks because local blocks are not permitted inside files in /blocks.

  Default metafield:
    product.metafields.product.clothing_features
{% endcomment %}

{%- liquid
  assign feature_product = closest.product | default: product
  assign feature_metafield = blank
  assign feature_values = blank

  if feature_product != blank
    assign feature_metafield = feature_product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
  endif

  if feature_metafield != blank
    if feature_metafield.list?
      assign feature_values = feature_metafield.value
    else
      assign feature_values = feature_metafield.value | split: ','
    endif
  endif
-%}

{%- capture image_sizes -%}
  (max-width: 749px) {{ block.settings.icon_size_mobile }}px, {{ block.settings.icon_size }}px
{%- endcapture -%}

{%- capture feature_items -%}
  {%- assign rendered_keys = '|' -%}

  {%- for feature in feature_values -%}
    {%- liquid
      assign feature_label = feature

      if feature.label != blank
        assign feature_label = feature.label.value | default: feature.label
      elsif feature.name != blank
        assign feature_label = feature.name.value | default: feature.name
      elsif feature.title != blank
        assign feature_label = feature.title.value | default: feature.title
      endif

      assign feature_label = feature_label | strip
      assign feature_key = feature_label | handleize

      if feature_key == blank and feature.system.handle != blank
        assign feature_key = feature.system.handle | handleize
      endif

      assign feature_token = '|' | append: feature_key | append: '|'
      assign feature_icon = blank
      assign display_label = feature_label

      case feature_key
        when 'boning'
          assign feature_icon = block.settings.boning_icon
          assign display_label = block.settings.boning_label
        when 'padding'
          assign feature_icon = block.settings.padding_icon
          assign display_label = block.settings.padding_label
        when 'corset'
          assign feature_icon = block.settings.corset_icon
          assign display_label = block.settings.corset_label
        when 'gloves'
          assign feature_icon = block.settings.gloves_icon
          assign display_label = block.settings.gloves_label
        when 'convertible'
          assign feature_icon = block.settings.convertible_icon
          assign display_label = block.settings.convertible_label
      endcase

      assign should_render = true

      if feature_key == blank or rendered_keys contains feature_token
        assign should_render = false
      endif

      if feature_icon == blank and block.settings.show_labels_without_icons == false
        assign should_render = false
      endif
    -%}

    {%- if should_render -%}
      <li class="clothing-features__item">
        {%- if feature_icon != blank -%}
          <span class="clothing-features__icon" aria-hidden="true">
            {{-
              feature_icon
              | image_url: width: 400
              | image_tag:
                loading: 'lazy',
                widths: '64, 80, 120, 160, 240, 320, 400',
                sizes: image_sizes,
                alt: ''
            -}}
          </span>
        {%- endif -%}

        <span class="clothing-features__label">
          {{- display_label | default: feature_label | escape -}}
        </span>
      </li>

      {%- assign rendered_keys = rendered_keys | append: feature_key | append: '|' -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign feature_items = feature_items | strip -%}

{%- if feature_items != blank -%}
  {%- style -%}
    {{ block.settings.label_font | font_face: font_display: 'swap' }}

    #ClothingFeatures-{{ block.id }} {
      --cf-icon-size: {{ block.settings.icon_size }}px;
      --cf-icon-size-mobile: {{ block.settings.icon_size_mobile }}px;
      --cf-icon-label-gap: {{ block.settings.icon_label_gap }}px;
      --cf-column-gap: {{ block.settings.item_gap }}px;
      --cf-row-gap: {{ block.settings.row_gap }}px;
      --cf-label-size: {{ block.settings.label_size }}px;
      --cf-label-size-mobile: {{ block.settings.label_size_mobile }}px;
      --cf-letter-spacing: {{ block.settings.letter_spacing | divided_by: 10.0 }}px;
      --cf-text-color: {{ block.settings.text_color }};

      width: 100%;
      padding-block-start: {{ block.settings.padding_top }}px;
      padding-block-end: {{ block.settings.padding_bottom }}px;
    }

    #ClothingFeatures-{{ block.id }} .clothing-features__list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: {{ block.settings.alignment }};
      gap: var(--cf-row-gap) var(--cf-column-gap);
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #ClothingFeatures-{{ block.id }} .clothing-features__item {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: var(--cf-icon-label-gap);
      color: var(--cf-text-color);
    }

    #ClothingFeatures-{{ block.id }} .clothing-features__icon {
      display: block;
      flex: 0 0 var(--cf-icon-size);
      width: var(--cf-icon-size);
      height: var(--cf-icon-size);
      overflow: hidden;
      border-radius: 50%;
    }

    #ClothingFeatures-{{ block.id }} .clothing-features__icon img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #ClothingFeatures-{{ block.id }} .clothing-features__label {
      font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
      font-style: {{ block.settings.label_font.style }};
      font-size: var(--cf-label-size);
      font-weight: {{ block.settings.label_weight }};
      line-height: {{ block.settings.line_height | divided_by: 100.0 }};
      letter-spacing: var(--cf-letter-spacing);
      text-transform: {{ block.settings.text_transform }};
      white-space: nowrap;
    }

    @media screen and (max-width: 749px) {
      #ClothingFeatures-{{ block.id }} .clothing-features__icon {
        flex-basis: var(--cf-icon-size-mobile);
        width: var(--cf-icon-size-mobile);
        height: var(--cf-icon-size-mobile);
      }

      #ClothingFeatures-{{ block.id }} .clothing-features__label {
        font-size: var(--cf-label-size-mobile);
      }

      {%- if block.settings.mobile_layout == 'scroll' -%}
        #ClothingFeatures-{{ block.id }} .clothing-features__list {
          flex-wrap: nowrap;
          justify-content: flex-start;
          overflow-x: auto;
          overscroll-behavior-inline: contain;
          scrollbar-width: none;
          scroll-snap-type: inline proximity;
          -webkit-overflow-scrolling: touch;
        }

        #ClothingFeatures-{{ block.id }} .clothing-features__list::-webkit-scrollbar {
          display: none;
        }

        #ClothingFeatures-{{ block.id }} .clothing-features__item {
          scroll-snap-align: start;
        }
      {%- endif -%}
    }
  {%- endstyle -%}

  <div
    id="ClothingFeatures-{{ block.id }}"
    class="clothing-features"
    aria-label="{{ block.settings.accessibility_label | escape }}"
    {{ block.shopify_attributes }}
  >
    <ul class="clothing-features__list" role="list">
      {{ feature_items }}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Clothing features",
  "settings": [
    {
      "type": "header",
      "content": "Metafield source"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Namespace",
      "default": "product"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Key",
      "default": "clothing_features"
    },
    {
      "type": "checkbox",
      "id": "show_labels_without_icons",
      "label": "Show labels without an uploaded icon",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Product features"
    },
    {
      "type": "header",
      "content": "Icons and labels"
    },
    {
      "type": "image_picker",
      "id": "boning_icon",
      "label": "Boning icon"
    },
    {
      "type": "text",
      "id": "boning_label",
      "label": "Boning label",
      "default": "Boning"
    },
    {
      "type": "image_picker",
      "id": "padding_icon",
      "label": "Padding icon"
    },
    {
      "type": "text",
      "id": "padding_label",
      "label": "Padding label",
      "default": "Padding"
    },
    {
      "type": "image_picker",
      "id": "corset_icon",
      "label": "Corset icon"
    },
    {
      "type": "text",
      "id": "corset_label",
      "label": "Corset label",
      "default": "Corset"
    },
    {
      "type": "image_picker",
      "id": "gloves_icon",
      "label": "Gloves icon"
    },
    {
      "type": "text",
      "id": "gloves_label",
      "label": "Gloves label",
      "default": "Gloves"
    },
    {
      "type": "image_picker",
      "id": "convertible_icon",
      "label": "Convertible icon"
    },
    {
      "type": "text",
      "id": "convertible_label",
      "label": "Convertible label",
      "default": "Convertible"
    },
    {
      "type": "header",
      "content": "Icon sizing"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 32,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Desktop icon size",
      "default": 80
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 28,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Mobile icon size",
      "default": 64
    },
    {
      "type": "range",
      "id": "icon_label_gap",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Icon and label spacing",
      "default": 14
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "label_font",
      "label": "Label font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop label size",
      "default": 14
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "min": 9,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile label size",
      "default": 12
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "default": "500",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": -10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 90,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 120
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text style",
      "default": "uppercase",
      "options": [
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#211D1A"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Horizontal alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "space-between", "label": "Space between" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "scroll",
      "options": [
        { "value": "scroll", "label": "Horizontal scroll" },
        { "value": "wrap", "label": "Wrap onto rows" }
      ]
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 8,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Space between features",
      "default": 40
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space between rows",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Clothing features"
    }
  ]
}
{% endschema %}
