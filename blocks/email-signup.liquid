{% liquid
  assign block_settings = block.settings
%}

<div
  class="bridal-email"
  style="
    --bridal-email-bg: {{ block_settings.background_color }};
    --bridal-email-text: {{ block_settings.text_color }};
    --bridal-email-muted: {{ block_settings.muted_color }};
    --bridal-email-border: {{ block_settings.border_color }};
    --bridal-email-button-bg: {{ block_settings.button_background }};
    --bridal-email-button-text: {{ block_settings.button_text_color }};
    --bridal-email-max-width: {{ block_settings.content_width }}px;
    --bridal-email-padding-top: {{ block_settings.padding_top }}px;
    --bridal-email-padding-bottom: {{ block_settings.padding_bottom }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="bridal-email__inner">

    {% if block_settings.eyebrow != blank %}
      <p class="bridal-email__eyebrow">
        {{ block_settings.eyebrow | escape }}
      </p>
    {% endif %}

    {% if block_settings.heading != blank %}
      <h2 class="bridal-email__heading">
        {{ block_settings.heading | escape }}
      </h2>
    {% endif %}

    {% if block_settings.description != blank %}
      <div class="bridal-email__description">
        {{ block_settings.description }}
      </div>
    {% endif %}

    {% form 'customer', class: 'bridal-email__form' %}

      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter"
      >

      <div class="bridal-email__field-wrapper">

        <div class="bridal-email__field">
          <label
            for="BridalEmail-{{ block.id }}"
            class="visually-hidden"
          >
            Email address
          </label>

          <input
            id="BridalEmail-{{ block.id }}"
            class="bridal-email__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ block_settings.placeholder | escape }}"
            required
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="BridalEmailError-{{ block.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="BridalEmailSuccess-{{ block.id }}"
            {% endif %}
          >

          <button
            type="submit"
            class="bridal-email__button"
            aria-label="{{ block_settings.button_label | escape }}"
          >
            <span class="bridal-email__button-label">
              {{ block_settings.button_label | escape }}
            </span>

            <svg
              class="bridal-email__arrow"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M5 12H19M14 7L19 12L14 17"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>

      </div>

      {% if form.errors %}
        <div
          id="BridalEmailError-{{ block.id }}"
          class="bridal-email__message bridal-email__message--error"
          tabindex="-1"
        >
          <svg
            viewBox="0 0 20 20"
            aria-hidden="true"
            focusable="false"
          >
            <circle
              cx="10"
              cy="10"
              r="8.5"
              fill="none"
              stroke="currentColor"
            />
            <path
              d="M10 5.5V11"
              stroke="currentColor"
              stroke-linecap="round"
            />
            <circle
              cx="10"
              cy="14"
              r=".75"
              fill="currentColor"
            />
          </svg>

          <span>
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </span>
        </div>
      {% endif %}

      {% if form.posted_successfully? %}
        <div
          id="BridalEmailSuccess-{{ block.id }}"
          class="bridal-email__message bridal-email__message--success"
          tabindex="-1"
        >
          <svg
            viewBox="0 0 20 20"
            aria-hidden="true"
            focusable="false"
          >
            <circle
              cx="10"
              cy="10"
              r="8.5"
              fill="none"
              stroke="currentColor"
            />
            <path
              d="M6 10.2L8.7 13L14.2 7.5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

          <span>
            {{ block_settings.success_message | escape }}
          </span>
        </div>
      {% endif %}

    {% endform %}

    {% if block_settings.disclaimer != blank %}
      <div class="bridal-email__disclaimer">
        {{ block_settings.disclaimer }}
      </div>
    {% endif %}

  </div>
</div>


{% stylesheet %}

/* =========================================================
   LA STORY
   BRIDAL EMAIL SIGNUP
   ========================================================= */

.bridal-email {
  width: 100%;
  box-sizing: border-box;

  padding:
    var(--bridal-email-padding-top)
    clamp(20px, 5vw, 64px)
    var(--bridal-email-padding-bottom);

  background: var(--bridal-email-bg);
  color: var(--bridal-email-text);

  text-align: center;
}


/* ---------------------------------------------------------
   CONTAINER
--------------------------------------------------------- */

.bridal-email__inner {
  width: min(100%, var(--bridal-email-max-width));
  margin: 0 auto;
}


/* ---------------------------------------------------------
   EYEBROW
--------------------------------------------------------- */

.bridal-email__eyebrow {
  margin: 0 0 22px;

  font-family: var(--font-body--family, sans-serif);
  font-size: 11px;
  font-weight: 500;
  line-height: 1.2;

  letter-spacing: 0.28em;
  text-transform: uppercase;

  color: var(--bridal-email-muted);
}


/* ---------------------------------------------------------
   HEADING
--------------------------------------------------------- */

.bridal-email__heading {
  max-width: 760px;

  margin: 0 auto;

  font-family:
    var(--font-heading--family),
    "Times New Roman",
    Georgia,
    serif;

  font-size: clamp(38px, 5vw, 68px);
  font-weight: 400;
  line-height: 1.02;

  letter-spacing: -0.025em;

  color: var(--bridal-email-text);
}


/* ---------------------------------------------------------
   DESCRIPTION
--------------------------------------------------------- */

.bridal-email__description {
  max-width: 570px;

  margin: 25px auto 0;

  font-family: var(--font-body--family, sans-serif);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.75;

  letter-spacing: 0.015em;

  color: var(--bridal-email-muted);
}

.bridal-email__description p {
  margin: 0;
}


/* ---------------------------------------------------------
   FORM
--------------------------------------------------------- */

.bridal-email__form {
  width: 100%;
  max-width: 660px;

  margin: 42px auto 0;
}


/* ---------------------------------------------------------
   INPUT WRAPPER
--------------------------------------------------------- */

.bridal-email__field-wrapper {
  width: 100%;
}

.bridal-email__field {
  display: flex;
  align-items: stretch;

  width: 100%;
  min-height: 62px;

  border: 1px solid var(--bridal-email-border);

  background: transparent;

  transition:
    border-color 180ms ease,
    background-color 180ms ease;
}

.bridal-email__field:focus-within {
  border-color: var(--bridal-email-text);

  background:
    color-mix(
      in srgb,
      var(--bridal-email-bg) 92%,
      white
    );
}


/* ---------------------------------------------------------
   EMAIL INPUT
--------------------------------------------------------- */

.bridal-email__input {
  flex: 1;

  width: 100%;
  min-width: 0;

  padding: 18px 24px;

  border: 0;
  border-radius: 0;

  outline: none;

  background: transparent;

  font-family: var(--font-body--family, sans-serif);
  font-size: 13px;
  font-weight: 400;

  line-height: 1.4;
  letter-spacing: 0.035em;

  color: var(--bridal-email-text);

  appearance: none;
  -webkit-appearance: none;
}

.bridal-email__input::placeholder {
  color: var(--bridal-email-muted);
  opacity: 0.8;
}


/* ---------------------------------------------------------
   BUTTON
--------------------------------------------------------- */

.bridal-email__button {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 14px;

  min-width: 190px;

  padding: 0 27px;

  border: 0;
  border-left: 1px solid var(--bridal-email-border);

  border-radius: 0;

  background: transparent;
  color: var(--bridal-email-text);

  cursor: pointer;

  transition:
    background-color 200ms ease,
    color 200ms ease,
    border-color 200ms ease;
}

.bridal-email__button-label {
  font-family: var(--font-body--family, sans-serif);

  font-size: 10px;
  font-weight: 500;

  line-height: 1;

  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.bridal-email__arrow {
  width: 20px;
  height: 20px;

  flex-shrink: 0;

  transition: transform 200ms ease;
}

.bridal-email__button:hover {
  background: var(--bridal-email-button-bg);
  color: var(--bridal-email-button-text);

  border-color: var(--bridal-email-button-bg);
}

.bridal-email__button:hover .bridal-email__arrow {
  transform: translateX(4px);
}

.bridal-email__button:focus-visible {
  outline: 1px solid var(--bridal-email-text);
  outline-offset: 4px;
}


/* ---------------------------------------------------------
   MESSAGES
--------------------------------------------------------- */

.bridal-email__message {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  margin: 16px auto 0;

  font-family: var(--font-body--family, sans-serif);
  font-size: 12px;
  line-height: 1.5;

  color: var(--bridal-email-text);
}

.bridal-email__message svg {
  width: 16px;
  height: 16px;

  flex-shrink: 0;
}

.bridal-email__message--error {
  color: #8a3830;
}

.bridal-email__message--success {
  color: var(--bridal-email-text);
}


/* ---------------------------------------------------------
   DISCLAIMER
--------------------------------------------------------- */

.bridal-email__disclaimer {
  max-width: 530px;

  margin: 20px auto 0;

  font-family: var(--font-body--family, sans-serif);
  font-size: 10px;
  font-weight: 400;

  line-height: 1.6;
  letter-spacing: 0.02em;

  color: var(--bridal-email-muted);

  opacity: 0.78;
}

.bridal-email__disclaimer p {
  margin: 0;
}

.bridal-email__disclaimer a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}


/* ---------------------------------------------------------
   ACCESSIBILITY
--------------------------------------------------------- */

.bridal-email .visually-hidden {
  position: absolute !important;

  width: 1px;
  height: 1px;

  padding: 0;
  margin: -1px;

  overflow: hidden;

  clip: rect(0, 0, 0, 0);

  white-space: nowrap;

  border: 0;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 989px) {

  .bridal-email__heading {
    font-size: clamp(38px, 7vw, 58px);
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .bridal-email {
    padding-left: 20px;
    padding-right: 20px;
  }

  .bridal-email__eyebrow {
    margin-bottom: 18px;

    font-size: 10px;
    letter-spacing: 0.24em;
  }

  .bridal-email__heading {
    font-size: clamp(34px, 10vw, 46px);
    line-height: 1.04;
  }

  .bridal-email__description {
    margin-top: 20px;

    padding-left: 8px;
    padding-right: 8px;

    font-size: 13px;
    line-height: 1.7;
  }

  .bridal-email__form {
    margin-top: 32px;
  }

  .bridal-email__field {
    flex-direction: column;

    min-height: 0;
  }

  .bridal-email__input {
    min-height: 58px;

    padding: 17px 18px;

    text-align: center;
  }

  .bridal-email__button {
    width: 100%;
    min-width: 0;
    min-height: 55px;

    padding: 17px 20px;

    border-left: 0;
    border-top: 1px solid var(--bridal-email-border);
  }

  .bridal-email__disclaimer {
    margin-top: 18px;
  }

}


/* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 380px) {

  .bridal-email__heading {
    font-size: 32px;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .bridal-email__field,
  .bridal-email__button,
  .bridal-email__arrow {
    transition: none;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Bridal email signup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE LA STORY LETTER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For the bride with a point of view."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover new bridal collections, private events, styling inspiration, and first access to what comes next.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "JOIN THE LIST"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list. Welcome to LA Story."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>By subscribing, you agree to receive news and updates from LA Story.</p>"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading and text",
      "default": "#3B3029"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#75685E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#A99A8C"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button hover background",
      "default": "#3B3029"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button hover text",
      "default": "#F7F2EA"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 500,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Bridal email signup",
      "category": "Forms"
    }
  ]
}
{% endschema %}